<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Version>0.1.18</Version>
    <AssemblyVersion>0.1.18.0</AssemblyVersion>
    <FileVersion>0.1.18.0</FileVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer Condition="'$(Configuration)' == 'Release'">false</IncludeDebugSymbolsInVSIXContainer>
    <VsHostPackageDirectory Condition="'$(VsHostPackageDirectory)' == ''">$(MSBuildProjectDirectory)\..\AvaloniaDesigner.VsHost\bin\$(Configuration)\net8.0</VsHostPackageDirectory>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseWPF>true</UseWPF>
    <DeployExtension>false</DeployExtension>
    <CustomAfterMicrosoftCommonTargets>$(MSBuildProjectDirectory)\VsixBuild.targets</CustomAfterMicrosoftCommonTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.9.37000" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.10.2178" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaloniaDesigner.Host.Protocol\AvaloniaDesigner.Host.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="AvaloniaDesigner.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <Content Include="source.extension.vsixmanifest">
      <IncludeInVSIXContainer>true</IncludeInVSIXContainer>
    </Content>
    <!-- The bridge packages the external process as content. The VSIX assembly itself has no
         Avalonia/Eremex/FormDesigner assembly reference, so devenv.exe never loads them. -->
  </ItemGroup>

  <!-- Add net8 payload only after bridge references have been resolved. Evaluated
       Content DLLs otherwise become CandidateAssemblyFiles for the net472 compiler. -->
  <Target Name="CollectExternalVsHostRuntime" BeforeTargets="GetVsixSourceItems" DependsOnTargets="BuildExternalVsHost">
    <Error Condition="!Exists('$(VsHostPackageDirectory)\AvaloniaDesigner.VsHost.exe')" Text="VsHost runtime was not prepared: $(VsHostPackageDirectory)" />
    <ItemGroup>
      <_VsHostPayload Include="$(VsHostPackageDirectory)\**\*" Exclude="$(VsHostPackageDirectory)\**\*.pdb;$(VsHostPackageDirectory)\**\*.log;$(VsHostPackageDirectory)\**\*.tmp" />
      <VSIXSourceItem Include="@(_VsHostPayload)">
        <VSIXSubPath>VsHost\%(_VsHostPayload.RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <!-- A net472 VSSDK bridge cannot have a ProjectReference to a modern .NET executable, even when
       ReferenceOutputAssembly is false. Build the external process as package content instead. -->
  <Target Name="BuildExternalVsHost" BeforeTargets="Build">
    <MSBuild Projects="..\AvaloniaDesigner.VsHost\AvaloniaDesigner.VsHost.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
