<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="smoke-tests\**\*.cs" />
    <Compile Remove="templates\**\*.cs" />
    <Compile Remove="tempobj\**\*.cs" />
    <AvaloniaXaml Remove="artifacts\**\*.axaml" />
    <AvaloniaXaml Remove="smoke-tests\**\*.axaml" />
    <AvaloniaXaml Remove="templates\**\*.axaml" />
    <AvaloniaXaml Remove="Samples\RoundTrip\**\*.axaml" />
    <AvaloniaXaml Remove="Samples\VisualStudioPoC\**\*.axaml" />
    <AvaloniaXaml Remove="Plugins\**\*.axaml" />
    <AvaloniaResource Remove="artifacts\**\*.axaml" />
    <AvaloniaResource Remove="smoke-tests\**\*.axaml" />
    <AvaloniaResource Remove="templates\**\*.axaml" />
    <AvaloniaResource Remove="Samples\RoundTrip\**\*.axaml" />
    <AvaloniaResource Remove="Samples\VisualStudioPoC\**\*.axaml" />
    <AvaloniaResource Remove="tempobj\**\*.axaml" />
    <Compile Remove="PluginContracts\**\*.cs" />
    <Compile Remove="Plugins\**\*.cs" />
    <Compile Remove="AvaloniaDesigner.Host.Protocol\**\*.cs" />
    <Compile Remove="AvaloniaDesigner.VsHost\**\*.cs" />
    <Compile Remove="AvaloniaDesigner.VSIX\**\*.cs" />
    <Compile Remove="Samples\VisualStudioPoC\**\*.cs" />
    <AvaloniaXaml Remove="AvaloniaDesigner.VsHost\**\*.axaml" />
    <EmbeddedResource Remove="artifacts\**" />
    <EmbeddedResource Remove="smoke-tests\**" />
    <EmbeddedResource Remove="templates\**" />
    <EmbeddedResource Remove="tempobj\**" />
    <EmbeddedResource Remove="PluginContracts\**" />
    <EmbeddedResource Remove="Plugins\**" />
    <EmbeddedResource Remove="AvaloniaDesigner.Host.Protocol\**" />
    <EmbeddedResource Remove="AvaloniaDesigner.VsHost\**" />
    <EmbeddedResource Remove="AvaloniaDesigner.VSIX\**" />
    <Content Remove="artifacts\**" />
    <Content Remove="smoke-tests\**" />
    <Content Remove="templates\**" />
    <None Remove="artifacts\**" />
    <None Remove="smoke-tests\**" />
    <None Remove="templates\**" />
    <None Remove="tempobj\**" />
    <None Remove="PluginContracts\**" />
    <None Remove="Plugins\**" />
    <None Remove="AvaloniaDesigner.Host.Protocol\**" />
    <None Remove="AvaloniaDesigner.VsHost\**" />
    <None Remove="AvaloniaDesigner.VSIX\**" />
    <None Remove="Samples\VisualStudioPoC\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.1.5" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.5" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.1.5" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.0.0.18" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.5">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PluginContracts\FormDesigner.PluginContracts.csproj" />
    <ProjectReference Include="Plugins\DemoDesignerPlugin\DemoDesignerPlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Plugins\EremexDesignerPlugin\EremexDesignerPlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Plugins\MinimalDesignerPlugin\MinimalDesignerPlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
