<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="600" Height="400">
    <Grid>
        <Expander x:Name="Expand" Header="Grid content" IsExpanded="True" Width="300" Height="240" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Expander.Content>
                <Grid x:Name="Body" RowDefinitions="Auto,*" ColumnDefinitions="100,*">
                    <TextBlock x:Name="Label" Text="Label" Height="20"/>
                    <Button x:Name="Action" Grid.Row="1" Grid.Column="1" Content="Apply"/>
                </Grid>
            </Expander.Content>
        </Expander>
    </Grid>
</Window>
