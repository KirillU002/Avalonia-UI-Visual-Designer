<Window xmlns="https://github.com/avaloniaui" Width="800" Height="600">
  <Border Name="Card" Padding="12,16,20,24" BorderThickness="1,2,3,4" CornerRadius="2,4,6,8" BorderBrush="#445566" Background="#EEEEEE">
    <Grid Name="Layout" RowDefinitions="Auto,Auto,*" ColumnDefinitions="Auto,*" Margin="7">
      <TextBlock Name="Title" Text="Вход" FontSize="20" FontWeight="Bold" Foreground="#123456" Grid.ColumnSpan="2"/>
      <TextBox Name="UserName" Text="user" Watermark="Имя" Padding="3,5,7,9" Grid.Row="1" Grid.Column="1" Margin="8"/>
      <Button Name="Submit" Content="Войти" Width="160" Height="48" Padding="1,2,3,4" CornerRadius="1,3,5,7" Margin="9,11,13,15" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="Arial" FontStyle="Italic" Opacity="0.6" Grid.Row="2" Grid.Column="1"/>
    </Grid>
  </Border>
</Window>
