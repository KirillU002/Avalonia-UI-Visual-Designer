<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:UserApplication.ViewModels"
        xmlns:custom="using:UserApplication.Controls"
        x:Class="UserApplication.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d" d:DesignWidth="900"
        Width="900" Height="600" Title="Complex AXAML">
    <!-- keep me: user-owned markup -->
    <Window.Resources>
        <SolidColorBrush x:Key="Accent">#123456</SolidColorBrush>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
    </Window.Styles>
    <Canvas>
        <Button x:Name="Button1" Content="Old" Width="160" Height="40"
                Canvas.Left="100" Canvas.Top="100" custom:Custom.Unknown="keep-me" />
        <TextBox x:Name="TextBox1" Text="Hello" Width="220" Height="40" Canvas.Top="160" />
        <TextBlock x:Name="BoundText" Text="{Binding Greeting}" Canvas.Top="210" />
        <custom:Button x:Name="OpaqueButton" Content="Never edit a custom namesake" />
        <custom:CustomControl custom:Layout.Option="{Binding Option}">
            <Grid><TextBlock Text="Opaque nested content" /></Grid>
        </custom:CustomControl>
        <Border><StackPanel><CheckBox Content="Nested, opaque" /></StackPanel></Border>
    </Canvas>
</Window>
