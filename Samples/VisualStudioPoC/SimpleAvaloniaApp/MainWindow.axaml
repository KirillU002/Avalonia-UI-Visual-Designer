<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:custom="using:SimpleAvaloniaApp"
        x:Class="SimpleAvaloniaApp.MainWindow"
        Title="Visual Studio PoC"
        Width="640"
        Height="420">
    <Canvas>
        <!-- keep me -->
        <Button
            x:Name="Button1"
            Content="Привет"
            Width="160"
            Height="40"
            Canvas.Left="350"
            Canvas.Top="140" />

        <TextBox
            x:Name="TextBox1"
            Text="Hello"
            Width="220"
            Height="40"
            Canvas.Left="30"
            Canvas.Top="30"
            custom:Custom.Unknown="keep-me" />

        <Button
            x:Name="Button2"
            Width="160"
            Height="40"
            Canvas.Left="90"
            Canvas.Top="300"
            Content="Кнопка"  Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8" CornerRadius="8" Padding="10" FontWeight="SemiBold"/>
        <CheckBox
            x:Name="CheckBox1"
            Width="180"
            Height="32"
            Canvas.Left="90"
            Canvas.Top="210"
            Content="Флажок" />
    </Canvas>
</Window>
