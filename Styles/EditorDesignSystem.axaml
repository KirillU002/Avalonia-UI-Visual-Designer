<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="EditorColorAppBackground">#EAF1F8</Color>
    <Color x:Key="EditorColorSurface">#F8FAFC</Color>
    <Color x:Key="EditorColorPanel">#FFFFFF</Color>
    <Color x:Key="EditorColorPanelMuted">#F1F5F9</Color>
    <Color x:Key="EditorColorBorder">#CBD5E1</Color>
    <Color x:Key="EditorColorBorderStrong">#94A3B8</Color>
    <Color x:Key="EditorColorText">#0F172A</Color>
    <Color x:Key="EditorColorTextMuted">#64748B</Color>
    <Color x:Key="EditorColorPrimary">#1D4ED8</Color>
    <Color x:Key="EditorColorPrimaryHover">#2563EB</Color>
    <Color x:Key="EditorColorPrimaryPressed">#1E40AF</Color>
    <Color x:Key="EditorColorSuccess">#15803D</Color>
    <Color x:Key="EditorColorWarning">#B45309</Color>
    <Color x:Key="EditorColorError">#DC2626</Color>

    <SolidColorBrush x:Key="EditorBrushAppBackground" Color="{StaticResource EditorColorAppBackground}"/>
    <SolidColorBrush x:Key="EditorBrushSurface" Color="{StaticResource EditorColorSurface}"/>
    <SolidColorBrush x:Key="EditorBrushPanel" Color="{StaticResource EditorColorPanel}"/>
    <SolidColorBrush x:Key="EditorBrushPanelMuted" Color="{StaticResource EditorColorPanelMuted}"/>
    <SolidColorBrush x:Key="EditorBrushBorder" Color="{StaticResource EditorColorBorder}"/>
    <SolidColorBrush x:Key="EditorBrushBorderStrong" Color="{StaticResource EditorColorBorderStrong}"/>
    <SolidColorBrush x:Key="EditorBrushText" Color="{StaticResource EditorColorText}"/>
    <SolidColorBrush x:Key="EditorBrushTextMuted" Color="{StaticResource EditorColorTextMuted}"/>
    <SolidColorBrush x:Key="EditorBrushPrimary" Color="{StaticResource EditorColorPrimary}"/>
    <SolidColorBrush x:Key="EditorBrushPrimaryHover" Color="{StaticResource EditorColorPrimaryHover}"/>
    <SolidColorBrush x:Key="EditorBrushPrimaryPressed" Color="{StaticResource EditorColorPrimaryPressed}"/>
    <SolidColorBrush x:Key="EditorBrushSuccess" Color="{StaticResource EditorColorSuccess}"/>
    <SolidColorBrush x:Key="EditorBrushWarning" Color="{StaticResource EditorColorWarning}"/>
    <SolidColorBrush x:Key="EditorBrushError" Color="{StaticResource EditorColorError}"/>

    <x:String x:Key="EditorDensityDefault">Compact</x:String>
    <x:Double x:Key="EditorControlHeightDense">24</x:Double>
    <x:Double x:Key="EditorControlHeightCompact">28</x:Double>
    <x:Double x:Key="EditorControlHeightComfortable">34</x:Double>
    <x:Double x:Key="EditorToolbarHeightCompact">30</x:Double>
    <x:Double x:Key="EditorPanelHeaderHeightCompact">32</x:Double>
    <x:Double x:Key="EditorPropertyRowHeightCompact">26</x:Double>
    <x:Double x:Key="EditorToolboxRowHeightCompact">42</x:Double>
    <x:Double x:Key="EditorDockRailWidthCompact">32</x:Double>
    <x:Double x:Key="EditorBottomPanelHeightCompact">180</x:Double>

    <Thickness x:Key="EditorSpaceXs">3</Thickness>
    <Thickness x:Key="EditorSpaceSm">6</Thickness>
    <Thickness x:Key="EditorSpaceMd">8</Thickness>
    <Thickness x:Key="EditorSpaceLg">12</Thickness>
    <Thickness x:Key="EditorPanelPadding">8</Thickness>
    <Thickness x:Key="EditorButtonPaddingCompact">8,4</Thickness>
    <Thickness x:Key="EditorCardPaddingCompact">8</Thickness>
    <Thickness x:Key="EditorToolbarPaddingCompact">6,4</Thickness>

    <CornerRadius x:Key="EditorRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="EditorRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="EditorRadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="EditorRadiusPill">999</CornerRadius>
  </Styles.Resources>

  <Style Selector="Button.editor-primary-button">
    <Setter Property="MinHeight" Value="{DynamicResource EditorControlHeightCompact}"/>
    <Setter Property="Padding" Value="{DynamicResource EditorButtonPaddingCompact}"/>
    <Setter Property="Background" Value="{DynamicResource EditorBrushPrimary}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBrushPrimary}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource EditorRadiusMedium}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Button.editor-primary-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource EditorBrushPrimaryHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBrushPrimaryHover}"/>
  </Style>

  <Style Selector="Button.editor-primary-button:pressed">
    <Setter Property="Background" Value="{DynamicResource EditorBrushPrimaryPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBrushPrimaryPressed}"/>
  </Style>

  <Style Selector="Button.editor-secondary-button">
    <Setter Property="MinHeight" Value="{DynamicResource EditorControlHeightCompact}"/>
    <Setter Property="Padding" Value="{DynamicResource EditorButtonPaddingCompact}"/>
    <Setter Property="Background" Value="{DynamicResource EditorBrushPanel}"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorBrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBrushBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource EditorRadiusMedium}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style Selector="Button.editor-secondary-button:pointerover">
    <Setter Property="Background" Value="#EFF6FF"/>
    <Setter Property="BorderBrush" Value="#60A5FA"/>
  </Style>

  <Style Selector="Button.editor-ghost-button">
    <Setter Property="MinHeight" Value="{DynamicResource EditorControlHeightCompact}"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorBrushText}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource EditorRadiusSmall}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style Selector="Button.editor-ghost-button:pointerover">
    <Setter Property="Background" Value="#EAF2FF"/>
  </Style>

  <Style Selector="Button.editor-danger-button">
    <Setter Property="MinHeight" Value="{DynamicResource EditorControlHeightCompact}"/>
    <Setter Property="Padding" Value="{DynamicResource EditorButtonPaddingCompact}"/>
    <Setter Property="Background" Value="#FEF2F2"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorBrushError}"/>
    <Setter Property="BorderBrush" Value="#FECACA"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource EditorRadiusMedium}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Button.editor-icon-button">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource EditorBrushPanel}"/>
    <Setter Property="Foreground" Value="{DynamicResource EditorBrushText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBrushBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource EditorRadiusMedium}"/>
  </Style>

  <Style Selector="Border.editor-card">
    <Setter Property="Background" Value="{DynamicResource EditorBrushPanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBrushBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource EditorRadiusLarge}"/>
    <Setter Property="Padding" Value="{DynamicResource EditorPanelPadding}"/>
  </Style>

  <Style Selector="Border.editor-panel-header">
    <Setter Property="Background" Value="{DynamicResource EditorBrushPanelMuted}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBrushBorder}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>

  <Style Selector="Border.editor-badge">
    <Setter Property="Background" Value="#EFF6FF"/>
    <Setter Property="BorderBrush" Value="#BFDBFE"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource EditorRadiusPill}"/>
    <Setter Property="Padding" Value="6,2"/>
  </Style>
</Styles>
