<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FormDesigner.Views.HelpWindow"
        Title="Avalonia UI Visual Designer Help Center · Alpha 3.0"
        Width="1480"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#EEF3F8"
        FontFamily="Segoe UI">

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.micro">
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.badgeText">
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.shell">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D9E3EF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BoxShadow" Value="0 22 52 0 #240F172A" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#DCE6F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.softCard">
      <Setter Property="Background" Value="#F8FBFE" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="15" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="#00FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#EFF6FF" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#1D4ED8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="#EFF6FF" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#DBEAFE" />
    </Style>
  </Window.Styles>

  <Border Classes="shell" Margin="10">
    <Grid RowDefinitions="Auto,*">
      <Border Padding="22"
              BorderBrush="#E2E8F0"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,420">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding ProductTitle}" Classes="h1" />
              <TextBlock Text="{Binding ProductSubtitle}" Classes="body" />
            </StackPanel>
            <WrapPanel>
              <Border Background="#DBEAFE" CornerRadius="999" Padding="10,5" Margin="0,0,7,7">
                <TextBlock Text="{Binding VersionText}" Classes="badgeText" />
              </Border>
              <Border Background="#ECFDF5" CornerRadius="999" Padding="10,5" Margin="0,0,7,7">
                <TextBlock Text="MVVM" Foreground="#047857" FontWeight="SemiBold" FontSize="12" />
              </Border>
              <Border Background="#F5F3FF" CornerRadius="999" Padding="10,5" Margin="0,0,7,7">
                <TextBlock Text="AXAML Export" Foreground="#6D28D9" FontWeight="SemiBold" FontSize="12" />
              </Border>
              <Border Background="#FFF7ED" CornerRadius="999" Padding="10,5" Margin="0,0,7,7">
                <TextBlock Text="DataGrid" Foreground="#C2410C" FontWeight="SemiBold" FontSize="12" />
              </Border>
              <Border Background="#F0F9FF" CornerRadius="999" Padding="10,5" Margin="0,0,7,7">
                <TextBlock Text="DLL/SQL" Foreground="#0369A1" FontWeight="SemiBold" FontSize="12" />
              </Border>
            </WrapPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="HelpSearchTextBox"
                       Watermark="Поиск по справке: DataGrid, Export, DLL..."
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       TextChanged="HelpSearchTextBox_TextChanged"
                       MinHeight="38"
                       Padding="12,8" />
              <Button Grid.Column="1"
                      Classes="ghost"
                      Margin="8,0,0,0"
                      Content="Очистить"
                      Command="{Binding ClearSearchCommand}" />
            </Grid>
            <TextBlock Text="{Binding SearchSummary}" Classes="micro" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="260,*">
        <Border Background="#F8FBFE"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0"
                Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <TextBlock Text="Разделы" Classes="h3" Margin="8,0,0,8" />
              <ListBox ItemsSource="{Binding Sections}"
                       SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                       Background="#00FFFFFF"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="10"
                            CornerRadius="10"
                            Background="#00FFFFFF">
                      <Grid ColumnDefinitions="36,*">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="8"
                                Background="#E0F2FE"
                                VerticalAlignment="Top">
                          <TextBlock Text="{Binding Icon}"
                                     Foreground="#0369A1"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}"
                                     Foreground="#0F172A"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Subtitle}"
                                     Classes="micro"
                                     MaxLines="2" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22" Spacing="18">
            <Border CornerRadius="18" Padding="20">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#111827" Offset="0" />
                  <GradientStop Color="#1D4ED8" Offset="0.58" />
                  <GradientStop Color="#0F766E" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid ColumnDefinitions="1.1*,0.9*" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="12">
                  <WrapPanel>
                    <Border Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="999" Padding="9,4" Margin="0,0,7,7">
                      <TextBlock Text="{Binding SelectedSlide.Subtitle}" Foreground="#DBEAFE" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <Border Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="999" Padding="9,4" Margin="0,0,7,7">
                      <TextBlock Text="{Binding SlideCounter}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                  </WrapPanel>
                  <TextBlock Text="{Binding SelectedSlide.Title}"
                             Foreground="#FFFFFF"
                             FontSize="27"
                             FontWeight="Bold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectedSlide.Description}"
                             Foreground="#E0F2FE"
                             FontSize="14"
                             LineHeight="22"
                             TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding SelectedSlide.Tags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#1FFFFFFF"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="9,4"
                                Margin="0,0,7,7">
                          <TextBlock Text="{Binding}" Foreground="#FFFFFF" FontSize="12" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Border Grid.Column="1"
                        CornerRadius="16"
                        Padding="18"
                        Background="#F8FAFC"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        MinHeight="230">
                  <Grid RowDefinitions="*,Auto">
                    <Grid>
                      <Border Width="230"
                              Height="132"
                              CornerRadius="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="#E0F2FE"
                              BorderBrush="#93C5FD"
                              BorderThickness="1" />
                      <Border Width="176"
                              Height="92"
                              CornerRadius="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="{Binding SelectedSlide.AccentBrush}"
                              Opacity="0.88" />
                      <TextBlock Text="{Binding SelectedSlide.Icon}"
                                 Foreground="#FFFFFF"
                                 FontSize="38"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                      <Button Classes="ghost"
                              Content="Назад"
                              Command="{Binding PreviousSlideCommand}" />
                      <ItemsControl Grid.Column="1"
                                    ItemsSource="{Binding CarouselSlides}"
                                    HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Width="18"
                                    Height="18"
                                    Padding="0"
                                    Margin="3"
                                    CornerRadius="9"
                                    Background="#CBD5E1"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.SelectSlideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Grid.Column="2"
                              Classes="primary"
                              Content="Вперёд"
                              Command="{Binding NextSlideCommand}" />
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SelectedSection.Title}" Classes="h2" />
                <TextBlock Text="{Binding SelectedSection.Subtitle}" Classes="body" />
              </StackPanel>
              <Border Grid.Column="1"
                      Background="#DBEAFE"
                      CornerRadius="12"
                      Padding="14,8"
                      VerticalAlignment="Center">
                <TextBlock Text="Alpha 3.0"
                           Foreground="#1D4ED8"
                           FontWeight="Bold" />
              </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding SelectedQuickActions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="ghost"
                          Width="260"
                          Margin="0,0,10,10"
                          HorizontalContentAlignment="Stretch"
                          Command="{Binding DataContext.GoToSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding TargetSectionId}">
                    <Grid ColumnDefinitions="34,*">
                      <Border Width="26"
                              Height="26"
                              CornerRadius="8"
                              Background="#DBEAFE">
                        <TextBlock Text="{Binding Icon}"
                                   Foreground="#1D4ED8"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" Foreground="#0F172A" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" Classes="micro" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding SelectedFeatureCards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card"
                          Width="260"
                          MinHeight="142"
                          Margin="0,0,12,12">
                    <StackPanel Spacing="10">
                      <Border Width="40"
                              Height="40"
                              CornerRadius="12"
                              Background="{Binding AccentBrush}">
                        <TextBlock Text="{Binding Icon}"
                                   Foreground="#FFFFFF"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Title}" Classes="h3" />
                      <TextBlock Text="{Binding Description}" Classes="body" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding SelectedArticles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="softCard" Margin="0,0,0,12">
                    <StackPanel Spacing="10">
                      <TextBlock Text="{Binding Title}" Classes="h3" />
                      <TextBlock Text="{Binding Body}" Classes="body" />
                      <ItemsControl ItemsSource="{Binding Bullets}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                              <Border Width="7"
                                      Height="7"
                                      CornerRadius="7"
                                      Background="#2563EB"
                                      Margin="0,6,9,0"
                                      VerticalAlignment="Top" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding}"
                                         Classes="body" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
