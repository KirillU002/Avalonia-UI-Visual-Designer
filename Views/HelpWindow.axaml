<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FormDesigner.Views.HelpWindow"
        Title="Справка по конструктору форм"
        Width="1280"
        Height="860"
        MinWidth="1040"
        MinHeight="720"
        Background="#EEF3F8"
        FontFamily="Segoe UI">

    <Window.Styles>
        <Style Selector="TextBlock.hero-kicker">
            <Setter Property="Foreground" Value="#93C5FD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="TextBlock.hero-title">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="31" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.hero-body">
            <Setter Property="Foreground" Value="#DCEBFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.slide-title">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.slide-body">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.tab-title">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.card-title">
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.body">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.micro">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.code">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.hero">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#203A58" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.surface">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#D9E3EF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.soft-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#DCE6F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="Border.tinted-card">
            <Setter Property="Background" Value="#F8FBFE" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="Border.code-card">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="Button.step-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE6F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.step-card:pointerover">
            <Setter Property="Background" Value="#F4F8FF" />
            <Setter Property="BorderBrush" Value="#93C5FD" />
        </Style>

        <Style Selector="Button.carousel-nav">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#36FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.carousel-nav:pointerover">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderBrush" Value="#93C5FD" />
        </Style>

        <Style Selector="Border.carousel-dot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#64748B" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.carousel-dot:pointerover">
            <Setter Property="Background" Value="#BFDBFE" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,9" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*"
          RowSpacing="14"
          Margin="16">
        <Border Classes="hero"
                Padding="18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#111827" Offset="0" />
                    <GradientStop Color="#1F4F70" Offset="0.55" />
                    <GradientStop Color="#256D6A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid ColumnDefinitions="0.92*,1.08*"
                  ColumnSpacing="18">
                <StackPanel Spacing="14"
                            VerticalAlignment="Center"
                            MaxWidth="480">
                    <StackPanel Spacing="7">
                        <TextBlock Classes="hero-kicker"
                                   Text="PRODUCT GUIDE" />
                        <TextBlock Classes="hero-title"
                                   Text="Создавайте формы, подключайте данные и экспортируйте рабочий Avalonia UI" />
                        <TextBlock Classes="hero-body"
                                   Text="Эта справка собрана как onboarding center: быстрые шаги, визуальные сценарии, экспорт, BindingSource и plugin system без ощущения технической свалки." />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">
                        <Border Background="#18FFFFFF"
                                BorderBrush="#2AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Design"
                                           Foreground="#FFFFFF"
                                           FontWeight="Bold" />
                                <TextBlock Text="Canvas, toolbox, properties"
                                           Classes="slide-body" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Background="#18FFFFFF"
                                BorderBrush="#2AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Data"
                                           Foreground="#FFFFFF"
                                           FontWeight="Bold" />
                                <TextBlock Text="BindingSource, DataGrid"
                                           Classes="slide-body" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                Background="#18FFFFFF"
                                BorderBrush="#2AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Export"
                                           Foreground="#FFFFFF"
                                           FontWeight="Bold" />
                                <TextBlock Text="XAML, C#, checklist"
                                           Classes="slide-body" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#D90B1220"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <Grid RowDefinitions="*,Auto"
                          RowSpacing="12">
                        <Grid Height="268">
                            <Border x:Name="DemoFrame0"
                                    Background="#F8FAFC"
                                    CornerRadius="10"
                                    Padding="12">
                                <Grid ColumnDefinitions="96,*,116"
                                      ColumnSpacing="10">
                                    <Border Background="#E0F2FE"
                                            BorderBrush="#7DD3FC"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="9">
                                        <StackPanel Spacing="7">
                                            <Border Background="#0369A1" CornerRadius="5" Height="24" />
                                            <Border Background="#BAE6FD" CornerRadius="5" Height="20" />
                                            <Border Background="#BAE6FD" CornerRadius="5" Height="20" />
                                            <Border Background="#BAE6FD" CornerRadius="5" Height="20" />
                                            <Border Background="#67E8F9" CornerRadius="5" Height="20" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#FFFFFF"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="14">
                                        <Grid>
                                            <Border Background="#EFF6FF"
                                                    BorderBrush="#2563EB"
                                                    BorderThickness="2"
                                                    CornerRadius="7"
                                                    Width="220"
                                                    Height="42"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="38,28,0,0" />
                                            <Border Background="#ECFDF5"
                                                    BorderBrush="#10B981"
                                                    BorderThickness="2"
                                                    CornerRadius="7"
                                                    Width="170"
                                                    Height="68"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="84,112,0,0" />
                                            <Border Background="#F59E0B"
                                                    CornerRadius="12"
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="244,104,0,0" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="#F8FAFC"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="9">
                                        <StackPanel Spacing="8">
                                            <Border Background="#CBD5E1" CornerRadius="4" Height="16" />
                                            <Border Background="#E2E8F0" CornerRadius="4" Height="18" />
                                            <Border Background="#E2E8F0" CornerRadius="4" Height="18" />
                                            <Border Background="#DBEAFE" CornerRadius="4" Height="18" />
                                            <Border Background="#E2E8F0" CornerRadius="4" Height="18" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="DemoFrame1"
                                    Background="#F8FAFC"
                                    CornerRadius="10"
                                    Padding="12"
                                    IsVisible="False">
                                <Grid ColumnDefinitions="1.4*,*"
                                      ColumnSpacing="12">
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              RowSpacing="7">
                                            <Border Background="#0F766E" CornerRadius="6" Height="28" />
                                            <Grid Grid.Row="1" ColumnDefinitions="52,*,*,*">
                                                <Border Background="#E2E8F0" CornerRadius="4" Height="20" Margin="0,0,6,0" />
                                                <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="4" Height="20" Margin="0,0,6,0" />
                                                <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="4" Height="20" Margin="0,0,6,0" />
                                                <Border Grid.Column="3" Background="#E2E8F0" CornerRadius="4" Height="20" />
                                            </Grid>
                                            <Border Grid.Row="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="5" Height="34" />
                                            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Height="34" />
                                            <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Height="34" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#F0FDF4"
                                            BorderBrush="#BBF7D0"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Customers"
                                                       Foreground="#14532D"
                                                       FontWeight="Bold" />
                                            <WrapPanel>
                                                <Border Background="#DCFCE7" CornerRadius="7" Padding="8,4" Margin="0,0,6,6"><TextBlock Text="Id" Foreground="#166534" /></Border>
                                                <Border Background="#DCFCE7" CornerRadius="7" Padding="8,4" Margin="0,0,6,6"><TextBlock Text="Name" Foreground="#166534" /></Border>
                                                <Border Background="#DCFCE7" CornerRadius="7" Padding="8,4" Margin="0,0,6,6"><TextBlock Text="Email" Foreground="#166534" /></Border>
                                                <Border Background="#DCFCE7" CornerRadius="7" Padding="8,4" Margin="0,0,6,6"><TextBlock Text="Phone" Foreground="#166534" /></Border>
                                                <Border Background="#DCFCE7" CornerRadius="7" Padding="8,4" Margin="0,0,6,6"><TextBlock Text="Status" Foreground="#166534" /></Border>
                                            </WrapPanel>
                                            <Border Background="#FFFFFF" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="7" Height="78" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="DemoFrame2"
                                    Background="#F8FAFC"
                                    CornerRadius="10"
                                    Padding="12"
                                    IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto,*"
                                      ColumnSpacing="14"
                                      VerticalAlignment="Center">
                                    <Border Background="#EEF2FF"
                                            BorderBrush="#A5B4FC"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Event"
                                                       Foreground="#3730A3"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="DataGrid.SelectionChanged"
                                                       Classes="body" />
                                            <Border Background="#C7D2FE" CornerRadius="5" Height="30" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="->"
                                                   Foreground="#334155"
                                                   FontSize="28"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="rule"
                                                   Foreground="#64748B"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="#FEF3C7"
                                            BorderBrush="#FBBF24"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Action"
                                                       Foreground="#92400E"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="Set details fields + Show panel"
                                                       Classes="body" />
                                            <Grid ColumnDefinitions="*,*"
                                                  ColumnSpacing="7">
                                                <Border Background="#FDE68A" CornerRadius="5" Height="30" />
                                                <Border Grid.Column="1" Background="#FDE68A" CornerRadius="5" Height="30" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="DemoFrame3"
                                    Background="#0F172A"
                                    CornerRadius="10"
                                    Padding="12"
                                    IsVisible="False">
                                <Grid ColumnDefinitions="1.25*,*"
                                      ColumnSpacing="12">
                                    <Border Background="#111827"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="&lt;Window&gt;"
                                                       Classes="code" />
                                            <TextBlock Text="  &lt;Grid RowDefinitions=&quot;Auto,*&quot;&gt;"
                                                       Classes="code" />
                                            <TextBlock Text="    &lt;DataGrid ItemsSource=&quot;{Binding Customers}&quot; /&gt;"
                                                       Classes="code" />
                                            <TextBlock Text="  &lt;/Grid&gt;"
                                                       Classes="code" />
                                            <TextBlock Text="&lt;/Window&gt;"
                                                       Classes="code" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#F8FAFC"
                                            CornerRadius="8"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Export checklist"
                                                       Foreground="#0F172A"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="XAML generated: OK"
                                                       Foreground="#15803D" />
                                            <TextBlock Text="C# generated: OK"
                                                       Foreground="#15803D" />
                                            <TextBlock Text="DataGrid: Real"
                                                       Foreground="#2563EB" />
                                            <TextBlock Text="NuGet: DataGrid"
                                                       Foreground="#B45309" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="DemoFrame4"
                                    Background="#F8FAFC"
                                    CornerRadius="10"
                                    Padding="12"
                                    IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto,*"
                                      ColumnSpacing="14"
                                      VerticalAlignment="Center">
                                    <Border Background="#FAE8FF"
                                            BorderBrush="#E879F9"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Plugin DLL"
                                                       Foreground="#86198F"
                                                       FontWeight="Bold" />
                                            <Border Background="#F5D0FE" CornerRadius="6" Height="34" />
                                            <TextBlock Text="IFormDesignerPlugin"
                                                       Classes="body" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="->"
                                               Foreground="#334155"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="2"
                                            Background="#ECFEFF"
                                            BorderBrush="#67E8F9"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Toolbox control"
                                                       Foreground="#155E75"
                                                       FontWeight="Bold" />
                                            <Border Background="#CFFAFE" CornerRadius="6" Height="34" />
                                            <TextBlock Text="Preview + XAML export"
                                                       Classes="body" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="DemoFrame5"
                                    Background="#F8FAFC"
                                    CornerRadius="10"
                                    Padding="12"
                                    IsVisible="False">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <Grid RowDefinitions="Auto,*"
                                          RowSpacing="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="10">
                                            <Border Background="#22C55E" CornerRadius="7" Width="14" Height="14" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Preview mode"
                                                       Foreground="#0F172A"
                                                       FontWeight="Bold" />
                                            <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="7" Padding="9,4">
                                                <TextBlock Text="Running" Foreground="#166534" />
                                            </Border>
                                        </Grid>
                                        <Grid Grid.Row="1"
                                              ColumnDefinitions="1.2*,*"
                                              ColumnSpacing="12">
                                            <StackPanel Spacing="8">
                                                <Border Background="#E2E8F0" CornerRadius="5" Height="28" />
                                                <Border Background="#E2E8F0" CornerRadius="5" Height="28" />
                                                <Border Background="#DBEAFE" CornerRadius="7" Height="38" Width="130" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="#F1F5F9"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="8" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12">
                            <Button Classes="carousel-nav"
                                    Content="Prev"
                                    Click="DemoPreviousButton_Click" />

                            <StackPanel Grid.Column="1"
                                        Spacing="6">
                                <TextBlock x:Name="DemoTitleTextBlock"
                                           Classes="slide-title" />
                                <TextBlock x:Name="DemoDescriptionTextBlock"
                                           Classes="slide-body" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="7"
                                            Margin="0,4,0,0">
                                    <Border x:Name="DemoDot0" Classes="carousel-dot" PointerPressed="DemoDot_Click" />
                                    <Border x:Name="DemoDot1" Classes="carousel-dot" PointerPressed="DemoDot_Click" />
                                    <Border x:Name="DemoDot2" Classes="carousel-dot" PointerPressed="DemoDot_Click" />
                                    <Border x:Name="DemoDot3" Classes="carousel-dot" PointerPressed="DemoDot_Click" />
                                    <Border x:Name="DemoDot4" Classes="carousel-dot" PointerPressed="DemoDot_Click" />
                                    <Border x:Name="DemoDot5" Classes="carousel-dot" PointerPressed="DemoDot_Click" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Classes="carousel-nav"
                                    Content="Next"
                                    Click="DemoNextButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="surface"
                Padding="0">
            <TabControl>
                <TabItem Header="Быстрый старт">
                    <ScrollViewer>
                        <StackPanel Margin="18"
                                    Spacing="16">
                            <Grid ColumnDefinitions="1.35*,*"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="tab-title"
                                               Text="Quick Start: от пустого окна до export" />
                                    <TextBlock Classes="body"
                                               Text="Откройте эту вкладку как маршрут на первые пять минут. Каждый шаг короткий, визуальный и ведет к следующему действию." />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <TextBlock Classes="body"
                                               Text="Совет: сначала соберите форму визуально, затем подключайте BindingSource и interactions. Так проще отделить layout от логики." />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="12">
                                <Button Classes="step-card">
                                    <Grid RowDefinitions="Auto,Auto,*"
                                          RowSpacing="8">
                                        <Border Background="#DBEAFE" CornerRadius="9" Width="40" Height="40" HorizontalAlignment="Left">
                                            <TextBlock Text="1"
                                                       Foreground="#1D4ED8"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Classes="card-title" Text="Создать документ" />
                                        <TextBlock Grid.Row="2" Classes="body" Text="Создайте новый документ или откройте сохраненный файл формы. Сразу задайте понятное имя." />
                                    </Grid>
                                </Button>

                                <Button Grid.Column="1" Classes="step-card">
                                    <Grid RowDefinitions="Auto,Auto,*"
                                          RowSpacing="8">
                                        <Border Background="#DCFCE7" CornerRadius="9" Width="40" Height="40" HorizontalAlignment="Left">
                                            <TextBlock Text="2" Foreground="#15803D" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Classes="card-title" Text="Добавить элементы" />
                                        <TextBlock Grid.Row="2" Classes="body" Text="Перетащите TextBlock, TextBox, Button, CheckBox, ComboBox или DataGrid из toolbox на canvas." />
                                    </Grid>
                                </Button>

                                <Button Grid.Column="2" Classes="step-card">
                                    <Grid RowDefinitions="Auto,Auto,*"
                                          RowSpacing="8">
                                        <Border Background="#FEF3C7" CornerRadius="9" Width="40" Height="40" HorizontalAlignment="Left">
                                            <TextBlock Text="3" Foreground="#B45309" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Classes="card-title" Text="Настроить свойства" />
                                        <TextBlock Grid.Row="2" Classes="body" Text="Выберите элемент и настройте имя, текст, размер, цвета, bindings и специальные свойства компонента." />
                                    </Grid>
                                </Button>

                                <Button Grid.Row="1" Classes="step-card">
                                    <Grid RowDefinitions="Auto,Auto,*"
                                          RowSpacing="8">
                                        <Border Background="#CCFBF1" CornerRadius="9" Width="40" Height="40" HorizontalAlignment="Left">
                                            <TextBlock Text="4" Foreground="#0F766E" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Classes="card-title" Text="Подключить BindingSource" />
                                        <TextBlock Grid.Row="2" Classes="body" Text="Создайте источник данных, добавьте поля и привяжите DataGrid или поля деталей к нужным путям." />
                                    </Grid>
                                </Button>

                                <Button Grid.Row="1" Grid.Column="1" Classes="step-card">
                                    <Grid RowDefinitions="Auto,Auto,*"
                                          RowSpacing="8">
                                        <Border Background="#EDE9FE" CornerRadius="9" Width="40" Height="40" HorizontalAlignment="Left">
                                            <TextBlock Text="5" Foreground="#7C3AED" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Classes="card-title" Text="Проверить Preview" />
                                        <TextBlock Grid.Row="2" Classes="body" Text="Включите Preview mode и проверьте клики, selection, show/hide panels и очистку полей." />
                                    </Grid>
                                </Button>

                                <Button Grid.Row="1" Grid.Column="2" Classes="step-card">
                                    <Grid RowDefinitions="Auto,Auto,*"
                                          RowSpacing="8">
                                        <Border Background="#FCE7F3" CornerRadius="9" Width="40" Height="40" HorizontalAlignment="Left">
                                            <TextBlock Text="6" Foreground="#BE185D" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Classes="card-title" Text="Экспортировать XAML/C#" />
                                        <TextBlock Grid.Row="2" Classes="body" Text="Откройте Code/Export mode, выберите target и layout mode, затем проверьте export checklist." />
                                    </Grid>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Classes="tinted-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Мини-карта интерфейса" />
                                        <TextBlock Classes="body" Text="Canvas отвечает за расположение. Toolbox добавляет элементы. Properties меняет выбранный элемент. Data/BindingSource хранит поля. Code/Export показывает XAML, C# и checklist." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Classes="tinted-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Preview mode" />
                                        <TextBlock Classes="body" Text="Preview нужен для проверки поведения. Если interaction не сработал, сначала проверьте имена controls, выбранные events/actions и diagnostics." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="BindingSource">
                    <ScrollViewer>
                        <StackPanel Margin="18"
                                    Spacing="14">
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="tab-title" Text="BindingSource и DataGrid" />
                                    <TextBlock Classes="body" Text="BindingSource описывает данные формы: имя источника, список полей и runtime items для preview/export. DataGrid использует эти поля как колонки." />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Classes="code-card">
                                    <TextBlock Classes="code"
                                               Text="Customers&#10;  Id: int&#10;  Name: string&#10;  Email: string&#10;  Phone: string&#10;  Status: string" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="12">
                                <Border Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="Создать вручную" />
                                        <TextBlock Classes="body" Text="1. Откройте Data / BindingSource.&#10;2. Создайте источник, например Customers.&#10;3. Добавьте поля и типы.&#10;4. Выберите этот источник в свойствах DataGrid." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="Импорт из DLL/SQL" />
                                        <TextBlock Classes="body" Text="Если импорт включен, выберите DLL-модель или SQL-схему. После импорта проверьте имена полей. Если импорт недоступен, создайте поля вручную." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="Привязать DataGrid" />
                                        <TextBlock Classes="body" Text="Выберите DataGrid -> DataSource/BindingSource -> Customers. Если таблица пустая, проверьте, что источник выбран и содержит поля." />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="12">
                                <Border Background="#F8FAFC"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="Placeholder без NuGet" />
                                        <TextBlock Classes="body" Text="Безопасная заглушка. Не рабочая таблица. Используется, когда нет источника, нет полей или нужен максимально совместимый export." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="Visual table без NuGet" />
                                        <TextBlock Classes="body" Text="Визуальный макет таблицы на стандартных Avalonia controls. Подходит для прототипа, но это не настоящий DataGrid." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="#ECFDF5"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="Real Avalonia DataGrid" />
                                        <TextBlock Classes="body" Text="Настоящий DataGrid для selection, sorting и runtime behavior. Требует NuGet Avalonia.Controls.DataGrid." />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Classes="tinted-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Если источник данных не выбран" />
                                        <TextBlock Classes="body" Text="Выберите DataGrid, назначьте BindingSource и проверьте, что источник не был удален или переименован." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Classes="tinted-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Если поля не добавлены" />
                                        <TextBlock Classes="body" Text="Откройте BindingSource и добавьте минимум одно поле. Для клиентов обычно нужны Id, Name, Email, Phone и Status." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Export">
                    <ScrollViewer>
                        <StackPanel Margin="18"
                                    Spacing="14">
                            <Grid ColumnDefinitions="1.1*,*"
                                  ColumnSpacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="tab-title" Text="Export XAML/C#" />
                                    <TextBlock Classes="body" Text="Code/Export mode показывает готовый XAML, C# и checklist. Сначала выберите target и layout mode, затем копируйте файлы в Avalonia project." />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Classes="code-card">
                                    <TextBlock Classes="code"
                                               Text="dotnet new avalonia.app -n ExportCheck&#10;dotnet add package Avalonia.Controls.DataGrid&#10;# вставьте XAML и C#&#10;dotnet build" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="12">
                                <Border Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="Target" />
                                        <TextBlock Classes="body" Text="MainWindow replacement быстро заменяет главное окно. Generated Form1Window создает отдельное окно для подключения к существующему app." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="XAML verbosity" />
                                        <TextBlock Classes="body" Text="Компактный режим удобен для чтения. Подробный режим полезен для защиты, диагностики и сравнения с дизайнером." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="Layout export mode" />
                                        <TextBlock Classes="body" Text="Canvas layout сохраняет точное расположение. Responsive layout experimental пробует адаптивную структуру и требует визуальной проверки." />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Background="#F0FDF4"
                                        BorderBrush="#BBF7D0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Export checklist" />
                                        <TextBlock Classes="body" Text="Проверяет XAML generated, C# generated, DataGrid mode, Required NuGet, interactions exported и plugins. Warning означает, что export возможен, но проекту нужно действие." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#FFF7ED"
                                        BorderBrush="#FED7AA"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Real DataGrid при export" />
                                        <TextBlock Classes="body" Text="Для рабочего DataGrid установите Avalonia.Controls.DataGrid. Без пакета выбирайте Placeholder или Visual table, если нужен переносимый макет." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Plugin System">
                    <ScrollViewer>
                        <StackPanel Margin="18"
                                    Spacing="14">
                            <Grid ColumnDefinitions="1.05*,*"
                                  ColumnSpacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="tab-title" Text="Как подключить свой plugin control" />
                                    <TextBlock Classes="body" Text="Plugin system добавляет новые controls без изменения основного приложения. DLL регистрирует descriptors, а descriptor строит preview, свойства и XAML export." />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#FAE8FF"
                                        BorderBrush="#E879F9"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <TextBlock Classes="body"
                                               Text="Главная идея: plugin описывает control один раз, а дизайнер использует это описание в toolbox, properties, preview и export." />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*,*"
                                  ColumnSpacing="12">
                                <Border Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="1. Собрать DLL" />
                                        <TextBlock Classes="body" Text="Создайте проект plugin и добавьте ссылку на FormDesigner.PluginContracts." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="2. Register descriptor" />
                                        <TextBlock Classes="body" Text="IFormDesignerPlugin.Register вызывает registry.RegisterControl(...)." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="3. Положить в Plugins" />
                                        <TextBlock Classes="body" Text="Скопируйте DLL и зависимости в папку Plugins рядом с приложением." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="4. Restart/reload" />
                                        <TextBlock Classes="body" Text="Перезапустите редактор или используйте reload plugins, если он доступен в текущей сборке." />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#F8FAFC"
                                    BorderBrush="#D7E2EE"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="SDK examples and template" />
                                    <TextBlock Classes="body" Text="MinimalDesignerPlugin показывает самый маленький рабочий control plugin: один descriptor, preview, custom property и XAML export. DesignerPluginTemplate можно скопировать как основу нового plugin." />
                                    <TextBlock Classes="body" Text="Сборка: dotnet build .\Plugins\MinimalDesignerPlugin\MinimalDesignerPlugin.csproj. Шаблон: templates\DesignerPluginTemplate. Ошибки загрузки смотрите во вкладке Plugins: DLL count, статус, controls, duplicate TypeKey и dependency errors." />
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Classes="tinted-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Что делает descriptor" />
                                        <TextBlock Classes="body" Text="CreateDefaultDefinition задает стартовые свойства. BuildPreview создает Avalonia control для дизайнера и preview. AppendXaml пишет XAML для export. Properties описывает редакторы в панели свойств." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Classes="tinted-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Fallback descriptor" />
                                        <TextBlock Classes="body" Text="Если plugin DLL не загрузилась, missing/fallback descriptor сохраняет документ открываемым и показывает диагностику, вместо того чтобы ломать форму." />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Classes="code-card">
                                <TextBlock Classes="code"
                                           Text="using FormDesigner.PluginContracts;&#10;&#10;[assembly: FormDesignerPlugin(typeof(MyPlugin))]&#10;&#10;public sealed class MyPlugin : IFormDesignerPlugin&#10;{&#10;    public string Id =&gt; &quot;Acme.Tools&quot;;&#10;    public string Title =&gt; &quot;Acme Tools&quot;;&#10;    public Version ApiVersion =&gt; new(1, 0, 0);&#10;&#10;    public void Register(IDesignerRegistry registry)&#10;    {&#10;        registry.RegisterControl(new MyControlDescriptor());&#10;    }&#10;}&#10;&#10;public sealed class MyControlDescriptor : IControlDescriptor&#10;{&#10;    // TypeKey, Title, Properties&#10;    // CreateDefaultDefinition(...)&#10;    // BuildPreview(...)&#10;    // AppendXaml(...)&#10;}" />
                            </Border>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Background="#ECFEFF"
                                        BorderBrush="#67E8F9"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Preview provider" />
                                        <TextBlock Classes="body" Text="BuildPreview должен возвращать настоящий Avalonia Control. Здесь учитывайте размеры, видимость, custom properties и BindingSource preview items." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#F0FDF4"
                                        BorderBrush="#BBF7D0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="section-title" Text="Export provider" />
                                        <TextBlock Classes="body" Text="AppendXaml регистрирует XML namespace и пишет control tag. Если control требует NuGet или DLL, укажите это в документации plugin." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Templates">
                    <ScrollViewer>
                        <StackPanel Margin="18"
                                    Spacing="14">
                            <Grid ColumnDefinitions="1.2*,*"
                                  ColumnSpacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="tab-title" Text="Templates и готовые сценарии" />
                                    <TextBlock Classes="body" Text="Templates нужны для быстрого старта: они вставляют готовый набор controls, BindingSource и interactions, который можно сразу адаптировать под свою форму." />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Classes="tinted-card">
                                    <TextBlock Classes="body"
                                               Text="Откройте Templates / Snippets, выберите шаблон и вставьте его в текущий документ. После вставки проверьте имена controls и BindingSource." />
                                </Border>
                            </Grid>

                            <Border Background="#FFFFFF"
                                    BorderBrush="#DCE6F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="16">
                                    <Border Background="#DBEAFE"
                                            CornerRadius="10"
                                            Width="62"
                                            Height="62"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="CRUD"
                                                   Foreground="#1D4ED8"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Spacing="7">
                                        <TextBlock Classes="section-title" Text="Форма клиентов" />
                                        <TextBlock Classes="body" Text="Готовый demo template для защиты проекта: DataGrid клиентов, BindingSource Customers, панель деталей и кнопки Добавить / Сохранить / Удалить / Очистить / Показать сообщение." />
                                        <TextBlock Classes="micro" Text="Interactions: SelectionChanged заполняет детали, Clear очищает поля, ShowMessage показывает сообщение, Show/Hide переключает панель деталей." />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="#FFF7ED"
                                            BorderBrush="#FED7AA"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Width="220">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Export note"
                                                       Foreground="#92400E"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="Для Real DataGrid нужен NuGet:"
                                                       Classes="micro" />
                                            <TextBlock Text="Avalonia.Controls.DataGrid"
                                                       Foreground="#0F172A"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="Когда использовать template" />
                                        <TextBlock Classes="body" Text="Когда нужен быстрый пример для demo, обучения или smoke-проверки export. Template можно разобрать по частям и заменить данные на свои." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Classes="soft-card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="card-title" Text="После вставки" />
                                        <TextBlock Classes="body" Text="Откройте Preview, проверьте interactions, затем перейдите в Export и посмотрите checklist: XAML, C#, DataGrid mode, NuGet, interactions, plugins." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
