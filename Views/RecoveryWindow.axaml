<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FormDesigner.Views.RecoveryWindow"
        Width="560"
        Height="340"
        MinWidth="520"
        MinHeight="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Восстановление черновика"
        Background="#EEF4FA">
  <Border Margin="18"
          Background="White"
          BorderBrush="#D7E2EE"
          BorderThickness="1"
          CornerRadius="18"
          Padding="18">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="Найден черновик после предыдущей сессии"
                   FontSize="22"
                   FontWeight="Bold"/>
        <TextBlock Text="Можно восстановить последний автосохранённый документ или проигнорировать его."
                   Foreground="#475569"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Row="1"
              Background="#F8FAFC"
              BorderBrush="#D7E2EE"
              BorderThickness="1"
              CornerRadius="14"
              Padding="14">
        <StackPanel Spacing="8">
          <TextBlock x:Name="DraftTitleTextBlock"
                     FontWeight="SemiBold"
                     FontSize="16"/>
          <TextBlock x:Name="DraftTimestampTextBlock"
                     Foreground="#475569"/>
          <TextBlock x:Name="DraftPathTextBlock"
                     Foreground="#64748B"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              Background="#EFF6FF"
              BorderBrush="#BFDBFE"
              BorderThickness="1"
              CornerRadius="14"
              Padding="14">
        <TextBlock Text="Восстановление откроет черновик как несохранённое состояние. Обычный файл документа при этом не будет перезаписан."
                   Foreground="#1E3A8A"
                   TextWrapping="Wrap"/>
      </Border>

      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button Content="Удалить recovery"
                Click="DeleteButton_Click"
                MinWidth="130"/>
        <Button Content="Открыть обычный документ"
                Click="IgnoreButton_Click"
                MinWidth="180"/>
        <Button Content="Восстановить черновик"
                Click="RestoreButton_Click"
                MinWidth="170"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

