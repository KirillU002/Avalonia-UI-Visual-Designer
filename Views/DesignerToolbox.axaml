<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:FormDesigner.Models"
             x:Class="FormDesigner.Views.DesignerToolbox"
             x:Name="RootToolbox">
  <ScrollViewer DataContext="{Binding Context, ElementName=RootToolbox}"
                Margin="0,6,0,0"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="6">
      <TextBlock Text="Доступные элементы" FontSize="14" FontWeight="Bold"/>
      <TextBlock Text="Нажмите на карточку и перетащите элемент на поверхность формы."
                 Foreground="#475569"
                 FontSize="11"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"/>
      <TextBox Watermark="Поиск элементов"
               Text="{Binding ToolboxSearchText, Mode=TwoWay}"
               MinHeight="30"
               Padding="8,4"
               FontSize="12"/>
      <ItemsControl ItemsSource="{Binding ToolboxGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:ToolboxGroupModel">
            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,6">
              <Expander.Header>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,4">
                  <Border Width="22" Height="22" CornerRadius="6" Background="#EAF2FF">
                    <TextBlock Text="{Binding Badge}" Foreground="#1D4ED8" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Title}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Items.Count}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ToolboxItem">
                    <Border Margin="0,0,0,3"
                            Padding="6,2"
                            Background="White"
                            BorderBrush="#D7E2EE"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0"
                            PointerPressed="ToolboxItem_PointerPressed"
                            ToolTip.Tip="{Binding Description}">
                      <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="26">
                        <Border Width="18" Height="18" CornerRadius="4" Background="#DBEAFE" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ProviderBadge}" Foreground="#1D4ED8" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
