<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FormDesigner.ViewModels"
        xmlns:models="using:FormDesigner.Models"
        x:Class="FormDesigner.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        Width="1400"
        Height="850"
        MinWidth="1100"
        MinHeight="700"
        Title="Avalonia Form Designer"
        Focusable="True">

	<Grid RowDefinitions="Auto,*">
		<Border Grid.Row="0"
                Background="#F3F3F3"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="12">
			<TextBlock Text="Конструктор форм"
                       FontSize="18"
                       FontWeight="Bold"/>
		</Border>

		<Grid Grid.Row="1" ColumnDefinitions="220,*,300">
			<!-- Левая панель -->
			<Border Grid.Column="0"
                    Margin="8"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="8">
				<StackPanel Spacing="8">
					<TextBlock Text="Компоненты"
                               FontWeight="Bold"/>

					<ItemsControl ItemsSource="{Binding ToolboxItems}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="models:ToolboxItem">
								<Border Margin="0,4,0,0"
                                        Padding="10"
                                        BorderBrush="#CFCFCF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="White"
                                        PointerPressed="ToolboxItem_PointerPressed">
									<StackPanel>
										<TextBlock Text="{Binding Title}" FontWeight="Bold"/>
										<TextBlock Text="{Binding Type}" Foreground="Gray" FontSize="12"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>

			<!-- Центр -->
			<Border Grid.Column="1"
                    Margin="8"
                    BorderBrush="LightGray"
                    BorderThickness="1">
				<Grid RowDefinitions="Auto,*">
					<StackPanel Margin="12" Spacing="8">
						<TextBlock Text="Рабочая область" FontWeight="Bold"/>

						<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
							<TextBlock Text="Размер рабочей зоны"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

							<TextBlock Text="W:" VerticalAlignment="Center"/>
							<TextBox Width="80"
									 Text="{Binding DesignWidth, Mode=TwoWay}"
									 TextChanged="DesignWidthTextBox_TextChanged"/>

							<TextBlock Text="H:" VerticalAlignment="Center"/>
							<TextBox Width="80"
									 Text="{Binding DesignHeight, Mode=TwoWay}"
									 TextChanged="DesignHeightTextBox_TextChanged"/>
						</StackPanel>
					</StackPanel>

					<ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="12">
						<Canvas x:Name="DesignSurfaceHost"
                                Width="{Binding DesignWidth}"
                                Height="{Binding DesignHeight}"
                                Background="Transparent">

							<Border Width="{Binding DesignWidth}"
                                    Height="{Binding DesignHeight}"
                                    Background="White"
                                    BorderBrush="Black"
                                    BorderThickness="1">

								<Canvas x:Name="DesignerCanvas"
                                        Width="{Binding DesignWidth}"
                                        Height="{Binding DesignHeight}"
                                        Background="Transparent"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="DesignerCanvas_DragOver"
                                        DragDrop.Drop="DesignerCanvas_Drop"/>
							</Border>

							<Border x:Name="DesignResizeHandle"
                                    Width="16"
                                    Height="16"
                                    Background="DodgerBlue"
                                    Canvas.Left="{Binding DesignWidth}"
                                    Canvas.Top="{Binding DesignHeight}"
                                    PointerPressed="DesignResizeHandle_PointerPressed"
                                    PointerMoved="DesignResizeHandle_PointerMoved"
                                    PointerReleased="DesignResizeHandle_PointerReleased"/>
						</Canvas>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- Правая панель -->
			<Border Grid.Column="2"
                    Margin="8"
                    BorderBrush="LightGray"
                    BorderThickness="1">
				<Grid RowDefinitions="Auto,*" Margin="8">
					<Border Grid.Row="0"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Padding="8">
						<StackPanel Spacing="6">
							<TextBlock Text="Свойства / XAML"
                                       FontWeight="Bold"/>
							
							<TextBlock Text="Имя"/>
							<TextBox Text="{Binding SelectedControl.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									 Watermark="Name"
									 TextChanged="SelectedNameTextBox_TextChanged"/>

							<TextBlock Text="Текст"/>
							<TextBox Text="{Binding SelectedControl.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									 Watermark="Text"
									 TextChanged="SelectedTextTextBox_TextChanged"/>

							<TextBlock Text="Ширина"/>
							<TextBox Text="{Binding SelectedControl.Width, Mode=TwoWay}"
									 TextChanged="SelectedWidthTextBox_TextChanged"/>

							<TextBlock Text="Высота"/>
							<TextBox Text="{Binding SelectedControl.Height, Mode=TwoWay}"
									 TextChanged="SelectedHeightTextBox_TextChanged"/>

							<TextBlock Text="X"/>
							<TextBox Text="{Binding SelectedControl.X, Mode=TwoWay}"
									 TextChanged="SelectedXTextBox_TextChanged"/>

							<TextBlock Text="Y"/>
							<TextBox Text="{Binding SelectedControl.Y, Mode=TwoWay}"
									 TextChanged="SelectedYTextBox_TextChanged"/>

							<StackPanel IsVisible="{Binding IsGridSelected}" Spacing="6">
								<TextBlock Text="Колонки"/>
								<TextBox Text="{Binding SelectedControl.Columns, Mode=TwoWay}"
										 TextChanged="SelectedColumnsTextBox_TextChanged"/>

								<TextBlock Text="Строки"/>
								<TextBox Text="{Binding SelectedControl.Rows, Mode=TwoWay}"
										 TextChanged="SelectedRowsTextBox_TextChanged"/>

								<CheckBox Content="Показывать линии сетки"
										  IsChecked="{Binding SelectedControl.ShowGridLines, Mode=TwoWay}"
										  IsCheckedChanged="SelectedShowGridLinesCheckBox_Changed"/>
							</StackPanel>
						</StackPanel>
					</Border>

					<Border Grid.Row="1"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,8,0,0">
						<StackPanel Spacing="6">
							<TextBlock Text="Сгенерированный XAML"
                                       FontWeight="Bold"/>

							<ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          MinHeight="250">
								<TextBox Text="{Binding GeneratedXaml}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"/>
							</ScrollViewer>
						</StackPanel>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>