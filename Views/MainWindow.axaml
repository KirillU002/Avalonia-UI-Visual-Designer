<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FormDesigner.ViewModels"
        xmlns:models="using:FormDesigner.Models"
        xmlns:controls="using:FormDesigner.Controls"
        xmlns:commands="using:FormDesigner.EditorCommands"
        xmlns:contracts="clr-namespace:FormDesigner.PluginContracts;assembly=FormDesigner.PluginContracts"
        x:Class="FormDesigner.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        Width="1600"
        Height="920"
        MinWidth="1040"
        MinHeight="640"
        RequestedThemeVariant="Light"
        Title="Конструктор форм Avalonia · Alpha 0.2"
        Background="#EAF1F8"
        Classes.density-comfortable="{Binding IsComfortableUiDensity}"
        Classes.density-compact="{Binding IsCompactUiDensity}"
        Classes.density-dense="{Binding IsDenseUiDensity}"
        Focusable="True">
  <!-- Локальные стили этого окна.
       Здесь задается общий внешний вид вкладок, кнопок панели действий и кнопок выбора цвета. -->
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#D7E2EE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,5"/>
    </Style>

    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="BorderBrush" Value="#93C5FD"/>
    </Style>

    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#1D4ED8"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="TabControl.right-inspector-tabs TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="7,4"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#3B82F6"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,3"/>
    </Style>

    <Style Selector="ComboBox:pointerover">
      <Setter Property="BorderBrush" Value="#93C5FD"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#334155"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="Window.density-comfortable Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Window.density-dense Button">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Window.density-comfortable TextBox">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Window.density-dense TextBox">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Window.density-comfortable ComboBox">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Window.density-dense ComboBox">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Window.density-comfortable TabItem">
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Window.density-dense TabItem">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#DBEAFE"/>
      <Setter Property="BorderBrush" Value="#3B82F6"/>
    </Style>

    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Expander">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.property-star">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="MinWidth" Value="18"/>
      <Setter Property="MinHeight" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.property-star:pointerover">
      <Setter Property="Background" Value="#FEF3C7"/>
      <Setter Property="Foreground" Value="#B45309"/>
    </Style>

    <Style Selector="Button.property-action">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="BorderBrush" Value="#BFDBFE"/>
      <Setter Property="Foreground" Value="#1D4ED8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.property-action:pointerover">
      <Setter Property="Background" Value="#DBEAFE"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="TextBox.property-editor">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="ComboBox.property-editor">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.property-header-action">
      <Setter Property="MinHeight" Value="23"/>
      <Setter Property="MinWidth" Value="23"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.property-header-action:pointerover">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="ToggleButton.property-category-header">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="0,1,0,1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleButton.property-category-header:pointerover">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="BorderBrush" Value="#BFDBFE"/>
    </Style>

    <Style Selector="ToggleButton.property-category-header:checked">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
    </Style>

    <Style Selector="Border.property-grid-table">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1,0,1,1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="Border.property-row">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="3,1"/>
    </Style>

    <Style Selector="Button.header-action">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#BFDBFE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.header-action:pointerover">
      <Setter Property="Background" Value="#DBEAFE"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="Button.header-action:disabled">
      <Setter Property="Background" Value="#CBD5E1"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#94A3B8"/>
      <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style Selector="Button.toolbar-button">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#172554"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#315083"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="Button.toolbar-button:pointerover">
      <Setter Property="Background" Value="#1D4ED8"/>
      <Setter Property="BorderBrush" Value="#93C5FD"/>
    </Style>

    <Style Selector="Button.toolbar-button:pressed">
      <Setter Property="Background" Value="#1D4ED8"/>
    </Style>

    <Style Selector="Button.toolbar-button:disabled">
      <Setter Property="Background" Value="#16233F"/>
      <Setter Property="Foreground" Value="#8CA7D4"/>
      <Setter Property="BorderBrush" Value="#22314E"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.data-action-button">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Background" Value="#EAF2FF"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#9DB7DA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.data-action-button:pointerover">
      <Setter Property="Background" Value="#DBEAFE"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="Button.data-action-button:pressed">
      <Setter Property="Background" Value="#BFDBFE"/>
      <Setter Property="BorderBrush" Value="#3B82F6"/>
    </Style>

    <Style Selector="Button.data-action-button:disabled">
      <Setter Property="Background" Value="#E2E8F0"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.dock-collapse">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinWidth" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#EAF2FF"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#B8CBE4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.dock-collapse:pointerover">
      <Setter Property="Background" Value="#DBEAFE"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="Button.dock-rail">
      <Setter Property="Background" Value="#EAF2FF"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#B8CBE4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.dock-rail:pointerover">
      <Setter Property="Background" Value="#DBEAFE"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="Border.dock-splitter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Border.dock-splitter:pointerover">
      <Setter Property="Background" Value="#D7E2EE"/>
    </Style>

    <Style Selector="Button.problem-filter">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.problem-filter:pointerover">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="Button.color-picker-button">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#BFDBFE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style Selector="Button.color-picker-button:pointerover">
      <Setter Property="Background" Value="#DBEAFE"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="Button.color-picker-button:pressed">
      <Setter Property="Background" Value="#BFDBFE"/>
    </Style>

    <Style Selector="Button.export-primary">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Background" Value="#1D4ED8"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.export-primary:pointerover">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="Button.export-primary:pressed">
      <Setter Property="Background" Value="#1E40AF"/>
      <Setter Property="BorderBrush" Value="#1D4ED8"/>
    </Style>

    <Style Selector="Button.export-primary:disabled">
      <Setter Property="Background" Value="#CBD5E1"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.export-secondary">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#BFDBFE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.export-secondary:pointerover">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="BorderBrush" Value="#60A5FA"/>
    </Style>

    <Style Selector="Button.export-secondary:pressed">
      <Setter Property="Background" Value="#DBEAFE"/>
      <Setter Property="BorderBrush" Value="#3B82F6"/>
    </Style>

    <Style Selector="Button.export-secondary:disabled">
      <Setter Property="Background" Value="#E2E8F0"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Border.export-card">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#DCE6F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8"/>
    </Style>

    <Style Selector="Border.export-badge">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="BorderBrush" Value="#BFDBFE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>

    <Style Selector="Border.code-viewer">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="MinHeight" Value="160"/>
    </Style>

    <Style Selector="TextBlock.code-viewer-text">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LineHeight" Value="17"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True"/>
    </Style>
  </Window.Styles>

  <!-- Каркас всего окна: верхняя шапка конструктора и основная рабочая область. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Compact IDE command bar. Detailed document state lives in the status bar. -->
    <Border Grid.Row="0"
            Background="#0F172A"
            Padding="6,4"
            BorderBrush="#1E293B"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding IsDesignerShellHeaderVisible}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,8,Auto,Auto,8,Auto,Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock Text="Avalonia Designer"
                   Foreground="White"
                   FontSize="13"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

        <Button Grid.Column="1"
                Content="{Binding NewEditorCommand.Title}"
                Classes="toolbar-button"
                Command="{Binding NewEditorCommand}"
                ToolTip.Tip="{Binding NewEditorCommand.Hint}"/>
        <Button Grid.Column="2"
                Content="{Binding OpenEditorCommand.Title}"
                Classes="toolbar-button"
                Command="{Binding OpenEditorCommand}"
                ToolTip.Tip="{Binding OpenEditorCommand.Hint}"/>
        <Button Grid.Column="3"
                Content="{Binding SaveEditorCommand.Title}"
                Classes="toolbar-button"
                Command="{Binding SaveEditorCommand}"
                ToolTip.Tip="{Binding SaveEditorCommand.Hint}"/>

        <Button Grid.Column="5"
                Content="{Binding UndoEditorCommand.Title}"
                Classes="toolbar-button"
                Command="{Binding UndoEditorCommand}"
                ToolTip.Tip="{Binding UndoEditorCommand.Hint}"/>
        <Button Grid.Column="6"
                Content="{Binding RedoEditorCommand.Title}"
                Classes="toolbar-button"
                Command="{Binding RedoEditorCommand}"
                ToolTip.Tip="{Binding RedoEditorCommand.Hint}"/>

        <Button Grid.Column="8"
                Content="{Binding PreviewEditorCommand.Title}"
                Classes="toolbar-button"
                Command="{Binding PreviewEditorCommand}"
                ToolTip.Tip="{Binding PreviewEditorCommand.Hint}"/>
        <Button Grid.Column="9"
                Content="{Binding OpenExportPipelineEditorCommand.Title}"
                Classes="toolbar-button"
                Command="{Binding OpenExportPipelineEditorCommand}"
                ToolTip.Tip="{Binding OpenExportPipelineEditorCommand.Hint}"/>
        <Button Grid.Column="10"
                Content="{Binding HelpEditorCommand.Title}"
                Classes="toolbar-button"
                Command="{Binding HelpEditorCommand}"
                ToolTip.Tip="Открыть подробную справку по конструктору форм (F1)"/>

        <TextBlock Grid.Column="11"
                   Text="{Binding WorkspaceModeDescription}"
                   Foreground="#94A3B8"
                   FontSize="11"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Margin="8,0"/>

        <Border Grid.Column="12"
                Background="#0B7A42"
                CornerRadius="999"
                Padding="6,2"
                VerticalAlignment="Center"
                IsVisible="{Binding HasUnsavedChanges}">
          <TextBlock Text="{Binding Texts.UnsavedChanges}"
                     Foreground="White"
                     FontSize="10"
                     FontWeight="SemiBold"/>
        </Border>

        <Border Grid.Column="13"
                Background="#172554"
                BorderBrush="#2563EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6,2"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"
                      Spacing="4"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding Texts.Mode}"
                       Foreground="#BFDBFE"
                       FontWeight="SemiBold"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding AvailableWorkspaceModes}"
                      SelectedItem="{Binding WorkspaceMode, Mode=TwoWay}"
                      MinWidth="126"
                      Background="#EFF6FF"
                      Foreground="#0F172A"/>
          </StackPanel>
        </Border>

        <Button Grid.Column="14"
                Content="{Binding Texts.More}"
                Classes="toolbar-button">
          <Button.Flyout>
            <Flyout>
              <Border Padding="10"
                      MaxWidth="440">
                <StackPanel Spacing="8">
                  <Button Content="{Binding SaveAsEditorCommand.Title}"
                          Classes="data-action-button"
                          Command="{Binding SaveAsEditorCommand}"
                          HorizontalAlignment="Stretch"/>
                  <Button Content="{Binding Texts.RestoreBackup}"
                          Classes="data-action-button"
                          Click="RestoreBackupButton_Click"
                          HorizontalAlignment="Stretch"/>
                  <Button Content="{Binding ResetInteractionStateEditorCommand.Title}"
                          Classes="data-action-button"
                          Command="{Binding ResetInteractionStateEditorCommand}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Diagnostic reset for stuck PropertyGrid/Canvas interaction state."/>
                  <Button Content="{Binding Texts.OpenInteractionTrace}"
                          Classes="data-action-button"
                          Command="{Binding OpenInteractionTracePanelCommand}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Показать последние события фокуса, selection, PropertyGrid и canvas."/>

                  <Border Height="1"
                          Background="#E2E8F0"
                          Margin="0,2"/>

                  <TextBlock Text="{Binding RecentFilesSummary}"
                             FontWeight="Bold"
                             FontSize="12"/>
                  <ItemsControl ItemsSource="{Binding RecentFiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:RecentFileModel">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Margin="0,0,0,4">
                          <Button Tag="{Binding}"
                                  Click="OpenRecentFileButton_Click"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="7,4">
                            <StackPanel Spacing="0">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         FontSize="12"/>
                              <TextBlock Text="{Binding PathText}"
                                         FontSize="10"
                                         Foreground="#64748B"
                                         TextTrimming="CharacterEllipsis"
                                         MaxLines="1"/>
                            </StackPanel>
                          </Button>
                          <Button Grid.Column="1"
                                  Content="{Binding PinText}"
                                  Tag="{Binding}"
                                  Click="ToggleRecentPinButton_Click"
                                  MinWidth="44"
                                  Padding="6,3"/>
                          <Button Grid.Column="2"
                                  Content="×"
                                  Tag="{Binding}"
                                  Click="RemoveRecentFileButton_Click"
                                  MinWidth="28"
                                  Padding="6,3"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Height="1"
                          Background="#E2E8F0"
                          Margin="0,2"/>

                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Density"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableUiDensityModes}"
                              SelectedItem="{Binding UiDensityMode, Mode=TwoWay}"
                              MinWidth="140"
                              ToolTip.Tip="UI density: Comfortable, Compact or Dense"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Основная зона конструктора:
         слева тулбокс/структура, по центру форма, справа свойства/данные/код. -->
    <Grid Grid.Row="1"
          Margin="6"
          RowDefinitions="*,Auto">
      <Grid Grid.Row="0"
            ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
      <Button Grid.Column="0"
              Width="28"
              MinHeight="64"
              Classes="dock-rail"
              Command="{Binding ToggleLeftPanelEditorCommand}"
              IsVisible="{Binding IsLeftDockRailVisible}"
              ToolTip.Tip="Показать левую панель">
        <TextBlock Text="☰"
                   FontSize="13"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
      </Button>
      <!-- Левая панель навигации по документу. -->
      <Border x:Name="LeftDockPanel"
              Grid.Column="1"
              Width="{Binding LeftDockPanelWidth, Mode=TwoWay}"
              MinWidth="220"
              MaxWidth="420"
              Background="#F8FBFF"
              BorderBrush="#D3DFEC"
              BorderThickness="1"
              CornerRadius="8"
              Padding="0"
              ClipToBounds="True"
              IsVisible="{Binding IsLeftRailVisible}">
        <Grid RowDefinitions="Auto,*">
          <Border Background="#EEF4FB"
                  BorderBrush="#D7E2EE"
                  BorderThickness="0,0,0,1"
                  Padding="8,5">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding LeftDockHeaderTitle}"
                           FontWeight="Bold"
                           FontSize="14"/>
                <TextBlock Text="Компоненты · Templates · Структура"
                           Foreground="#64748B"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="‹"
                      Classes="dock-collapse"
                      Command="{Binding ToggleLeftPanelEditorCommand}"
                      ToolTip.Tip="Скрыть левую панель"/>
            </Grid>
          </Border>

        <!-- Вкладки слева отвечают за выбор элемента из тулбокса
             и просмотр текущей структуры формы. -->
        <TabControl Grid.Row="1"
                    Margin="8,0,8,8"
                    TabStripPlacement="Top"
                    SelectedIndex="{Binding LeftRailSelectedIndex, Mode=OneWay}">
          <TabItem Header="{Binding Texts.Explorer}"
                   IsVisible="{Binding IsDesignMode}">
            <Grid RowDefinitions="Auto,*"
                  Margin="0,6,0,0">
              <Grid RowDefinitions="Auto,Auto">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding CurrentProjectDisplayName}"
                             FontSize="14"
                             FontWeight="Bold"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding ProjectExplorerCompactSummary}"
                             Foreground="#64748B"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding ProjectExplorerScopeHint}"/>
                </StackPanel>
                <WrapPanel Grid.Row="1">
                <Button Content="{Binding Texts.AddForm}"
                        Command="{Binding NewFormEditorCommand}"
                        Classes="data-action-button"
                        Margin="0,0,6,0"
                        Padding="8,5"
                        MinHeight="26"/>
                <Button Content="{Binding Texts.AddAsset}"
                        Command="{Binding AddAssetEditorCommand}"
                        Classes="data-action-button"
                        Padding="8,5"
                        MinHeight="26"/>
                </WrapPanel>
              </Grid>

              <Border Grid.Row="1"
                      Margin="0,6,0,0"
                      Background="#F8FAFC"
                      BorderBrush="#D7E2EE"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="2"
                      ClipToBounds="True">
                <TreeView ItemsSource="{Binding ProjectExplorerItems}"
                          SelectedItem="{Binding SelectedProjectExplorerItem, Mode=TwoWay}"
                          KeyDown="ProjectExplorerTree_KeyDown">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem"
                           x:DataType="models:ProjectExplorerItemModel">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                      <Setter Property="MinHeight" Value="26"/>
                      <Setter Property="Padding" Value="0"/>
                    </Style>
                    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                      <Setter Property="Background" Value="Transparent"/>
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="models:ProjectExplorerItemModel"
                                      ItemsSource="{Binding Children}">
                      <Border Background="{Binding RowBackground}"
                              CornerRadius="4"
                              Padding="4,2"
                              Margin="0"
                              DoubleTapped="ProjectExplorerItem_DoubleTapped">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              MinHeight="26">
                          <Border Width="18"
                                  Height="18"
                                  CornerRadius="4"
                                  Background="#DBEAFE"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Icon}"
                                       Foreground="#1D4ED8"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                          </Border>
                          <StackPanel Grid.Column="1"
                                      Spacing="0">
                            <TextBlock Text="{Binding DisplayText}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       IsVisible="{Binding IsDisplayNameVisible}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                     IsVisible="{Binding IsRenameEditorVisible}"
                                     MinHeight="26"
                                     Padding="6,3"
                                     FontSize="12"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2"
                                      Orientation="Horizontal"
                                      Spacing="4">
                            <Button Content="{Binding #RootWindow.DataContext.Texts.Done}"
                                    Command="{Binding #RootWindow.DataContext.CommitProjectExplorerRenameCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="data-action-button"
                                    Padding="7,3"
                                    MinHeight="24"
                                    IsVisible="{Binding IsRenameEditorVisible}"/>
                          </StackPanel>
                        </Grid>
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{Binding #RootWindow.DataContext.Texts.Open}"
                                      Command="{Binding #RootWindow.DataContext.OpenProjectExplorerItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanOpenForm}"/>
                            <MenuItem Header="{Binding #RootWindow.DataContext.Texts.Preview}"
                                      Command="{Binding #RootWindow.DataContext.PreviewProjectAssetCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanPreviewAsset}"/>
                            <MenuItem Header="{Binding #RootWindow.DataContext.Texts.Rename}"
                                      Command="{Binding #RootWindow.DataContext.BeginRenameProjectExplorerItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanRename}"/>
                            <MenuItem Header="{Binding #RootWindow.DataContext.Texts.DuplicateForm}"
                                      Command="{Binding #RootWindow.DataContext.DuplicateProjectExplorerItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanDuplicate}"/>
                            <MenuItem Header="{Binding #RootWindow.DataContext.Texts.Delete}"
                                      Command="{Binding #RootWindow.DataContext.DeleteProjectExplorerItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanDelete}"/>
                            <MenuItem Header="{Binding #RootWindow.DataContext.Texts.ExportPipeline}"
                                      Command="{Binding #RootWindow.DataContext.OpenProjectExplorerItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanOpenExportPipeline}"/>
                            <MenuItem Header="{Binding #RootWindow.DataContext.Texts.ValidateBuild}"
                                      Command="{Binding #RootWindow.DataContext.ValidateExportBuildEditorCommand}"
                                      IsVisible="{Binding CanOpenExportPipeline}"/>
                            <MenuItem Header="{Binding #RootWindow.DataContext.Texts.ExportToProject}"
                                      Command="{Binding #RootWindow.DataContext.ExportToProjectEditorCommand}"
                                      IsVisible="{Binding CanOpenExportPipeline}"/>
                            <Separator/>
                            <MenuItem Header="Новая Form"
                                      Command="{Binding #RootWindow.DataContext.NewFormEditorCommand}"
                                      IsVisible="{Binding CanAddForm}"/>
                            <MenuItem Header="{Binding #RootWindow.DataContext.Texts.AddAsset}"
                                      Command="{Binding #RootWindow.DataContext.AddAssetEditorCommand}"
                                      IsVisible="{Binding CanAddAsset}"/>
                            <MenuItem Header="Настройки проекта"
                                      Command="{Binding #RootWindow.DataContext.OpenProjectSettingsEditorCommand}"
                                      IsVisible="{Binding CanOpenProjectSettings}"/>
                            <MenuItem Header="Очистить artifacts"
                                      Command="{Binding #RootWindow.DataContext.CleanArtifactsEditorCommand}"
                                      IsVisible="{Binding CanOpenProjectSettings}"/>
                          </ContextMenu>
                        </Border.ContextMenu>
                      </Border>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="Компоненты"
                   IsVisible="{Binding IsDesignMode}">
            <ScrollViewer Margin="0,6,0,0"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="6">
                <TextBlock Text="Доступные элементы"
                           FontSize="14"
                           FontWeight="Bold"/>
                <TextBlock Text="Нажмите на карточку и перетащите элемент на поверхность формы."
                           Foreground="#475569"
                           FontSize="11"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>

                <ItemsControl ItemsSource="{Binding ToolboxItems}">
                  <!-- Каждая карточка знает только тип контрола.
                       Полноценная модель создается уже в коде при drop на рабочую поверхность. -->
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ToolboxItem">
                      <Border Margin="0,0,0,3"
                              Padding="6,2"
                              Background="White"
                              BorderBrush="#D7E2EE"
                              BorderThickness="0,0,0,1"
                              CornerRadius="0"
                              PointerPressed="ToolboxItem_PointerPressed"
                              ToolTip.Tip="{Binding Description}">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              MinHeight="26">
                          <Border Width="18"
                                  Height="18"
                                  CornerRadius="4"
                                  Background="#DBEAFE"
                                  VerticalAlignment="Center">
                            <TextBlock Text="▣"
                                       Foreground="#1D4ED8"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Title}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Type}"
                                     Foreground="#64748B"
                                     FontSize="10"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Шаблоны"
                   IsVisible="{Binding IsDesignMode}">
            <Grid RowDefinitions="Auto,*"
                  Margin="0,12,0,0">
              <Border Background="White"
                      BorderBrush="#D7E2EE"
                      BorderThickness="1"
                      CornerRadius="14"
                      Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Шаблоны интерфейса"
                             FontSize="18"
                             FontWeight="Bold"/>
                  <TextBlock Text="{Binding ReusableTemplatesSummary}"
                             Foreground="#475569"
                             TextWrapping="Wrap"/>
                  <Button Content="Сохранить выделение как шаблон"
                          Command="{Binding SaveSelectionAsTemplateCommand}"
                          IsEnabled="{Binding CanSaveSelectionAsTemplate}"
                          HorizontalAlignment="Stretch"
                          Padding="12,9"/>
                  <TextBlock Text="Шаблон сохраняет элементы, вложенность, свойства, BindingSource и custom properties плагинов."
                             Foreground="#64748B"
                             FontSize="12"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1"
                            Margin="0,12,0,0"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ReusableTemplates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ReusableTemplateModel">
                      <Border Margin="0,0,0,10"
                              Padding="12"
                              Background="White"
                              BorderBrush="#D7E2EE"
                              BorderThickness="1"
                              CornerRadius="14">
                        <StackPanel Spacing="9">
                          <DockPanel LastChildFill="True">
                            <Border Background="#DBEAFE"
                                    CornerRadius="999"
                                    Padding="8,2"
                                    HorizontalAlignment="Left">
                              <TextBlock Text="{Binding Category}"
                                         Foreground="#1D4ED8"
                                         FontSize="11"
                                         FontWeight="SemiBold"/>
                            </Border>

                            <Border Background="#F1F5F9"
                                    CornerRadius="999"
                                    Padding="8,2"
                                    HorizontalAlignment="Right">
                              <TextBlock Text="{Binding OriginText}"
                                         Foreground="#475569"
                                         FontSize="11"
                                         FontWeight="SemiBold"/>
                            </Border>
                          </DockPanel>

                          <TextBlock Text="{Binding Name}"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding IsBuiltIn}"/>
                          <TextBox Text="{Binding Name, Mode=TwoWay}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   IsVisible="{Binding CanEdit}"/>

                          <TextBlock Text="{Binding Description}"
                                     Foreground="#475569"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Summary}"
                                     Foreground="#64748B"
                                     FontSize="12"/>

                          <Button Content="Вставить на форму"
                                  Command="{Binding #RootWindow.DataContext.InsertTemplateCommand}"
                                  CommandParameter="{Binding}"
                                  Padding="12,9"
                                  HorizontalAlignment="Stretch"/>

                          <Grid ColumnDefinitions="*,*"
                                IsVisible="{Binding CanEdit}">
                            <Button Grid.Column="0"
                                    Content="Сохранить имя"
                                    Command="{Binding #RootWindow.DataContext.RenameTemplateCommand}"
                                    CommandParameter="{Binding}"
                                    MinHeight="34"/>
                            <Button Grid.Column="1"
                                    Content="Удалить"
                                    Command="{Binding #RootWindow.DataContext.DeleteTemplateCommand}"
                                    CommandParameter="{Binding}"
                                    MinHeight="34"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="Структура"
                   IsVisible="{Binding IsDesignMode}">
            <Grid RowDefinitions="Auto,Auto,*"
                  Margin="0,12,0,0">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Структура формы"
                               FontSize="16"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding StructureTreeSummary}"
                               Foreground="#64748B"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="↺"
                          Command="{Binding RefreshDiagnosticsCommand}"
                          Classes="dock-collapse"
                          ToolTip.Tip="Обновить структуру и диагностику"/>
                </Grid>
              </StackPanel>

              <TextBox Grid.Row="1"
                       Margin="0,10,0,8"
                       Watermark="Поиск по имени или типу..."
                       Text="{Binding StructureSearchText, Mode=TwoWay}"
                       MinHeight="34"/>

              <Border Grid.Row="2"
                      Background="#F8FAFC"
                      BorderBrush="#D7E2EE"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="6"
                      ClipToBounds="True">
                <Grid>
                <TreeView ItemsSource="{Binding StructureTreeItems}"
                          SelectedItem="{Binding SelectedStructureItem, Mode=TwoWay}">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem"
                           x:DataType="models:StructureTreeItemModel">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                      <Setter Property="MinHeight" Value="30"/>
                      <Setter Property="Padding" Value="0"/>
                    </Style>
                  </TreeView.Styles>
                  <TreeView.DataTemplates>
                    <TreeDataTemplate x:DataType="models:StructureTreeItemModel"
                                      ItemsSource="{Binding Children}">
                      <Border Margin="0,1"
                              Padding="4,3"
                              Background="{Binding RowBackground}"
                              BorderBrush="{Binding RowBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="7"
                              Opacity="{Binding ItemOpacity}">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Select"
                                      Command="{Binding #RootWindow.DataContext.SelectStructureTreeItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanActOnControl}"/>
                            <MenuItem Header="Rename"
                                      Command="{Binding #RootWindow.DataContext.RenameStructureTreeItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanActOnControl}"/>
                            <MenuItem Header="Duplicate"
                                      Command="{Binding #RootWindow.DataContext.DuplicateStructureTreeItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanActOnControl}"/>
                            <MenuItem Header="Delete"
                                      Command="{Binding #RootWindow.DataContext.DeleteStructureTreeItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanActOnControl}"/>
                            <Separator/>
                            <MenuItem Header="{Binding LockActionText}"
                                      Command="{Binding #RootWindow.DataContext.ToggleStructureTreeLockCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanActOnControl}"/>
                            <MenuItem Header="{Binding VisibilityActionText}"
                                      Command="{Binding #RootWindow.DataContext.ToggleStructureTreeVisibilityCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanActOnControl}"/>
                            <Separator/>
                            <MenuItem Header="Bring to Front"
                                      Command="{Binding #RootWindow.DataContext.BringStructureTreeItemToFrontCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanActOnControl}"/>
                            <MenuItem Header="Send to Back"
                                      Command="{Binding #RootWindow.DataContext.SendStructureTreeItemToBackCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanActOnControl}"/>
                            <MenuItem Header="Group selected"
                                      Command="{Binding #RootWindow.DataContext.GroupStructureTreeSelectionCommand}"/>
                            <MenuItem Header="Ungroup"
                                      Command="{Binding #RootWindow.DataContext.UngroupStructureTreeItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding CanActOnControl}"/>
                            <Separator/>
                            <MenuItem Header="Expand children"
                                      Command="{Binding #RootWindow.DataContext.ExpandStructureTreeItemCommand}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="Collapse children"
                                      Command="{Binding #RootWindow.DataContext.CollapseStructureTreeItemCommand}"
                                      CommandParameter="{Binding}"/>
                          </ContextMenu>
                        </Border.ContextMenu>

                          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                            <Border Width="24"
                                    Height="22"
                                    Background="{Binding TypeBadgeBackground}"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding TypeBadgeText}"
                                         Foreground="{Binding TypeBadgeForeground}"
                                         FontSize="10"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Column="1"
                                  ColumnDefinitions="*,Auto"
                                  MinWidth="0"
                                  VerticalAlignment="Center">
                              <TextBox Text="{Binding Name, Mode=TwoWay}"
                                       IsEnabled="{Binding CanRename}"
                                       Foreground="{Binding NameForeground}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Padding="0"
                                       MinHeight="24"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding CompactTypeText}"
                                         Foreground="#64748B"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"
                                         MaxWidth="84"/>
                            </Grid>

                            <Border Grid.Column="2"
                                    MinWidth="18"
                                    Height="18"
                                    CornerRadius="999"
                                    Background="{Binding DiagnosticBadgeBackground}"
                                    IsVisible="{Binding HasDiagnostics}">
                              <TextBlock Text="{Binding DiagnosticBadgeText}"
                                         Foreground="White"
                                         FontSize="10"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <Button Grid.Column="3"
                                    Content="{Binding VisibilityGlyph}"
                                    Classes="dock-collapse"
                                    Width="24"
                                    Height="24"
                                    MinWidth="24"
                                    MinHeight="24"
                                    FontSize="10"
                                    Command="{Binding #RootWindow.DataContext.ToggleStructureTreeVisibilityCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding CanActOnControl}"
                                    ToolTip.Tip="{Binding VisibilityActionText}"/>
                            <Button Grid.Column="4"
                                    Content="{Binding LockGlyph}"
                                    Classes="dock-collapse"
                                    Width="24"
                                    Height="24"
                                    MinWidth="24"
                                    MinHeight="24"
                                    FontSize="10"
                                    Command="{Binding #RootWindow.DataContext.ToggleStructureTreeLockCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding CanActOnControl}"
                                    ToolTip.Tip="{Binding LockActionText}"/>
                          </Grid>
                      </Border>
                    </TreeDataTemplate>
                  </TreeView.DataTemplates>
                </TreeView>

                <Border Background="#FFFFFF"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsStructureTreeEmptyStateVisible}">
                  <TextBlock Text="{Binding StructureTreeEmptyText}"
                             Foreground="#64748B"
                             FontSize="11"
                             TextWrapping="Wrap"
                             TextAlignment="Center"/>
                </Border>
                </Grid>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="История"
                   IsVisible="{Binding IsHistoryMode}">
            <Grid RowDefinitions="Auto,*"
                  Margin="0,12,0,0">
              <Border Background="White"
                      BorderBrush="#D7E2EE"
                      BorderThickness="1"
                      CornerRadius="14"
                      Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="История действий"
                             FontSize="18"
                             FontWeight="Bold"/>
                  <TextBlock Text="{Binding UndoRedoHistorySummary}"
                             Foreground="#475569"
                             TextWrapping="Wrap"/>
                  <TextBlock Text="Нажмите на шаг, чтобы перейти к выбранному состоянию. Новое изменение после отката обрежет redo-ветку."
                             Foreground="#64748B"
                             FontSize="12"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1"
                            Margin="0,12,0,0"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding UndoRedoHistoryItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:UndoRedoHistoryItemModel">
                      <Button Margin="0,0,0,8"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding #RootWindow.DataContext.RestoreHistoryStateCommand}"
                              CommandParameter="{Binding}">
                        <Border Padding="12"
                                Background="White"
                                BorderBrush="#D7E2EE"
                                BorderThickness="1"
                                CornerRadius="14">
                          <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34"
                                    Height="34"
                                    Background="#DBEAFE"
                                    CornerRadius="999"
                                    VerticalAlignment="Top">
                              <TextBlock Text="{Binding PositionText}"
                                         Foreground="#1D4ED8"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Spacing="6">
                              <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Right">
                                  <Border Background="#DCFCE7"
                                          CornerRadius="999"
                                          Padding="8,2"
                                          IsVisible="{Binding IsCurrent}">
                                    <TextBlock Text="Текущее"
                                               Foreground="#166534"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                  </Border>
                                  <Border Background="#F1F5F9"
                                          CornerRadius="999"
                                          Padding="8,2"
                                          IsVisible="{Binding IsPast}">
                                    <TextBlock Text="Отмена"
                                               Foreground="#475569"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                  </Border>
                                  <Border Background="#E0F2FE"
                                          CornerRadius="999"
                                          Padding="8,2"
                                          IsVisible="{Binding IsFuture}">
                                    <TextBlock Text="Повтор"
                                               Foreground="#0369A1"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                  </Border>
                                </StackPanel>
                              </DockPanel>

                              <TextBlock Text="{Binding Description}"
                                         Foreground="#475569"
                                         TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding StateText}"
                                         Foreground="#64748B"
                                         FontSize="12"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="DLL"
                   IsVisible="{Binding IsDataMode}">
            <ScrollViewer Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Texts.LoadedDlls}"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Text="Если DLL нужна как источник моделей и метаданных, импортируйте её через кнопку «Импорт DLL...» во вкладке «Данные» справа. Здесь показываются уже подключённые сборки."
                           Foreground="#475569"
                           TextWrapping="Wrap"/>

                <TextBox Watermark="{Binding Texts.DllSearchWatermark}"
                         Text="{Binding ImportedDllSearchText, Mode=TwoWay}"/>

                <Border Background="#F8FAFC"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">
                  <TextBlock Text="{Binding ImportedDllCatalogSummary}"
                             Foreground="#475569"
                             TextWrapping="Wrap"/>
                </Border>

                <ItemsControl ItemsSource="{Binding FilteredImportedDllCatalog}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ImportedDllInfoModel">
                      <Border Margin="0,0,0,8"
                              Padding="12"
                              Background="White"
                              BorderBrush="#D7E2EE"
                              BorderThickness="1"
                              CornerRadius="14">
                        <StackPanel Spacing="8">
                          <DockPanel LastChildFill="True">
                            <TextBlock Text="{Binding FileName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <Border Background="#DBEAFE"
                                    CornerRadius="999"
                                    Padding="8,2"
                                    HorizontalAlignment="Right">
                              <TextBlock Text="{Binding Summary}"
                                         Foreground="#1D4ED8"
                                         FontSize="11"
                                         FontWeight="SemiBold"/>
                            </Border>
                          </DockPanel>

                          <TextBlock Text="{Binding CountsSummary}"
                                     Foreground="#475569"
                                     FontSize="12"/>

                          <TextBlock Text="{Binding AssemblyPath}"
                                     Foreground="#64748B"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding AssemblyPath}"/>

                          <TextBlock Text="{Binding StatusSummary}"
                                     Foreground="#B45309"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasErrors}"/>

                          <WrapPanel Orientation="Horizontal">
                            <Button Content="{Binding #RootWindow.DataContext.Texts.Details}"
                                    Classes="data-action-button"
                                    Tag="{Binding}"
                                    Click="ShowImportedDllDetailsButton_Click"
                                    Margin="0,0,6,6"
                                    Padding="10,6"/>
                            <Button Content="{Binding #RootWindow.DataContext.Texts.CopyPath}"
                                    Classes="data-action-button"
                                    Tag="{Binding}"
                                    Click="CopyImportedDllPathButton_Click"
                                    Margin="0,0,6,6"
                                    Padding="10,6"/>
                            <Button Content="{Binding #RootWindow.DataContext.Texts.Reload}"
                                    Classes="data-action-button"
                                    Tag="{Binding}"
                                    Click="ReloadImportedDllButton_Click"
                                    Margin="0,0,6,6"
                                    Padding="10,6"/>
                            <Button Content="{Binding #RootWindow.DataContext.Texts.Remove}"
                                    Classes="data-action-button"
                                    Tag="{Binding}"
                                    Click="RemoveImportedDllButton_Click"
                                    Margin="0,0,6,6"
                                    Padding="10,6"/>
                          </WrapPanel>

                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding #RootWindow.DataContext.Texts.Sources}"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="{Binding SourceNames}"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"/>
                          </StackPanel>

                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding #RootWindow.DataContext.Texts.Types}"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="{Binding TypeNames}"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"/>
                          </StackPanel>

                          <Expander Header="{Binding #RootWindow.DataContext.Texts.Tables}"
                                    IsVisible="{Binding HasTables}">
                            <ItemsControl ItemsSource="{Binding Tables}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImportedDllTableInfoModel">
                                  <Border Margin="0,4,0,0"
                                          Padding="8"
                                          Background="#F8FAFC"
                                          BorderBrush="#E2E8F0"
                                          BorderThickness="1"
                                          CornerRadius="8">
                                    <StackPanel Spacing="4">
                                      <TextBlock Text="{Binding QualifiedDisplayName}"
                                                 FontWeight="SemiBold"
                                                 TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding QualifiedDisplayName}"/>
                                      <TextBlock Text="{Binding SourceKey}"
                                                 Foreground="#64748B"
                                                 FontSize="11"
                                                 TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding SourceKey}"/>
                                      <ItemsControl ItemsSource="{Binding Columns}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="models:ImportedDllColumnInfoModel">
                                            <TextBlock FontSize="11"
                                                       Foreground="#475569"
                                                       Text="{Binding DisplaySummary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding SearchText}"/>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Expander>

                          <Expander Header="{Binding #RootWindow.DataContext.Texts.ErrorsWarnings}"
                                    IsVisible="{Binding HasErrors}">
                            <ItemsControl ItemsSource="{Binding Errors}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ImportedDllErrorInfoModel">
                                  <Border Margin="0,4,0,0"
                                          Padding="8"
                                          Background="#FFF7ED"
                                          BorderBrush="#FED7AA"
                                          BorderThickness="1"
                                          CornerRadius="8">
                                    <StackPanel Spacing="3">
                                      <TextBlock Text="{Binding Title}"
                                                 FontWeight="SemiBold"
                                                 Foreground="#9A3412"/>
                                      <TextBlock Text="{Binding Message}"
                                                 Foreground="#7C2D12"
                                                 TextWrapping="Wrap"/>
                                      <TextBlock Text="{Binding Details}"
                                                 Foreground="#9A3412"
                                                 FontSize="11"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Expander>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Width="6"
              Classes="dock-splitter"
              CornerRadius="6"
              Cursor="SizeWestEast"
              IsVisible="{Binding IsLeftDockPanelVisible}"
              PointerPressed="LeftDockSplitter_PointerPressed"
              PointerMoved="LeftDockSplitter_PointerMoved"
              PointerReleased="DockSplitter_PointerReleased"
              PointerCaptureLost="DockSplitter_PointerCaptureLost">
        <Border Width="2"
                Background="#94A3B8"
                CornerRadius="999"
                HorizontalAlignment="Center"
                Margin="0,28"/>
      </Border>

      <!-- Центральная колонка — рабочая поверхность формы. -->
      <Border Grid.Column="3"
              Background="#F8FBFF"
              BorderBrush="#D3DFEC"
              BorderThickness="1"
              CornerRadius="8"
              Padding="6">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Background="#FFFFFF"
                  BorderBrush="#D7E2EE"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="3"
                  IsVisible="{Binding IsDesignerCanvasWorkspaceVisible}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding DocumentTabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DesignerDocumentTabModel">
                    <Border Margin="0,0,6,0"
                            Padding="6,3"
                            MinWidth="104"
                            Background="{Binding Background}"
                            BorderBrush="{Binding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Content="{Binding Title}"
                                Command="{Binding #RootWindow.DataContext.SwitchDocumentCommand}"
                                CommandParameter="{Binding}"
                                Classes="ghost-button"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                MinHeight="24"/>
                        <Button Grid.Column="1"
                                Content="×"
                                Command="{Binding #RootWindow.DataContext.CloseDocumentTabCommand}"
                                CommandParameter="{Binding}"
                                Classes="ghost-button"
                                Padding="6,0"
                                MinHeight="24"
                                ToolTip.Tip="Close document tab"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <!-- Верхняя панель над формой показывает текущий режим,
               размеры предпросмотра и переключатели режимов редактора. -->
          <Border Grid.Row="1"
                  Margin="0,5,0,0"
                  Background="#EFF6FF"
                  BorderBrush="#D7E2EE"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="6"
                  IsVisible="{Binding IsDesignerCanvasWorkspaceVisible}">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto">
              <StackPanel Spacing="1">
                <TextBlock Text="Поверхность формы"
                           FontSize="13"
                           FontWeight="Bold"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SelectedControlSummary}"
                           Foreground="#475569"
                           FontSize="11"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <Border Grid.Column="1"
                      Background="White"
                      BorderBrush="#D7E2EE"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="8,4">
                <StackPanel Orientation="Horizontal"
                            Spacing="7">
                  <TextBlock Text="{Binding FormTitle}"
                             FontSize="11"
                             Foreground="#64748B"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding FormWindowState}"
                             Foreground="#1D4ED8"
                             FontSize="11"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding PreviewFormWidth, StringFormat='{}{0:0} px'}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="×"
                             Foreground="#64748B"
                             FontSize="11"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding PreviewFormHeight, StringFormat='{}{0:0} px'}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Border>

              <WrapPanel Grid.Row="1"
                         Grid.ColumnSpan="2"
                         ItemHeight="30"
                         VerticalAlignment="Center">
                <Button Content="−"
                        Width="32"
                        Margin="0,0,5,0"
                        Classes="toolbar-button"
                        Click="ZoomOutButton_Click"
                        ToolTip.Tip="Уменьшить масштаб поверхности"/>

                <Button Content="100%"
                        MinWidth="58"
                        Margin="0,0,5,0"
                        Classes="toolbar-button"
                        Click="ResetZoomButton_Click"
                        ToolTip.Tip="Сбросить масштаб к 100%"/>

                <Button Content="+"
                        Width="32"
                        Margin="0,0,5,0"
                        Classes="toolbar-button"
                        Click="ZoomInButton_Click"
                        ToolTip.Tip="Увеличить масштаб поверхности"/>

                <ComboBox x:Name="ZoomPresetComboBox"
                          Width="92"
                          Margin="0,0,0,0"
                          SelectionChanged="ZoomPresetComboBox_SelectionChanged"
                          ToolTip.Tip="Выбрать масштаб поверхности">
                  <ComboBoxItem Content="25%"/>
                  <ComboBoxItem Content="50%"/>
                  <ComboBoxItem Content="75%"/>
                  <ComboBoxItem Content="100%"/>
                  <ComboBoxItem Content="150%"/>
                  <ComboBoxItem Content="200%"/>
                </ComboBox>
              <Button
                      Content="{Binding UserPreviewModeButtonText}"
                      Classes="toolbar-button"
                      Command="{Binding ToggleDesignFramesEditorCommand}"
                      ToolTip.Tip="{Binding ToggleDesignFramesEditorCommand.Hint}"
                      VerticalAlignment="Center"
                      Margin="8,0,5,0"
                      Padding="8,4"/>

              <Button
                      Content="{Binding ImmersiveModeButtonText}"
                      Classes="toolbar-button"
                      Command="{Binding ToggleImmersiveDesignerModeCommand}"
                      VerticalAlignment="Center"
                      Padding="8,4"/>
              </WrapPanel>

            </Grid>
          </Border>

          <Border Grid.Row="2"
                  Margin="0,6,0,0"
                  Background="#E4EDF7"
                  BorderBrush="#CBD8E8"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8"
                  IsVisible="{Binding IsDesignerCanvasWorkspaceVisible}">
            <Grid>
              <ScrollViewer x:Name="DesignerViewportScrollViewer"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                <!-- Внутри DesignSurfaceHost лежат все визуальные слои конструктора.
                     Они разнесены по отдельным Canvas, чтобы независимо рисовать:
                     рамку окна, сетку, направляющие, редактируемые контролы и ручку ресайза формы. -->
                <Canvas x:Name="DesignViewportRoot"
                        Background="Transparent">
                  <Canvas x:Name="DesignSurfaceHost"
                          Background="Transparent"
                          RenderTransformOrigin="0,0">
                    <!-- Декоративная имитация системной шапки окна. -->
                    <Border x:Name="DesignSurfaceTitleBar"
                            Width="{Binding PreviewFormWidth}"
                            Height="36"
                            Background="#E2E8F0"
                            BorderBrush="#0F172A"
                            BorderThickness="1,1,1,0"
                            CornerRadius="10,10,0,0">
                      <Grid ColumnDefinitions="*,Auto,Auto"
                            Margin="12,0">
                        <TextBlock Text="{Binding FormTitle}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <Border Grid.Column="1"
                                Background="#DBEAFE"
                                CornerRadius="999"
                                Padding="10,4"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding FormWindowState}"
                                     Foreground="#1D4ED8"
                                     FontSize="12"
                                     FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <Border Width="10" Height="10" Background="#F87171" CornerRadius="999"/>
                          <Border Width="10" Height="10" Background="#FBBF24" CornerRadius="999"/>
                          <Border Width="10" Height="10" Background="#34D399" CornerRadius="999"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- Видимая рабочая область формы. -->
                    <Border x:Name="DesignSurfaceBorder"
                            Width="{Binding PreviewFormWidth}"
                            Height="{Binding PreviewFormHeight}"
                            Background="{Binding SurfaceBackground}"
                            BorderBrush="#0F172A"
                            BorderThickness="1"
                            CornerRadius="0,0,10,10"
                            Canvas.Top="36"/>

                    <!-- Слой сетки для визуальной привязки элементов. -->
                    <Canvas x:Name="GridOverlayCanvas"
                            Width="{Binding PreviewFormWidth}"
                            Height="{Binding PreviewFormHeight}"
                            Canvas.Top="36"
                            IsHitTestVisible="False"/>

                    <!-- Слой направляющих, marquee-выделения и подсветки контейнеров. -->
                    <Canvas x:Name="GuideOverlayCanvas"
                            Width="{Binding PreviewFormWidth}"
                            Height="{Binding PreviewFormHeight}"
                            Canvas.Top="36"
                            IsHitTestVisible="False"/>

                    <!-- Основной слой с контролами формы.
                         Именно сюда попадают drag-and-drop, клики, перемещение и ресайз. -->
                    <Canvas x:Name="DesignerCanvas"
                            Width="{Binding PreviewFormWidth}"
                            Height="{Binding PreviewFormHeight}"
                            Background="Transparent"
                            Canvas.Top="36"
                            PointerPressed="DesignerCanvas_PointerPressed"
                            PointerMoved="DesignerCanvas_PointerMoved"
                            PointerReleased="DesignerCanvas_PointerReleased"
                            DragDrop.AllowDrop="True"/>

                    <Canvas x:Name="SelectionOverlayCanvas"
                            Width="{Binding PreviewFormWidth}"
                            Height="{Binding PreviewFormHeight}"
                            Canvas.Top="36"
                            IsHitTestVisible="True"/>

                    <!-- Ручка изменения размера самой формы в режиме обычного окна. -->
                    <Border x:Name="DesignResizeHandle"
                            Width="20"
                            Height="20"
                            Background="#1D4ED8"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="6"
                            IsVisible="{Binding CanResizeDesignSurface}"
                            PointerPressed="DesignResizeHandle_PointerPressed"
                            PointerMoved="DesignResizeHandle_PointerMoved"
                            PointerReleased="DesignResizeHandle_PointerReleased"/>
                  </Canvas>
                </Canvas>
              </ScrollViewer>

              <Border Background="#F8FBFFEE"
                      BorderBrush="#93C5FD"
                      BorderThickness="1"
                      CornerRadius="16"
                      Padding="10,8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,12,0,0"
                      IsVisible="False">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <Button Content="Дублировать"
                          Classes="data-action-button"
                          Command="{Binding DuplicateEditorCommand}"
                          ToolTip.Tip="{Binding DuplicateEditorCommand.Hint}"
                          IsEnabled="{Binding CanDuplicateSelected}"
                          Padding="10,7"/>
                  <Button Content="Удалить"
                          Classes="data-action-button"
                          Command="{Binding DeleteEditorCommand}"
                          ToolTip.Tip="{Binding DeleteEditorCommand.Hint}"
                          IsEnabled="{Binding HasSelectedControl}"
                          Padding="10,7"/>
                  <Button Content="Копировать"
                          Classes="data-action-button"
                          Command="{Binding CopyEditorCommand}"
                          ToolTip.Tip="{Binding CopyEditorCommand.Hint}"
                          IsEnabled="{Binding CanCopySelection}"
                          Padding="10,7"/>
                  <Button Content="Вставить"
                          Classes="data-action-button"
                          Command="{Binding PasteEditorCommand}"
                          ToolTip.Tip="{Binding PasteEditorCommand.Hint}"
                          IsEnabled="{Binding CanPasteSelection}"
                          Padding="10,7"/>
                  <Button Content="Заблокировать"
                          Classes="data-action-button"
                          Command="{Binding LockEditorCommand}"
                          ToolTip.Tip="{Binding LockEditorCommand.Hint}"
                          IsEnabled="{Binding CanLockSelected}"
                          Padding="10,7"/>
                  <Button Content="Разблокировать"
                          Classes="data-action-button"
                          Command="{Binding UnlockEditorCommand}"
                          ToolTip.Tip="{Binding UnlockEditorCommand.Hint}"
                          IsEnabled="{Binding CanUnlockSelected}"
                          Padding="10,7"/>
                  <Button Content="Группа"
                          Classes="data-action-button"
                          Command="{Binding GroupEditorCommand}"
                          ToolTip.Tip="{Binding GroupEditorCommand.Hint}"
                          IsEnabled="{Binding CanGroupSelection}"
                          Padding="10,7"/>
                  <Button Content="Разгруппировать"
                          Classes="data-action-button"
                          Command="{Binding UngroupEditorCommand}"
                          ToolTip.Tip="{Binding UngroupEditorCommand.Hint}"
                          IsEnabled="{Binding CanUngroupSelection}"
                          Padding="10,7"/>
                  <Button Content="Вперёд"
                          Classes="data-action-button"
                          Command="{Binding BringToFrontEditorCommand}"
                          ToolTip.Tip="{Binding BringToFrontEditorCommand.Hint}"
                          IsEnabled="{Binding CanChangeZOrder}"
                          Padding="10,7"/>
                  <Button Content="Назад"
                          Classes="data-action-button"
                          Command="{Binding SendToBackEditorCommand}"
                          ToolTip.Tip="{Binding SendToBackEditorCommand.Hint}"
                          IsEnabled="{Binding CanChangeZOrder}"
                          Padding="10,7"/>
                </StackPanel>
              </Border>

              <Border Background="#F8FBFFEE"
                      BorderBrush="#93C5FD"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="8,6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,12,0,0"
                      IsVisible="{Binding IsLayoutOverlayVisible}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                  <StackPanel Spacing="0"
                              MinWidth="150">
                    <TextBlock Text="{Binding ActiveLayoutOverlayTitle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ActiveLayoutOverlaySummary}"
                               FontSize="10"
                               Foreground="#475569"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <Button Content="+ Row"
                          Classes="data-action-button"
                          Command="{Binding AddGridRowDefinitionCommand}"
                          IsVisible="{Binding IsActiveLayoutGrid}"
                          Padding="8,4"/>
                  <Button Content="+ Column"
                          Classes="data-action-button"
                          Command="{Binding AddGridColumnDefinitionCommand}"
                          IsVisible="{Binding IsActiveLayoutGrid}"
                          Padding="8,4"/>
                  <Button Content="Edit rows/columns"
                          Classes="data-action-button"
                          Command="{Binding SetActiveLayoutToGridCommand}"
                          IsVisible="{Binding IsActiveLayoutGrid}"
                          Padding="8,4"
                          ToolTip.Tip="Open the Layout inspector tab to edit Grid definitions"/>
                  <Button Content="Grid overlay"
                          Classes="data-action-button"
                          Command="{Binding ToggleActiveGridOverlayCommand}"
                          IsVisible="{Binding IsActiveLayoutGrid}"
                          Padding="8,4"/>

                  <ComboBox ItemsSource="{Binding AvailableLayoutOrientations}"
                            SelectedItem="{Binding ActiveStackOrientation, Mode=TwoWay}"
                            IsVisible="{Binding IsActiveLayoutStack}"
                            Width="104"/>
                  <TextBox Classes="property-editor"
                           Text="{Binding ActiveStackSpacing, Mode=TwoWay}"
                           IsVisible="{Binding IsActiveLayoutStack}"
                           Width="52"
                           ToolTip.Tip="StackPanel spacing"/>
                  <Button Content="Reverse"
                          Classes="data-action-button"
                          Command="{Binding MoveSelectedStackChildDownCommand}"
                          IsVisible="{Binding IsActiveLayoutStack}"
                          Padding="8,4"
                          ToolTip.Tip="Move selected child down in StackPanel order"/>

                  <Button Content="Canvas"
                          Classes="data-action-button"
                          Command="{Binding SetActiveLayoutToCanvasCommand}"
                          Padding="8,4"/>
                  <Button Content="Stack"
                          Classes="data-action-button"
                          Command="{Binding SetActiveLayoutToStackCommand}"
                          Padding="8,4"/>
                  <Button Content="Grid"
                          Classes="data-action-button"
                          Command="{Binding SetActiveLayoutToGridCommand}"
                          Padding="8,4"/>
                </StackPanel>
              </Border>

              <Border x:Name="MiniMapHost"
                      Width="250"
                      Padding="12"
                      Background="#F8FBFFEE"
                      BorderBrush="#93A9C8"
                      BorderThickness="1"
                      CornerRadius="16"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,12,12"
                      IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,*">
                  <TextBlock Text="Навигация"
                             FontWeight="Bold"
                             FontSize="14"
                             Foreground="#0F172A"/>
                  <TextBlock x:Name="MiniMapStatusTextBlock"
                             Grid.Row="1"
                             Foreground="#475569"
                             Text="100%"/>
                  <Canvas x:Name="MiniMapCanvas"
                          Grid.Row="2"
                          Width="220"
                          Height="140"
                          Background="Transparent"
                          PointerPressed="MiniMapCanvas_PointerPressed"
                          PointerMoved="MiniMapCanvas_PointerMoved"
                          PointerReleased="MiniMapCanvas_PointerReleased"/>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.RowSpan="3"
                RowDefinitions="Auto,*"
                IsVisible="{Binding IsExportPipelineWorkspaceVisible}">
            <Border Background="#FFFFFF"
                    BorderBrush="#D7E2EE"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Texts.ExportPipeline}"
                             FontSize="22"
                             FontWeight="Bold"/>
                  <TextBlock Text="{Binding ExportPipelineSummary}"
                             Foreground="#475569"
                             TextTrimming="CharacterEllipsis"/>
                  <WrapPanel>
                    <Border Classes="export-badge">
                      <TextBlock Text="{Binding ExportDataGridBadgeText}"
                                 Foreground="#1D4ED8"
                                 FontSize="12"
                                 FontWeight="SemiBold"/>
                    </Border>
                    <Border Classes="export-badge">
                      <TextBlock Text="{Binding ExportLayoutBadgeText}"
                                 Foreground="#1D4ED8"
                                 FontSize="12"
                                 FontWeight="SemiBold"/>
                    </Border>
                    <Border Classes="export-badge">
                      <TextBlock Text="{Binding ExportCacheStatusText}"
                                 Foreground="{Binding ExportCacheStatusForeground}"
                                 FontSize="12"
                                 FontWeight="SemiBold"/>
                    </Border>
                    <Border Classes="export-badge">
                      <TextBlock Text="{Binding ExportValidationStatusText}"
                                 Foreground="{Binding ExportValidationStatusForeground}"
                                 FontSize="12"
                                 FontWeight="SemiBold"/>
                    </Border>
                  </WrapPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Center">
                  <Button Content="{Binding Texts.Refresh}"
                          Classes="export-secondary"
                          Command="{Binding RefreshGeneratedCodeEditorCommand}"
                          ToolTip.Tip="{Binding RefreshGeneratedCodeEditorCommand.Hint}"
                          Margin="0,0,8,8"/>
                  <Button Content="{Binding Texts.ValidateBuild}"
                          Classes="export-secondary"
                          Command="{Binding ValidateExportBuildEditorCommand}"
                          ToolTip.Tip="{Binding ValidateExportBuildEditorCommand.Hint}"
                          Margin="0,0,8,8"/>
                  <Button Content="{Binding Texts.ExportToProject}"
                          Classes="export-primary"
                          Command="{Binding ExportToProjectEditorCommand}"
                          ToolTip.Tip="{Binding ExportToProjectEditorCommand.Hint}"
                          Margin="0,0,8,8"/>
                  <Button Content="{Binding Texts.ExportZip}"
                          Classes="export-secondary"
                          Command="{Binding ExportAsZipEditorCommand}"
                          ToolTip.Tip="{Binding ExportAsZipEditorCommand.Hint}"
                          Margin="0,0,8,8"/>
                </WrapPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1"
                  ColumnDefinitions="270,*,320">
              <Border Background="#FFFFFF"
                      BorderBrush="#D7E2EE"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="12">
                <Grid RowDefinitions="Auto,*">
                  <TextBlock Text="{Binding Texts.GeneratedFiles}"
                             FontSize="14"
                             FontWeight="Bold"/>
                  <TreeView Grid.Row="1"
                            ItemsSource="{Binding GeneratedFileTreeNodes}"
                            SelectedItem="{Binding SelectedGeneratedFileNode, Mode=TwoWay}"
                            BorderThickness="0"
                            Background="Transparent">
                    <TreeView.Styles>
                      <Style Selector="TreeViewItem"
                             x:DataType="models:GeneratedFileTreeNodeModel">
                        <Setter Property="MinHeight" Value="30"/>
                        <Setter Property="Padding" Value="0"/>
                      </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                      <TreeDataTemplate x:DataType="models:GeneratedFileTreeNodeModel"
                                        ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Margin="0,3">
                          <Border Width="22"
                                  Height="22"
                                  CornerRadius="6"
                                  Background="#E0F2FE"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Icon}"
                                       Foreground="#0369A1"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1"
                                      Spacing="0">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Summary}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding StatusText}"
                                     Foreground="{Binding SeverityForeground}"
                                     FontSize="10"
                                     FontWeight="Bold"
                                     VerticalAlignment="Center"/>
                        </Grid>
                      </TreeDataTemplate>
                    </TreeView.DataTemplates>
                  </TreeView>
                </Grid>
              </Border>

              <Grid Grid.Column="1"
                    RowDefinitions="Auto,*">
                <Border Background="#FFFFFF"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding SelectedGeneratedFile.Path}"
                                 FontWeight="Bold"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding SelectedGeneratedFileSummary}"
                                 Foreground="#64748B"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding Texts.CopyFile}"
                            Classes="export-secondary"
                            Command="{Binding CopyCurrentGeneratedFileEditorCommand}"
                            ToolTip.Tip="{Binding CopyCurrentGeneratedFileEditorCommand.Hint}"
                            VerticalAlignment="Center"/>
                  </Grid>
                </Border>

                <Border Grid.Row="1"
                        Classes="code-viewer"
                        MinHeight="420">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding SelectedGeneratedFileContent}"
                               Classes="code-viewer-text"/>
                  </ScrollViewer>
                </Border>
              </Grid>

              <ScrollViewer Grid.Column="2"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                  <Border Background="#FFFFFF"
                          BorderBrush="#D7E2EE"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Texts.BuildValidation}"
                                 FontSize="14"
                                 FontWeight="Bold"/>
                      <Border Background="#F8FAFC"
                              BorderBrush="#D7E2EE"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="9">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding ExportValidationStatusText}"
                                     Foreground="{Binding ExportValidationStatusForeground}"
                                     FontWeight="Bold"/>
                          <TextBlock Text="{Binding ExportValidationProjectPath}"
                                     Foreground="#64748B"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding CurrentExportBuildValidation.StepSummary}"
                                     Foreground="#334155"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasExportValidationProjectPath}"/>
                          <TextBlock Text="{Binding CurrentExportBuildValidation.DetailedLogPath}"
                                     Foreground="#64748B"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasExportValidationProjectPath}"/>
                          <WrapPanel Margin="0,4,0,0">
                            <Button Content="{Binding Texts.OpenValidationFolder}"
                                    Classes="export-secondary"
                                    Command="{Binding OpenValidationFolderEditorCommand}"
                                    ToolTip.Tip="{Binding OpenValidationFolderEditorCommand.Hint}"
                                    Margin="0,0,6,6"/>
                            <Button Content="Copy logs"
                                    Classes="export-secondary"
                                    Click="CopyBuildLogsButton_Click"
                                    Margin="0,0,6,6"/>
                            <Button Content="Open logs folder"
                                    Classes="export-secondary"
                                    Click="OpenBuildLogsFolderButton_Click"
                                    Margin="0,0,6,6"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <Button Content="{Binding Texts.OpenFullOutput}"
                              Classes="export-secondary"
                              Command="{Binding OpenFullOutputPanelCommand}"
                              HorizontalAlignment="Left"/>
                    </StackPanel>
                  </Border>

                  <Border Background="#FFFFFF"
                          BorderBrush="#D7E2EE"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Texts.RequiredPackages}"
                                 FontSize="14"
                                 FontWeight="Bold"/>
                      <Border Background="#F0FDF4"
                              BorderBrush="#BBF7D0"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="9"
                              IsVisible="{Binding HasNoRequiredPackages}">
                        <TextBlock Text="{Binding Texts.NoAdditionalPackagesRequired}"
                                   Foreground="#166534"
                                   FontWeight="SemiBold"/>
                      </Border>
                      <ItemsControl ItemsSource="{Binding RequiredPackages}"
                                    IsVisible="{Binding HasRequiredPackages}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:RequiredPackageModel">
                            <Border Background="#FFFBEB"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="9"
                                    Margin="0,0,0,6">
                              <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Summary}"
                                           FontWeight="Bold"
                                           Foreground="#92400E"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Reason}"
                                           Foreground="#78350F"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding InstallCommand}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#0F172A"
                                           TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Background="#FFFFFF"
                          BorderBrush="#D7E2EE"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Texts.ExportDiagnostics}"
                                 FontSize="14"
                                 FontWeight="Bold"/>
                      <Border Background="#F0FDF4"
                              BorderBrush="#BBF7D0"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="9"
                              IsVisible="{Binding HasNoExportPipelineDiagnostics}">
                        <TextBlock Text="{Binding Texts.NoExportWarningsOrErrors}"
                                   Foreground="#166534"
                                   FontWeight="SemiBold"/>
                      </Border>
                      <ItemsControl ItemsSource="{Binding ExportDiagnostics}"
                                    IsVisible="{Binding HasExportPipelineDiagnostics}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:ExportDiagnosticModel">
                            <Border Background="#FFF7ED"
                                    BorderBrush="#FDBA74"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="9"
                                    Margin="0,0,0,6">
                              <StackPanel Spacing="3">
                                <DockPanel LastChildFill="True">
                                  <TextBlock Text="{Binding SeverityText}"
                                             Foreground="{Binding SeverityForeground}"
                                             FontSize="11"
                                             FontWeight="Bold"
                                             Margin="0,0,8,0"/>
                                  <TextBlock Text="{Binding Source}"
                                             Foreground="#64748B"
                                             FontSize="11"
                                             HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Message}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Details}"
                                           IsVisible="{Binding HasDetails}"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <!-- Правая панель редактирования:
           свойства формы и выбранного контрола, источники данных и результаты генерации. -->
      <Border Grid.Column="4"
              Width="6"
              Classes="dock-splitter"
              CornerRadius="6"
              Cursor="SizeWestEast"
              IsVisible="{Binding IsRightDockPanelVisible}"
              PointerPressed="RightDockSplitter_PointerPressed"
              PointerMoved="RightDockSplitter_PointerMoved"
              PointerReleased="DockSplitter_PointerReleased"
              PointerCaptureLost="DockSplitter_PointerCaptureLost">
        <Border Width="2"
                Background="#94A3B8"
                CornerRadius="999"
                HorizontalAlignment="Center"
                Margin="0,28"/>
      </Border>

      <Border x:Name="RightDockPanel"
              Grid.Column="5"
              Width="{Binding RightDockPanelWidth, Mode=TwoWay}"
              MinWidth="260"
              MaxWidth="560"
              Background="#F8FBFF"
              BorderBrush="#D3DFEC"
              BorderThickness="1"
              CornerRadius="8"
              Padding="0"
              ClipToBounds="True"
              IsVisible="{Binding IsRightInspectorVisible}">
        <Grid RowDefinitions="Auto,*">
          <Border Background="#EEF4FB"
                  BorderBrush="#D7E2EE"
                  BorderThickness="0,0,0,1"
                  Padding="8,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
              <StackPanel Spacing="1"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding RightInspectorHeaderTitle}"
                           FontWeight="Bold"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding RightInspectorHeaderSubtitle}"
                           Foreground="#64748B"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="{Binding Texts.ResetView}"
                      Classes="property-header-action"
                      Command="{Binding ResetPropertyGridViewCommand}"
                      ToolTip.Tip="Сбросить вид свойств для выбранного control type"/>
              <Button Grid.Column="2"
                      Content="{Binding Texts.Basic}"
                      Classes="property-header-action"
                      Command="{Binding ExpandBasicPropertyGridCategoriesCommand}"
                      ToolTip.Tip="Развернуть основные группы свойств"/>
              <Button Grid.Column="3"
                      Content="{Binding Texts.Collapse}"
                      Classes="property-header-action"
                      Command="{Binding CollapseAllPropertyGridCategoriesCommand}"
                      ToolTip.Tip="Свернуть группы свойств"/>
              <Button Grid.Column="4"
                      Content=">"
                      Classes="dock-collapse"
                      Command="{Binding ToggleRightPanelEditorCommand}"
                      ToolTip.Tip="Скрыть правую панель"/>
            </Grid>
          </Border>

        <TabControl Grid.Row="1"
                    Classes="right-inspector-tabs"
                    Margin="6,0,6,6"
                    TabStripPlacement="Top"
                    SelectedIndex="{Binding RightInspectorSelectedIndex, Mode=TwoWay}">
          <!-- Главная вкладка настройки:
               сверху свойства формы, ниже режимы дизайнера и затем свойства выделенного контрола. -->
          <TabItem Header="{Binding Texts.Properties}">
            <Grid RowDefinitions="Auto,*"
                  Margin="0,6,0,0">
              <Border Background="White"
                      BorderBrush="#D7E2EE"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="6"
                      IsVisible="False">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding PropertyGridSelectionTitle}"
                             FontSize="14"
                             FontWeight="Bold"
                             Foreground="#0F172A"/>
                  <TextBlock Text="{Binding SelectedControlSummary}"
                             FontSize="12"
                             Foreground="#64748B"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>

              <Grid Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    IsVisible="False">
                <TextBox Classes="property-editor"
                         Watermark="{Binding Texts.SearchProperties}"
                         Text="{Binding PropertyGridSearchText, Mode=TwoWay}"/>
                <Button Grid.Column="1"
                        Classes="property-header-action"
                        Content="X"
                        Command="{Binding ClearPropertyGridSearchCommand}"/>
              </Grid>

              <ScrollViewer x:Name="SimpleInspectorScrollViewer"
                            Grid.Row="1"
                            IsVisible="False"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8"
                            Margin="0,6,0,0">
                  <Border Background="#EFF6FF"
                          BorderBrush="#BFDBFE"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Simple Inspector"
                                 FontWeight="SemiBold"
                                 Foreground="#1D4ED8"/>
                      <TextBlock Text="Diagnostic mode: direct controls, no PropertyGrid templates."
                                 FontSize="11"
                                 Foreground="#475569"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>

                  <Border Background="#FFFFFF"
                          BorderBrush="#D7E2EE"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="10"
                          IsVisible="{Binding HasNoSelectedControl}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Control не выбран"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="Выберите control на Canvas, чтобы редактировать Name, Text, размер и цвета."
                                 FontSize="12"
                                 Foreground="#64748B"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="8"
                              IsVisible="{Binding HasSelectedControl}">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Name"
                                 FontSize="11"
                                 Foreground="#64748B"/>
                      <TextBox x:Name="SimpleInspectorNameTextBox"
                               Classes="property-editor"
                               Tag="Name"
                               PointerPressed="SimpleInspectorTextBox_PointerPressed"
                               GotFocus="SimpleInspectorTextBox_GotFocus"
                               KeyDown="SimpleInspectorTextBox_KeyDown"
                               LostFocus="SimpleInspectorTextBox_LostFocus"/>
                    </StackPanel>

                    <StackPanel Spacing="3">
                      <TextBlock Text="Text / Content"
                                 FontSize="11"
                                 Foreground="#64748B"/>
                      <TextBox x:Name="SimpleInspectorTextTextBox"
                               Classes="property-editor"
                               Tag="Text"
                               PointerPressed="SimpleInspectorTextBox_PointerPressed"
                               GotFocus="SimpleInspectorTextBox_GotFocus"
                               KeyDown="SimpleInspectorTextBox_KeyDown"
                               LostFocus="SimpleInspectorTextBox_LostFocus"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="3">
                        <TextBlock Text="X / Canvas.Left"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorXTextBox"
                                 Classes="property-editor"
                                 Tag="X"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Spacing="3">
                        <TextBlock Text="Y / Canvas.Top"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorYTextBox"
                                 Classes="property-editor"
                                 Tag="Y"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Width"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorWidthTextBox"
                                 Classes="property-editor"
                                 Tag="Width"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Spacing="3">
                        <TextBlock Text="Height"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorHeightTextBox"
                                 Classes="property-editor"
                                 Tag="Height"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox x:Name="SimpleInspectorIsVisibleCheckBox"
                                Content="IsVisible"
                                Tag="IsVisible"
                                Click="SimpleInspectorCheckBox_Click"/>
                      <CheckBox Grid.Column="1"
                                x:Name="SimpleInspectorIsLockedCheckBox"
                                Margin="8,0,0,0"
                                Content="IsLocked"
                                Tag="IsLocked"
                                Click="SimpleInspectorCheckBox_Click"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Background"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorBackgroundTextBox"
                                 Classes="property-editor"
                                 Tag="Background"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Margin="8,0,0,0"
                              Content="..."
                              Tag="Background"
                              Classes="property-header-action"
                              Click="SimpleInspectorColorButton_Click"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Foreground"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorForegroundTextBox"
                                 Classes="property-editor"
                                 Tag="Foreground"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Margin="8,0,0,0"
                              Content="..."
                              Tag="Foreground"
                              Classes="property-header-action"
                              Click="SimpleInspectorColorButton_Click"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="BorderBrush"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorBorderBrushTextBox"
                                 Classes="property-editor"
                                 Tag="BorderBrush"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Margin="8,0,0,0"
                              Content="..."
                              Tag="BorderBrush"
                              Classes="property-header-action"
                              Click="SimpleInspectorColorButton_Click"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="3">
                        <TextBlock Text="BorderThickness"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorBorderThicknessTextBox"
                                 Classes="property-editor"
                                 Tag="BorderThickness"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Spacing="3">
                        <TextBlock Text="CornerRadius"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorCornerRadiusTextBox"
                                 Classes="property-editor"
                                 Tag="CornerRadius"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Opacity"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorOpacityTextBox"
                                 Classes="property-editor"
                                 Tag="Opacity"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Spacing="3">
                        <TextBlock Text="FontSize"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorFontSizeTextBox"
                                 Classes="property-editor"
                                 Tag="FontSize"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="3">
                      <TextBlock Text="FontWeight"
                                 FontSize="11"
                                 Foreground="#64748B"/>
                      <TextBox x:Name="SimpleInspectorFontWeightTextBox"
                               Classes="property-editor"
                               Tag="FontWeight"
                               PointerPressed="SimpleInspectorTextBox_PointerPressed"
                               GotFocus="SimpleInspectorTextBox_GotFocus"
                               KeyDown="SimpleInspectorTextBox_KeyDown"
                               LostFocus="SimpleInspectorTextBox_LostFocus"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="3">
                        <TextBlock Text="HorizontalAlignment"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorHorizontalAlignmentTextBox"
                                 Classes="property-editor"
                                 Tag="HorizontalAlignment"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Spacing="3">
                        <TextBlock Text="VerticalAlignment"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorVerticalAlignmentTextBox"
                                 Classes="property-editor"
                                 Tag="VerticalAlignment"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Margin"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorMarginTextBox"
                                 Classes="property-editor"
                                 Tag="Margin"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Spacing="3">
                        <TextBlock Text="Padding"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBox x:Name="SimpleInspectorPaddingTextBox"
                                 Classes="property-editor"
                                 Tag="Padding"
                                 PointerPressed="SimpleInspectorTextBox_PointerPressed"
                                 GotFocus="SimpleInspectorTextBox_GotFocus"
                                 KeyDown="SimpleInspectorTextBox_KeyDown"
                                 LostFocus="SimpleInspectorTextBox_LostFocus"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">
                  <Border Background="#F8FAFC"
                          BorderBrush="#D7E2EE"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="10"
                          IsVisible="{Binding HasNoPropertyGridRows}">
                    <TextBlock Text="{Binding PropertyGridEmptyText}"
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>
                  </Border>

                  <Border Background="#FFFFFF"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="8"
                          IsVisible="{Binding IsActiveLayoutGrid}">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Spacing="1">
                          <TextBlock Text="Grid definitions"
                                     FontWeight="Bold"
                                     FontSize="13"/>
                          <TextBlock Text="{Binding ActiveGridDefinitionsPreview}"
                                     Foreground="#64748B"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="+ Row"
                                Classes="data-action-button"
                                Command="{Binding AddGridRowDefinitionCommand}"
                                Padding="7,3"/>
                        <Button Grid.Column="2"
                                Content="+ Column"
                                Classes="data-action-button"
                                Command="{Binding AddGridColumnDefinitionCommand}"
                                Padding="7,3"/>
                      </Grid>

                      <StackPanel Spacing="4">
                        <TextBlock Text="Rows"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding LayoutGridRows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LayoutDefinitionEditorItem">
                              <Border BorderBrush="#E5E7EB"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,2">
                                <Grid ColumnDefinitions="28,86,58,*,Auto,Auto,Auto">
                                  <TextBlock Text="{Binding Index}"
                                             VerticalAlignment="Center"
                                             Foreground="#64748B"/>
                                  <ComboBox Grid.Column="1"
                                            Classes="property-editor"
                                            ItemsSource="{Binding #RootWindow.DataContext.AvailableLayoutDefinitionSizeKinds}"
                                            SelectedItem="{Binding SizeKind, Mode=TwoWay}"/>
                                  <TextBox Grid.Column="2"
                                           Classes="property-editor"
                                           Text="{Binding Value, Mode=TwoWay}"/>
                                  <TextBlock Grid.Column="3"
                                             Text="{Binding Preview}"
                                             VerticalAlignment="Center"
                                             Foreground="#1D4ED8"
                                             FontWeight="SemiBold"/>
                                  <Button Grid.Column="4"
                                          Content="↑"
                                          Classes="property-action"
                                          Command="{Binding #RootWindow.DataContext.MoveLayoutGridRowUpCommand}"
                                          CommandParameter="{Binding}"
                                          Padding="5,1"/>
                                  <Button Grid.Column="5"
                                          Content="↓"
                                          Classes="property-action"
                                          Command="{Binding #RootWindow.DataContext.MoveLayoutGridRowDownCommand}"
                                          CommandParameter="{Binding}"
                                          Padding="5,1"/>
                                  <Button Grid.Column="6"
                                          Content="×"
                                          Classes="property-action"
                                          Command="{Binding #RootWindow.DataContext.DeleteLayoutGridRowCommand}"
                                          CommandParameter="{Binding}"
                                          Padding="5,1"/>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Text="Columns"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding LayoutGridColumns}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LayoutDefinitionEditorItem">
                              <Border BorderBrush="#E5E7EB"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,2">
                                <Grid ColumnDefinitions="28,86,58,*,Auto,Auto,Auto">
                                  <TextBlock Text="{Binding Index}"
                                             VerticalAlignment="Center"
                                             Foreground="#64748B"/>
                                  <ComboBox Grid.Column="1"
                                            Classes="property-editor"
                                            ItemsSource="{Binding #RootWindow.DataContext.AvailableLayoutDefinitionSizeKinds}"
                                            SelectedItem="{Binding SizeKind, Mode=TwoWay}"/>
                                  <TextBox Grid.Column="2"
                                           Classes="property-editor"
                                           Text="{Binding Value, Mode=TwoWay}"/>
                                  <TextBlock Grid.Column="3"
                                             Text="{Binding Preview}"
                                             VerticalAlignment="Center"
                                             Foreground="#1D4ED8"
                                             FontWeight="SemiBold"/>
                                  <Button Grid.Column="4"
                                          Content="←"
                                          Classes="property-action"
                                          Command="{Binding #RootWindow.DataContext.MoveLayoutGridColumnUpCommand}"
                                          CommandParameter="{Binding}"
                                          Padding="5,1"/>
                                  <Button Grid.Column="5"
                                          Content="→"
                                          Classes="property-action"
                                          Command="{Binding #RootWindow.DataContext.MoveLayoutGridColumnDownCommand}"
                                          CommandParameter="{Binding}"
                                          Padding="5,1"/>
                                  <Button Grid.Column="6"
                                          Content="×"
                                          Classes="property-action"
                                          Command="{Binding #RootWindow.DataContext.DeleteLayoutGridColumnCommand}"
                                          CommandParameter="{Binding}"
                                          Padding="5,1"/>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Background="#FFFFFF"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="8"
                          IsVisible="{Binding IsActiveLayoutStack}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Работа со StackPanel"
                                 FontWeight="Bold"
                                 FontSize="13"/>
                      <Grid ColumnDefinitions="*,*">
                        <StackPanel Spacing="3">
                          <TextBlock Text="Orientation"
                                     FontSize="11"
                                     Foreground="#64748B"/>
                          <ComboBox Classes="property-editor"
                                    ItemsSource="{Binding AvailableLayoutOrientations}"
                                    SelectedItem="{Binding ActiveStackOrientation, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Spacing="3">
                          <TextBlock Text="Spacing"
                                     FontSize="11"
                                     Foreground="#64748B"/>
                          <TextBox Classes="property-editor"
                                   Text="{Binding ActiveStackSpacing, Mode=TwoWay}"/>
                        </StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal"
                                  Spacing="6">
                        <Button Content="Выше"
                                Classes="data-action-button"
                                Command="{Binding MoveSelectedStackChildUpCommand}"
                                IsEnabled="{Binding IsSelectedControlManagedByLayout}"
                                Padding="8,4"/>
                        <Button Content="Ниже"
                                Classes="data-action-button"
                                Command="{Binding MoveSelectedStackChildDownCommand}"
                                IsEnabled="{Binding IsSelectedControlManagedByLayout}"
                                Padding="8,4"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border x:Name="PropertyGridTableHost"
                          Classes="property-grid-table"
                          IsVisible="{Binding HasPropertyGridRows}">
                    <ItemsControl x:Name="PropertyGridCategoriesItemsControl"
                                  ItemsSource="{Binding PropertyGridCategories}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PropertyGridCategoryViewModel">
                        <StackPanel>
                          <ToggleButton Classes="property-category-header"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                            <Grid ColumnDefinitions="14,*">
                              <TextBlock Text="{Binding ExpandGlyph}"
                                         FontSize="10"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding HeaderText}"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"
                                         IsHitTestVisible="False"/>
                            </Grid>
                          </ToggleButton>

                          <ItemsControl ItemsSource="{Binding Rows}"
                                        IsVisible="{Binding IsExpanded}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PropertyGridRowViewModel">
                                  <Border Classes="property-row"
                                          ToolTip.Tip="{Binding Description}">
                                    <Grid ColumnDefinitions="18,112,*,Auto,Auto"
                                          MinHeight="28">
                                      <Button Classes="property-star"
                                              Content="{Binding FavoriteGlyph}"
                                              Command="{Binding #RootWindow.DataContext.TogglePropertyGridFavoriteCommand}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="Добавить или убрать из избранного"/>

                                      <TextBlock Grid.Column="1"
                                                 FontSize="12"
                                                 Foreground="#334155"
                                                 VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding Description}">
                                        <TextBlock.Text>
                                          <MultiBinding StringFormat="{}{0}{1}">
                                            <Binding Path="ModifiedGlyph"/>
                                            <Binding Path="Label"/>
                                          </MultiBinding>
                                        </TextBlock.Text>
                                      </TextBlock>

                                      <Border Grid.Column="2"
                                              BorderBrush="#E5E7EB"
                                              BorderThickness="1,0,0,0"
                                              Padding="6,1,0,1">
                                        <Grid MinWidth="116">
                                        <controls:PropertyGridTextEditor Classes="property-editor"
                                                                         Row="{Binding}"
                                                                         MinWidth="80"
                                                                         HorizontalAlignment="Stretch"
                                                                         VerticalAlignment="Center"
                                                                         IsVisible="{Binding IsTextEditor}"/>

                                        <controls:PropertyGridTextEditor Classes="property-editor"
                                                                         Row="{Binding}"
                                                                         MinWidth="80"
                                                                         HorizontalAlignment="Stretch"
                                                                         VerticalAlignment="Center"
                                                                         IsVisible="{Binding IsNumberEditor}"/>

                                        <CheckBox IsVisible="{Binding IsBoolEditor}"
                                                  IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>

                                        <Grid IsVisible="{Binding IsEnumEditor}"
                                              ColumnDefinitions="*,Auto">
                                          <TextBlock Text="{Binding Value}"
                                                     Foreground="#334155"
                                                     FontSize="12"
                                                     VerticalAlignment="Center"
                                                     TextTrimming="CharacterEllipsis"
                                                     IsHitTestVisible="False"/>
                                          <Button Grid.Column="1"
                                                  Classes="property-action"
                                                  Content="..."
                                                  Click="PropertyGridOptionButton_Click"
                                                  ToolTip.Tip="Выбрать значение"/>
                                        </Grid>

                                        <Grid IsVisible="{Binding IsBindingSourceEditor}"
                                              ColumnDefinitions="*,Auto">
                                          <TextBlock Text="{Binding Value}"
                                                     Foreground="#334155"
                                                     FontSize="12"
                                                     VerticalAlignment="Center"
                                                     TextTrimming="CharacterEllipsis"
                                                     IsHitTestVisible="False"/>
                                          <Button Grid.Column="1"
                                                  Classes="property-action"
                                                  Content="..."
                                                  Click="PropertyGridOptionButton_Click"
                                                  ToolTip.Tip="Выбрать BindingSource"/>
                                        </Grid>

                                        <Grid IsVisible="{Binding IsColorEditor}"
                                              ColumnDefinitions="Auto,*,Auto">
                                          <Border Width="14"
                                                  Height="14"
                                                  Margin="0,0,6,0"
                                                  Background="{Binding Value}"
                                                  BorderBrush="#94A3B8"
                                                  BorderThickness="1"
                                                  CornerRadius="3"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"/>
                                          <TextBlock Grid.Column="1"
                                                     Text="{Binding Value}"
                                                     Foreground="#334155"
                                                     FontSize="12"
                                                     VerticalAlignment="Center"
                                                     TextTrimming="CharacterEllipsis"
                                                     IsHitTestVisible="False"/>
                                          <Button Grid.Column="2"
                                                  Classes="property-action"
                                                  Content="..."
                                                  Click="PropertyGridColorButton_Click"
                                                  ToolTip.Tip="Выбрать цвет"/>
                                        </Grid>

                                        <Button Classes="property-action"
                                                Content="{Binding ActionText}"
                                                IsVisible="{Binding IsActionEditor}"
                                                HorizontalAlignment="Stretch"
                                                Click="PropertyGridActionButton_Click"/>

                                        <TextBlock Text="{Binding Value}"
                                                   IsVisible="{Binding IsReadOnlyEditor}"
                                                   Foreground="#475569"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsHitTestVisible="False"/>
                                        </Grid>
                                      </Border>

                                      <Button Grid.Column="3"
                                              Classes="property-action"
                                              Content="↺"
                                              IsVisible="{Binding CanResetToDefault}"
                                              Click="PropertyGridResetButton_Click"
                                              ToolTip.Tip="{Binding DefaultTooltip}"/>

                                      <TextBlock Grid.Column="4"
                                                 Text="!"
                                                 FontWeight="Bold"
                                                 Foreground="#DC2626"
                                                 IsVisible="{Binding HasValidationError}"
                                                 ToolTip.Tip="{Binding ValidationMessage}"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"/>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer Grid.RowSpan="3"
                          IsVisible="False"
                          Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <!-- Параметры самой формы: заголовок, размеры, режим окна, фон и системные флаги. -->
                <Border Background="White"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Окно формы"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <StackPanel Spacing="4">
                      <TextBlock Text="Заголовок"
                                 FontWeight="SemiBold"/>
                      <TextBox Text="{Binding FormTitle, Mode=TwoWay}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Ширина"
                                   FontWeight="SemiBold"/>
                        <TextBox Tag="DesignWidth"
                                 Text="{Binding DesignWidth, Mode=TwoWay}"
                                 IsEnabled="{Binding IsFormSizeEditable}"
                                 TextChanged="SurfaceNumericTextBox_TextChanged"/>
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4">
                        <TextBlock Text="Высота"
                                   FontWeight="SemiBold"/>
                        <TextBox Tag="DesignHeight"
                                 Text="{Binding DesignHeight, Mode=TwoWay}"
                                 IsEnabled="{Binding IsFormSizeEditable}"
                                 TextChanged="SurfaceNumericTextBox_TextChanged"/>
                      </StackPanel>
                    </Grid>

                    <Border Background="#F8FAFC"
                            BorderBrush="#D7E2EE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            IsVisible="{Binding IsFormSizeManagedByMonitor}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding PreviewSurfaceSummary}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PreviewSurfaceModeSummary}"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Позиция запуска"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableFormStartupLocations}"
                                  SelectedItem="{Binding FormStartupLocation, Mode=TwoWay}"/>
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4">
                        <TextBlock Text="Состояние окна"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableFormWindowStates}"
                                  SelectedItem="{Binding FormWindowState, Mode=TwoWay}"/>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Тема"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableFormThemes}"
                                  SelectedItem="{Binding FormTheme, Mode=TwoWay}"/>
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4">
                        <TextBlock Text="Фон"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SurfaceBackground, Mode=TwoWay}"
                                 Watermark="#FFFFFF"/>
                        <Button Classes="color-picker-button"
                                Tag="SurfaceBackground"
                                Click="OpenColorPickerButton_Click"
                                ToolTip.Tip="Открыть палитру цвета фона окна">
                          <StackPanel Orientation="Horizontal"
                                      Spacing="10">
                            <Border Width="22"
                                    Height="22"
                                    Background="{Binding SurfaceBackground}"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1"
                                    CornerRadius="6"/>
                            <TextBlock Text="Выбрать цвет"
                                       FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>

                    <Border Background="#F8FAFC"
                            BorderBrush="#D7E2EE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding FormThemeDescription}"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Оформление"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FormWindowDecorationsSummary}"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Режим layout"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableLayoutModes}"
                                  SelectedItem="{Binding SurfaceLayoutMode, Mode=TwoWay}"/>
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4"
                                  IsVisible="{Binding CanEditSurfaceFlowLayout}">
                        <TextBlock Text="Ориентация"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableLayoutOrientations}"
                                  SelectedItem="{Binding SurfaceLayoutOrientation, Mode=TwoWay}"/>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="4"
                                  IsVisible="{Binding CanEditSurfaceFlowLayout}">
                        <TextBlock Text="Отступ между элементами"
                                   FontWeight="SemiBold"/>
                        <TextBox Tag="SurfaceLayoutSpacing"
                                 Text="{Binding SurfaceLayoutSpacing, Mode=TwoWay}"
                                 TextChanged="SurfaceNumericTextBox_TextChanged"/>
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4"
                                  IsVisible="{Binding CanEditSurfaceGridLayout}">
                        <TextBlock Text="Колонки"
                                   FontWeight="SemiBold"/>
                        <TextBox Tag="SurfaceLayoutColumns"
                                 Text="{Binding SurfaceLayoutColumns, Mode=TwoWay}"
                                 TextChanged="SurfaceNumericTextBox_TextChanged"/>
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4"
                                IsVisible="{Binding CanEditSurfaceGridLayout}">
                      <TextBlock Text="Строки"
                                 FontWeight="SemiBold"/>
                      <TextBox Tag="SurfaceLayoutRows"
                               Text="{Binding SurfaceLayoutRows, Mode=TwoWay}"
                               TextChanged="SurfaceNumericTextBox_TextChanged"/>
                    </StackPanel>

                    <Border Background="#F8FAFC"
                            BorderBrush="#D7E2EE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">
                      <TextBlock Text="Absolute сохраняет свободное позиционирование. Stack раскладывает элементы по одной оси, Grid строит авто-сетку, а Flex переносит элементы по строкам или столбцам."
                                 Foreground="#475569"
                                 TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Spacing="6"
                                IsVisible="False">
                      <TextBlock Text="Пресеты рабочей области"
                                 FontWeight="SemiBold"/>
                      <WrapPanel ItemWidth="132"
                                 Orientation="Horizontal">
                        <Button Content="Обычная"
                                Margin="0,0,8,8"
                                Tag="Classic"
                                Click="ApplySurfaceVisualPresetButton_Click"/>
                        <Button Content="Тёмно-синяя"
                                Margin="0,0,8,8"
                                Tag="DeepBlue"
                                Click="ApplySurfaceVisualPresetButton_Click"/>
                        <Button Content="Ночная"
                                Margin="0,0,8,8"
                                Tag="Night"
                                Click="ApplySurfaceVisualPresetButton_Click"/>
                        <Button Content="Лёд"
                                Margin="0,0,8,8"
                                Tag="Frost"
                                Click="ApplySurfaceVisualPresetButton_Click"/>
                        <Button Content="Сияние"
                                Margin="0,0,8,8"
                                Tag="Aurora"
                                Click="ApplySurfaceVisualPresetButton_Click"/>
                      </WrapPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox Content="Можно менять размер"
                                IsChecked="{Binding FormCanResize, Mode=TwoWay}"/>
                      <CheckBox Grid.Column="1"
                                Content="Системная рамка"
                                IsChecked="{Binding FormHasSystemDecorations, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox Content="Показывать в панели задач"
                                IsChecked="{Binding FormShowInTaskbar, Mode=TwoWay}"/>
                      <CheckBox Grid.Column="1"
                                Content="Поверх всех окон"
                                IsChecked="{Binding FormTopmost, Mode=TwoWay}"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Настройки поведения самого конструктора: сетка и режимы просмотра. -->
                <Border Background="White"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Дизайнер"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Шаг сетки"
                                   FontWeight="SemiBold"/>
                        <TextBox Tag="SnapStep"
                                 Text="{Binding SnapStep, Mode=TwoWay}"
                                 TextChanged="SurfaceNumericTextBox_TextChanged"/>
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4">
                        <TextBlock Text="Порог smart snap"
                                   FontWeight="SemiBold"/>
                        <TextBox Tag="SnapThreshold"
                                 Text="{Binding SnapThreshold, Mode=TwoWay}"
                                 TextChanged="SurfaceNumericTextBox_TextChanged"/>
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox Content="Enable snapping"
                                IsChecked="{Binding IsCanvasSnappingEnabled, Mode=TwoWay}"/>
                      <CheckBox Grid.Column="1"
                                Content="Show grid"
                                IsChecked="{Binding IsDesignerGridVisible, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox Content="Snap to grid"
                                IsChecked="{Binding IsGridSnapEnabled, Mode=TwoWay}"/>
                      <CheckBox Grid.Column="1"
                                Content="Привязка к элементам и контейнеру"
                                IsChecked="{Binding IsControlSnapEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox Content="Smart guides"
                                IsChecked="{Binding IsSmartGuidesEnabled, Mode=TwoWay}"/>
                      <CheckBox Grid.Column="1"
                                Content="Distance hints"
                                IsChecked="{Binding IsDistanceHintsEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox Content="Ignore locked in marquee"
                                IsChecked="{Binding IgnoreLockedDuringSelection, Mode=TwoWay}"/>
                      <CheckBox Grid.Column="1"
                                Content="Selection toolbar"
                                IsChecked="{Binding IsSelectionToolbarEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Режим редактирования"
                                   FontWeight="SemiBold"/>
                        <CheckBox Content="Полноэкранное редактирование"
                                  IsChecked="{Binding IsImmersiveDesignerMode, Mode=TwoWay}"/>
                      </StackPanel>

                      <Border Grid.Column="1"
                              Background="#F8FAFC"
                              BorderBrush="#D7E2EE"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="10">
                        <TextBlock Text="Alt во время перемещения/resize временно отключает сетку и умную привязку."
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                      </Border>
                    </Grid>

                    <TextBlock Text="Нажмите F11 для полноэкранного редактирования."
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Карточка выделения показывает свойства выбранного элемента.
                     Блоки внутри скрываются и показываются через IsVisible в зависимости от типа контрола. -->
                <Border Background="White"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Выделенные"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedControlSummary}"
                               Foreground="#475569"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Выберите элемент на форме или в структуре, чтобы открыть полный набор свойств."
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>

                    <Border IsVisible="{Binding HasMultipleSelection}"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Инструменты выделения"
                                   FontWeight="Bold"
                                   Foreground="#1D4ED8"/>
                        <TextBlock Text="Главный элемент используется как якорь. Изменения ниже применяются ко всем выбранным элементам, которые поддерживают это свойство."
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>

                        <WrapPanel ItemWidth="110"
                                   Orientation="Horizontal">
                          <Button Content="По левому краю"
                                  Command="{Binding AlignSelectionLeftCommand}"
                                  IsEnabled="{Binding CanArrangeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="По верхнему краю"
                                  Command="{Binding AlignSelectionTopCommand}"
                                  IsEnabled="{Binding CanArrangeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="По правому краю"
                                  Command="{Binding AlignSelectionRightCommand}"
                                  IsEnabled="{Binding CanArrangeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="По нижнему краю"
                                  Command="{Binding AlignSelectionBottomCommand}"
                                  IsEnabled="{Binding CanArrangeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="По центру"
                                  Command="{Binding AlignSelectionCenterCommand}"
                                  IsEnabled="{Binding CanArrangeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="По середине"
                                  Command="{Binding AlignSelectionMiddleCommand}"
                                  IsEnabled="{Binding CanArrangeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="Распред. X"
                                  Command="{Binding DistributeSelectionHorizontalCommand}"
                                  IsEnabled="{Binding CanDistributeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="Распред. Y"
                                  Command="{Binding DistributeSelectionVerticalCommand}"
                                  IsEnabled="{Binding CanDistributeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="Одна ширина"
                                  Command="{Binding MatchSelectionWidthCommand}"
                                  IsEnabled="{Binding CanArrangeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="Одна высота"
                                  Command="{Binding MatchSelectionHeightCommand}"
                                  IsEnabled="{Binding CanArrangeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="Один размер"
                                  Command="{Binding MatchSelectionSizeCommand}"
                                  IsEnabled="{Binding CanArrangeSelection}"
                                  Margin="0,0,8,8"/>
                          <Button Content="Копировать стиль"
                                  Command="{Binding CopyStyleCommand}"
                                  IsEnabled="{Binding CanCopyStyle}"
                                  Margin="0,0,8,8"/>
                          <Button Content="Вставить стиль"
                                  Command="{Binding PasteStyleCommand}"
                                  IsEnabled="{Binding CanPasteStyle}"
                                  Margin="0,0,8,8"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding HasSelectedControl}"
                                Spacing="10">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Имя"
                                     FontWeight="SemiBold"/>
                          <TextBox Text="{Binding SelectedControl.Name, Mode=TwoWay}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#EEF2FF"
                                CornerRadius="999"
                                Padding="10,6"
                                VerticalAlignment="Bottom">
                          <TextBlock Text="{Binding SelectedControl.Type}"
                                     Foreground="#4338CA"
                                     FontWeight="SemiBold"/>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#334155"
                                CornerRadius="999"
                                Padding="10,6"
                                VerticalAlignment="Bottom"
                                IsVisible="{Binding SelectedControl.IsLocked}">
                          <TextBlock Text="Заблокировано"
                                     Foreground="White"
                                     FontWeight="SemiBold"/>
                        </Border>
                      </Grid>

                      <StackPanel IsVisible="{Binding CanEditText}"
                                  Spacing="4">
                        <TextBlock Text="{Binding SelectedTextLabel}"
                                   FontWeight="SemiBold"/>
                        <TextBox Tag="Text"
                                 Text="{Binding SelectedControl.Text, Mode=TwoWay}"
                                 TextChanged="SelectedTextPropertyTextChanged"/>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditPlaceholder}"
                                  Spacing="4">
                        <TextBlock Text="Подсказка / Watermark"
                                   FontWeight="SemiBold"/>
                        <TextBox Tag="PlaceholderText"
                                 Text="{Binding SelectedControl.PlaceholderText, Mode=TwoWay}"
                                 TextChanged="SelectedTextPropertyTextChanged"/>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditImageSource}"
                                  Spacing="6">
                        <TextBlock Text="Источник изображения"
                                   FontWeight="SemiBold"/>
                        <TextBox Tag="ImageSource"
                                 Text="{Binding SelectedControl.ImageSource, Mode=TwoWay}"
                                 TextChanged="SelectedTextPropertyTextChanged"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                          <Button Content="Подставить пример"
                                  HorizontalAlignment="Left"
                                  Click="ApplySampleImageButton_Click"/>
                          <Button Content="Выбрать изображение..."
                                  HorizontalAlignment="Left"
                                  Click="BrowseImageButton_Click"/>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditStretch}"
                                  Spacing="4">
                        <TextBlock Text="Режим растяжения"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableStretchModes}"
                                  Tag="Stretch"
                                  SelectedItem="{Binding SelectedControl.Stretch, Mode=TwoWay}"
                                  SelectionChanged="SelectedComboBox_SelectionChanged"/>
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*"
                            IsVisible="{Binding CanEditSelectedAbsolutePosition}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="X"
                                     FontWeight="SemiBold"/>
                          <TextBox Tag="X"
                                   Text="{Binding SelectedControl.X, Mode=TwoWay}"
                                   TextChanged="SelectedNumericTextBox_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4">
                          <TextBlock Text="Y"
                                     FontWeight="SemiBold"/>
                          <TextBox Tag="Y"
                                   Text="{Binding SelectedControl.Y, Mode=TwoWay}"
                                   TextChanged="SelectedNumericTextBox_TextChanged"/>
                        </StackPanel>
                      </Grid>

                      <Border Background="#F8FAFC"
                              BorderBrush="#D7E2EE"
                              BorderThickness="1"
                              CornerRadius="12"
                              Padding="10"
                              IsVisible="{Binding IsSelectedControlManagedByLayout}">
                        <TextBlock Text="{Binding SelectedControlLayoutHint}"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                      </Border>

                      <StackPanel Spacing="8"
                                  IsVisible="{Binding CanEditSelectedAnchors}">
                        <TextBlock Text="Якоря"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Привязка к краям родительского контейнера. Left+Right и Top+Bottom растягивают элемент при изменении размера."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,*">
                          <CheckBox Content="Слева"
                                    IsChecked="{Binding SelectedControl.AnchorLeft, Mode=TwoWay}"/>
                          <CheckBox Grid.Column="1"
                                    Content="Справа"
                                    IsChecked="{Binding SelectedControl.AnchorRight, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*">
                          <CheckBox Content="Сверху"
                                    IsChecked="{Binding SelectedControl.AnchorTop, Mode=TwoWay}"/>
                          <CheckBox Grid.Column="1"
                                    Content="Снизу"
                                    IsChecked="{Binding SelectedControl.AnchorBottom, Mode=TwoWay}"/>
                        </Grid>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditSelectedLayoutFlow}"
                                  Spacing="8">
                        <TextBlock Text="Параметры layout"
                                   FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*,*">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Ориентация"
                                       FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AvailableLayoutOrientations}"
                                      Tag="LayoutOrientation"
                                      SelectedItem="{Binding SelectedControl.LayoutOrientation, Mode=TwoWay}"
                                      SelectionChanged="SelectedComboBox_SelectionChanged"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Отступ"
                                       FontWeight="SemiBold"/>
                            <TextBox Tag="LayoutSpacing"
                                     Text="{Binding SelectedControl.LayoutSpacing, Mode=TwoWay}"
                                     TextChanged="SelectedNumericTextBox_TextChanged"/>
                          </StackPanel>
                        </Grid>
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Ширина"
                                     FontWeight="SemiBold"/>
                          <TextBox Tag="Width"
                                   Text="{Binding SelectedControl.Width, Mode=TwoWay}"
                                   TextChanged="SelectedNumericTextBox_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4">
                          <TextBlock Text="Высота"
                                     FontWeight="SemiBold"/>
                          <TextBox Tag="Height"
                                   Text="{Binding SelectedControl.Height, Mode=TwoWay}"
                                   TextChanged="SelectedNumericTextBox_TextChanged"/>
                        </StackPanel>
                      </Grid>

                      <Grid ColumnDefinitions="*,*">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Прозрачность"
                                     FontWeight="SemiBold"/>
                          <TextBox Tag="Opacity"
                                   Text="{Binding SelectedControl.Opacity, Mode=TwoWay}"
                                   TextChanged="SelectedNumericTextBox_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4">
                          <TextBlock Text="Состояние"
                                     FontWeight="SemiBold"/>
                          <CheckBox Content="Показывать элемент"
                                    Tag="IsVisible"
                                    IsChecked="{Binding SelectedControl.IsVisible, Mode=TwoWay}"
                                    Click="SelectedCheckBox_Click"/>
                          <CheckBox Content="Заблокировать на поверхности"
                                    Tag="IsLocked"
                                    IsChecked="{Binding SelectedControl.IsLocked, Mode=TwoWay}"
                                    Click="SelectedCheckBox_Click"/>
                          <TextBlock Text="{Binding SelectedLockStateSummary}"
                                     Foreground="#64748B"
                                     TextWrapping="Wrap"/>
                          </StackPanel>
                        </Grid>

                      <Border Background="#F8FAFC"
                              BorderBrush="#BFDBFE"
                              BorderThickness="1"
                              CornerRadius="16"
                              Padding="14"
                              IsVisible="{Binding CanEditDataGridBasic}">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="3">
                            <TextBlock Text="DataGrid"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1D4ED8"/>
                              <TextBlock Text="Базовые настройки: сначала настройте данные, колонки и режимы отображения, а детали откройте ниже осознанно."
                                       Foreground="#475569"
                                       TextWrapping="Wrap"/>
                          </StackPanel>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="4">
                              <TextBlock Text="BindingSource"
                                         FontWeight="SemiBold"/>
                              <ComboBox ItemsSource="{Binding BindingSources}"
                                        SelectedItem="{Binding SelectedBindingSourceForControl, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="models:BindingSourceModel">
                                    <StackPanel Spacing="2">
                                      <TextBlock Text="{Binding Name}"
                                                 FontWeight="SemiBold"/>
                                      <TextBlock Text="{Binding Path}"
                                                 Foreground="#64748B"
                                                 FontSize="12"/>
                                    </StackPanel>
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="6"
                                        VerticalAlignment="Bottom">
                              <CheckBox Content="Автогенерация колонок"
                                        Tag="AutoGenerateColumns"
                                        IsChecked="{Binding SelectedControl.AutoGenerateColumns, Mode=TwoWay}"
                                        Click="SelectedCheckBox_Click"/>
                            </StackPanel>
                          </Grid>

                          <Border Background="#FFFFFF"
                                  BorderBrush="#D7E2EE"
                                  BorderThickness="1"
                                  CornerRadius="12"
                                  Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedGridColumnEditorTitle}"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedGridColumnCompactSummary}"
                                           Foreground="#475569"
                                           TextWrapping="Wrap"/>
                              </StackPanel>

                              <Button Grid.Column="1"
                                      Content="Редактировать колонки..."
                                      Classes="data-action-button"
                                      Padding="14,9"
                                      VerticalAlignment="Center"
                                      Click="OpenDataGridColumnEditorButton_Click"/>
                            </Grid>
                          </Border>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="8">
                              <CheckBox Content="Строка фильтра"
                                        Tag="ShowFilterRow"
                                        IsChecked="{Binding SelectedControl.ShowFilterRow, Mode=TwoWay}"
                                        Click="SelectedCheckBox_Click"/>
                              <StackPanel Spacing="4">
                                <TextBlock Text="Режим фильтра"
                                           FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AvailableDataGridFilterModes}"
                                          Tag="FilterMode"
                                          SelectedItem="{Binding SelectedControl.FilterMode, Mode=TwoWay}"
                                          SelectionChanged="SelectedComboBox_SelectionChanged"/>
                              </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="8">
                              <CheckBox Content="Панель группировки"
                                        Tag="ShowGroupPanel"
                                        IsChecked="{Binding SelectedControl.ShowGroupPanel, Mode=TwoWay}"
                                        Click="SelectedCheckBox_Click"/>
                              <CheckBox Content="Разрешить группировку"
                                        Tag="AllowGrouping"
                                        IsChecked="{Binding SelectedControl.AllowGrouping, Mode=TwoWay}"
                                        Click="SelectedCheckBox_Click"/>
                              <CheckBox Content="Итоги внизу"
                                        Tag="ShowFooter"
                                        IsChecked="{Binding SelectedControl.ShowFooter, Mode=TwoWay}"
                                        Click="SelectedCheckBox_Click"/>
                            </StackPanel>
                          </Grid>

                          <StackPanel Spacing="6">
                            <TextBlock Text="Тема / пресет"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Быстрый стиль таблицы. Пресет меняет обычные свойства, поэтому после него можно вручную уточнить цвета и размеры."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"/>
                            <WrapPanel ItemWidth="132"
                                       Orientation="Horizontal">
                              <Button Content="Классика"
                                      Margin="0,0,8,8"
                                      Tag="DataGrid:Classic"
                                      Click="ApplyControlVisualPresetButton_Click"/>
                              <Button Content="Светло-синий"
                                      Margin="0,0,8,8"
                                      Tag="DataGrid:LightBlue"
                                      Click="ApplyControlVisualPresetButton_Click"/>
                              <Button Content="Темная шапка"
                                      Margin="0,0,8,8"
                                      Tag="DataGrid:DarkHeader"
                                      Click="ApplyControlVisualPresetButton_Click"/>
                              <Button Content="Компактный"
                                      Margin="0,0,8,8"
                                      Tag="DataGrid:Compact"
                                      Click="ApplyControlVisualPresetButton_Click"/>
                              <Button Content="Удобный"
                                      Margin="0,0,8,8"
                                      Tag="DataGrid:Comfortable"
                                      Click="ApplyControlVisualPresetButton_Click"/>
                              <Button Content="Корпоративный"
                                      Margin="0,0,8,8"
                                      Tag="DataGrid:Enterprise"
                                      Click="ApplyControlVisualPresetButton_Click"/>
                              <Button Content="Минимальный"
                                      Margin="0,0,8,8"
                                      Tag="DataGrid:Minimal"
                                      Click="ApplyControlVisualPresetButton_Click"/>
                            </WrapPanel>
                          </StackPanel>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Высота шапки"
                                         FontWeight="SemiBold"/>
                              <TextBox Tag="DataGridHeaderHeight"
                                       Text="{Binding SelectedControl.DataGridHeaderHeight, Mode=TwoWay}"
                                       TextChanged="SelectedNumericTextBox_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="4">
                              <TextBlock Text="Высота строки"
                                         FontWeight="SemiBold"/>
                              <TextBox Tag="DataGridRowHeight"
                                       Text="{Binding SelectedControl.DataGridRowHeight, Mode=TwoWay}"
                                       TextChanged="SelectedNumericTextBox_TextChanged"/>
                            </StackPanel>
                          </Grid>

                          <Border Background="#F8FAFC"
                                  BorderBrush="#BFDBFE"
                                  BorderThickness="1"
                                  CornerRadius="14"
                                  Padding="12"
                                  IsVisible="{Binding CanEditDataGridInteractions}">
                            <StackPanel Spacing="10">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="Логика выбора строки"
                                             FontSize="16"
                                             FontWeight="Bold"
                                             Foreground="#1D4ED8"/>
                                  <TextBlock Text="{Binding InteractionDesignerSummary}"
                                             Foreground="#475569"
                                             TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Добавить действие"
                                        Command="{Binding AddInteractionForSelectedDataGridCommand}"
                                        Classes="data-action-button"
                                        Padding="12,8"
                                        VerticalAlignment="Top"/>
                              </Grid>

                              <ItemsControl ItemsSource="{Binding SelectedDataGridInteractions}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="models:InteractionModel">
                                    <Border Margin="0,0,0,8"
                                            Padding="10"
                                            Background="White"
                                            BorderBrush="#D7E2EE"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                      <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                          <TextBlock Text="{Binding Summary}"
                                                     FontWeight="SemiBold"
                                                     TextWrapping="Wrap"/>
                                          <Button Grid.Column="1"
                                                  Content="Удалить"
                                                  Command="{Binding #RootWindow.DataContext.RemoveInteractionCommand}"
                                                  CommandParameter="{Binding}"
                                                  Padding="10,6"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*">
                                          <StackPanel Spacing="4">
                                            <TextBlock Text="Куда"
                                                       FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding #RootWindow.DataContext.InteractionTargetControlNames}"
                                                      SelectedItem="{Binding TargetControlName, Mode=TwoWay}"/>
                                          </StackPanel>

                                          <StackPanel Grid.Column="1"
                                                      Spacing="4">
                                            <TextBlock Text="Свойство"
                                                       FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableInteractionTargetPropertyOptions}"
                                                      SelectedValue="{Binding TargetProperty, Mode=TwoWay}"
                                                      SelectedValueBinding="{Binding Value}">
                                              <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:InteractionOptionModel">
                                                  <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                              </ComboBox.ItemTemplate>
                                            </ComboBox>
                                          </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*">
                                          <StackPanel Spacing="4">
                                            <TextBlock Text="Поле строки"
                                                       FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding #RootWindow.DataContext.InteractionSourceFieldPaths}"
                                                      SelectedItem="{Binding SourcePath, Mode=TwoWay}"/>
                                          </StackPanel>

                                          <StackPanel Grid.Column="1"
                                                      Spacing="4">
                                            <TextBlock Text="Шаблон"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TextTemplate}"
                                                       MinHeight="28"
                                                       TextWrapping="Wrap"
                                                       Foreground="#334155"/>
                                            <Button Content="Редактировать в Logic"
                                                    Command="{Binding #RootWindow.DataContext.SelectInteractionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,6"
                                                    HorizontalAlignment="Left"/>
                                          </StackPanel>
                                        </Grid>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>

                          <Expander Header="Расширенный внешний вид"
                                    IsExpanded="False">
                            <Border Background="#FFFFFF"
                                    BorderBrush="#D7E2EE"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,8,0,0">
                              <StackPanel Spacing="12">
                                <TextBlock Text="Цвета, типографика и плотность таблицы. Эти настройки нужны, когда пресета уже недостаточно."
                                           Foreground="#475569"
                                           TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,*">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="Фон шапки"
                                               FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBox Tag="DataGridHeaderBackground"
                                               Text="{Binding SelectedControl.DataGridHeaderBackground, Mode=TwoWay}"
                                               TextChanged="SelectedTextPropertyTextChanged"/>
                                      <Button Grid.Column="1"
                                              Content="..."
                                              Tag="DataGridHeaderBackground"
                                              Classes="data-action-button"
                                              Click="OpenColorPickerButton_Click"/>
                                    </Grid>
                                  </StackPanel>

                                  <StackPanel Grid.Column="1"
                                              Spacing="4">
                                    <TextBlock Text="Текст шапки"
                                               FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBox Tag="DataGridHeaderForeground"
                                               Text="{Binding SelectedControl.DataGridHeaderForeground, Mode=TwoWay}"
                                               TextChanged="SelectedTextPropertyTextChanged"/>
                                      <Button Grid.Column="1"
                                              Content="..."
                                              Tag="DataGridHeaderForeground"
                                              Classes="data-action-button"
                                              Click="OpenColorPickerButton_Click"/>
                                    </Grid>
                                  </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="Фон строки"
                                               FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBox Tag="DataGridRowBackground"
                                               Text="{Binding SelectedControl.DataGridRowBackground, Mode=TwoWay}"
                                               TextChanged="SelectedTextPropertyTextChanged"/>
                                      <Button Grid.Column="1"
                                              Content="..."
                                              Tag="DataGridRowBackground"
                                              Classes="data-action-button"
                                              Click="OpenColorPickerButton_Click"/>
                                    </Grid>
                                  </StackPanel>

                                  <StackPanel Grid.Column="1"
                                              Spacing="4">
                                    <TextBlock Text="Чередующаяся строка"
                                               FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBox Tag="DataGridAlternateRowBackground"
                                               Text="{Binding SelectedControl.DataGridAlternateRowBackground, Mode=TwoWay}"
                                               TextChanged="SelectedTextPropertyTextChanged"/>
                                      <Button Grid.Column="1"
                                              Content="..."
                                              Tag="DataGridAlternateRowBackground"
                                              Classes="data-action-button"
                                              Click="OpenColorPickerButton_Click"/>
                                    </Grid>
                                  </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="Выбранная строка"
                                               FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBox Tag="DataGridSelectedRowBackground"
                                               Text="{Binding SelectedControl.DataGridSelectedRowBackground, Mode=TwoWay}"
                                               TextChanged="SelectedTextPropertyTextChanged"/>
                                      <Button Grid.Column="1"
                                              Content="..."
                                              Tag="DataGridSelectedRowBackground"
                                              Classes="data-action-button"
                                              Click="OpenColorPickerButton_Click"/>
                                    </Grid>
                                  </StackPanel>

                                  <StackPanel Grid.Column="1"
                                              Spacing="4">
                                    <TextBlock Text="Строка при наведении"
                                               FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBox Tag="DataGridHoverRowBackground"
                                               Text="{Binding SelectedControl.DataGridHoverRowBackground, Mode=TwoWay}"
                                               TextChanged="SelectedTextPropertyTextChanged"/>
                                      <Button Grid.Column="1"
                                              Content="..."
                                              Tag="DataGridHoverRowBackground"
                                              Classes="data-action-button"
                                              Click="OpenColorPickerButton_Click"/>
                                    </Grid>
                                  </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="Линии таблицы"
                                               FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBox Tag="DataGridGridLineBrush"
                                               Text="{Binding SelectedControl.DataGridGridLineBrush, Mode=TwoWay}"
                                               TextChanged="SelectedTextPropertyTextChanged"/>
                                      <Button Grid.Column="1"
                                              Content="..."
                                              Tag="DataGridGridLineBrush"
                                              Classes="data-action-button"
                                              Click="OpenColorPickerButton_Click"/>
                                    </Grid>
                                  </StackPanel>

                                  <StackPanel Grid.Column="1"
                                              Spacing="4">
                                    <TextBlock Text="Граница"
                                               FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBox Tag="DataGridOuterBorderBrush"
                                               Text="{Binding SelectedControl.DataGridOuterBorderBrush, Mode=TwoWay}"
                                               TextChanged="SelectedTextPropertyTextChanged"/>
                                      <Button Grid.Column="1"
                                              Content="..."
                                              Tag="DataGridOuterBorderBrush"
                                              Classes="data-action-button"
                                              Click="OpenColorPickerButton_Click"/>
                                    </Grid>
                                  </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="Скругление"
                                               FontWeight="SemiBold"/>
                                    <TextBox Tag="CornerRadius"
                                             Text="{Binding SelectedControl.CornerRadius, Mode=TwoWay}"
                                             TextChanged="SelectedNumericTextBox_TextChanged"/>
                                  </StackPanel>

                                  <StackPanel Grid.Column="1"
                                              Spacing="4">
                                    <TextBlock Text="Отступ ячейки"
                                               FontWeight="SemiBold"/>
                                    <TextBox Tag="DataGridCellPadding"
                                             Text="{Binding SelectedControl.DataGridCellPadding, Mode=TwoWay}"
                                             TextChanged="SelectedNumericTextBox_TextChanged"/>
                                  </StackPanel>

                                  <StackPanel Grid.Column="2"
                                              Spacing="4">
                                    <TextBlock Text="Выравнивание текста"
                                               FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding AvailableDataGridTextAlignments}"
                                              Tag="DataGridTextAlignment"
                                              SelectedItem="{Binding SelectedControl.DataGridTextAlignment, Mode=TwoWay}"
                                              SelectionChanged="SelectedComboBox_SelectionChanged"/>
                                  </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="Шрифт"
                                               FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                                              Tag="FontFamily"
                                              SelectedItem="{Binding SelectedControl.FontFamily, Mode=TwoWay}"
                                              SelectionChanged="SelectedComboBox_SelectionChanged"/>
                                  </StackPanel>

                                  <StackPanel Grid.Column="1"
                                              Spacing="4">
                                    <TextBlock Text="Насыщенность строки"
                                               FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding AvailableFontWeights}"
                                              Tag="DataGridRowFontWeight"
                                              SelectedItem="{Binding SelectedControl.DataGridRowFontWeight, Mode=TwoWay}"
                                              SelectionChanged="SelectedComboBox_SelectionChanged"/>
                                  </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="Размер шрифта шапки"
                                               FontWeight="SemiBold"/>
                                    <TextBox Tag="DataGridHeaderFontSize"
                                             Text="{Binding SelectedControl.DataGridHeaderFontSize, Mode=TwoWay}"
                                             TextChanged="SelectedNumericTextBox_TextChanged"/>
                                  </StackPanel>

                                  <StackPanel Grid.Column="1"
                                              Spacing="4">
                                    <TextBlock Text="Размер шрифта строки"
                                               FontWeight="SemiBold"/>
                                    <TextBox Tag="DataGridRowFontSize"
                                             Text="{Binding SelectedControl.DataGridRowFontSize, Mode=TwoWay}"
                                             TextChanged="SelectedNumericTextBox_TextChanged"/>
                                  </StackPanel>

                                  <StackPanel Grid.Column="2"
                                              Spacing="4">
                                    <TextBlock Text="Насыщенность шапки"
                                               FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding AvailableFontWeights}"
                                              Tag="DataGridHeaderFontWeight"
                                              SelectedItem="{Binding SelectedControl.DataGridHeaderFontWeight, Mode=TwoWay}"
                                              SelectionChanged="SelectedComboBox_SelectionChanged"/>
                                  </StackPanel>
                                </Grid>
                              </StackPanel>
                            </Border>
                          </Expander>

                          <Expander Header="Расширенное поведение"
                                    IsExpanded="False">
                            <Border Background="#FFFFFF"
                                    BorderBrush="#D7E2EE"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,8,0,0">
                              <StackPanel Spacing="12">
                                <TextBlock Text="Поведение таблицы и видимость служебных слоев. Настройки колонок «изменять размер / сортировать / фильтровать» открываются через редактор колонок."
                                           Foreground="#475569"
                                           TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,*">
                                  <StackPanel Spacing="8">
                                    <CheckBox Content="Показывать шапку"
                                              Tag="DataGridShowHeader"
                                              IsChecked="{Binding SelectedControl.DataGridShowHeader, Mode=TwoWay}"
                                              Click="SelectedCheckBox_Click"/>
                                    <CheckBox Content="Горизонтальные линии"
                                              Tag="DataGridShowRowLines"
                                              IsChecked="{Binding SelectedControl.DataGridShowRowLines, Mode=TwoWay}"
                                              Click="SelectedCheckBox_Click"/>
                                    <CheckBox Content="Вертикальные линии"
                                              Tag="DataGridShowColumnLines"
                                              IsChecked="{Binding SelectedControl.DataGridShowColumnLines, Mode=TwoWay}"
                                              Click="SelectedCheckBox_Click"/>
                                  </StackPanel>

                                  <StackPanel Grid.Column="1"
                                              Spacing="8">
                                    <CheckBox Content="Чередование строк"
                                              Tag="DataGridShowAlternatingRows"
                                              IsChecked="{Binding SelectedControl.DataGridShowAlternatingRows, Mode=TwoWay}"
                                              Click="SelectedCheckBox_Click"/>
                                    <CheckBox Content="Строка фильтра"
                                              Tag="ShowFilterRow"
                                              IsChecked="{Binding SelectedControl.ShowFilterRow, Mode=TwoWay}"
                                              Click="SelectedCheckBox_Click"/>
                                    <CheckBox Content="Панель группировки"
                                              Tag="ShowGroupPanel"
                                              IsChecked="{Binding SelectedControl.ShowGroupPanel, Mode=TwoWay}"
                                              Click="SelectedCheckBox_Click"/>
                                  </StackPanel>
                                </Grid>

                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                  <TextBlock Text="Прокрутка и выделение пока наследуются от preview/runtime таблицы. Если добавим отдельные runtime-флаги, они попадут сюда, а не в базовые настройки."
                                             Foreground="#64748B"
                                             TextWrapping="Wrap"/>
                                </Border>
                              </StackPanel>
                            </Border>
                          </Expander>

                          <Expander Header="Экспертные настройки"
                                    IsExpanded="False">
                            <Border Background="#FFFBEB"
                                    BorderBrush="#FCD34D"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,8,0,0">
                              <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="Enterprise-настройки DataGrid"
                                           FontWeight="Bold"
                                           Foreground="#92400E"/>
                                  <TextBlock Text="Здесь собраны редкие сценарии, которые влияют на структуру колонок, генерацию кода и runtime-поведение. Они не показываются в Basic, чтобы обычная настройка таблицы оставалась простой."
                                           Foreground="#78350F"
                                           TextWrapping="Wrap"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto">
                                  <Border Background="#FFFFFF"
                                          BorderBrush="#FCD34D"
                                          BorderThickness="1"
                                          CornerRadius="12"
                                          Padding="10">
                                    <StackPanel Spacing="5">
                                      <TextBlock Text="Настройки итогов"
                                                 FontWeight="Bold"
                                                 Foreground="#92400E"/>
                                      <TextBlock Text="Итоги, поведение агрегатов, SummaryType и SummaryFormat для отдельных колонок."
                                                 Foreground="#78350F"
                                                 TextWrapping="Wrap"/>
                                      <TextBlock Text="Используется для footer row, подсчета Count / Sum / Avg / Min / Max и форматирования итогов."
                                                 Foreground="#64748B"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </Border>

                                  <Border Grid.Column="1"
                                          Background="#FFFFFF"
                                          BorderBrush="#FCD34D"
                                          BorderThickness="1"
                                          CornerRadius="12"
                                          Padding="10">
                                    <StackPanel Spacing="5">
                                      <TextBlock Text="Логика группировки"
                                                 FontWeight="Bold"
                                                 Foreground="#92400E"/>
                                      <TextBlock Text="GroupOrder, порядок группировки и расширенное поведение групп на уровне полей."
                                                 Foreground="#78350F"
                                                 TextWrapping="Wrap"/>
                                      <TextBlock Text="Здесь задается, какие колонки становятся группами и в какой последовательности они применяются."
                                                 Foreground="#64748B"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </Border>

                                  <Border Grid.Row="1"
                                          Background="#FFFFFF"
                                          BorderBrush="#FCD34D"
                                          BorderThickness="1"
                                          CornerRadius="12"
                                          Padding="10">
                                    <StackPanel Spacing="5">
                                      <TextBlock Text="Экспорт / XAML"
                                                 FontWeight="Bold"
                                                 Foreground="#92400E"/>
                                      <TextBlock Text="Поведение экспорта, XAML-specific overrides и подсказки для генерации C#."
                                                 Foreground="#78350F"
                                                 TextWrapping="Wrap"/>
                                      <TextBlock Text="Экспорт читает те же BindingSource и BindingField настройки, поэтому дизайнер и generated code остаются синхронизированы."
                                                 Foreground="#64748B"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </Border>

                                  <Border Grid.Row="1"
                                          Grid.Column="1"
                                          Background="#FFFFFF"
                                          BorderBrush="#FCD34D"
                                          BorderThickness="1"
                                          CornerRadius="12"
                                          Padding="10">
                                    <StackPanel Spacing="5">
                                      <TextBlock Text="Низкоуровневые настройки"
                                                 FontWeight="Bold"
                                                 Foreground="#92400E"/>
                                      <TextBlock Text="Render flags, внутренние флаги поведения и переопределения на уровне колонок."
                                                 Foreground="#78350F"
                                                 TextWrapping="Wrap"/>
                                      <TextBlock Text="Например VisibleIndex, AllowResize, AllowSort, AllowFilter, trimming/wrapping и ограничения MinWidth / MaxWidth."
                                                 Foreground="#64748B"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </Border>
                                </Grid>

                                <Border Background="#FEF3C7"
                                        BorderBrush="#FBBF24"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                  <TextBlock Text="Расширенные column-level настройки доступны через: → Редактировать колонки"
                                             Foreground="#78350F"
                                             FontWeight="SemiBold"
                                             TextWrapping="Wrap"/>
                                </Border>
                              </StackPanel>
                            </Border>
                          </Expander>
                        </StackPanel>
                      </Border>

                      <StackPanel IsVisible="{Binding CanEditCommonBackground}"
                                  Spacing="4">
                        <TextBlock Text="Фон"
                                   FontWeight="SemiBold"/>
                        <StackPanel Spacing="8">
                          <TextBlock Text="Для DataGrid это поле меняет цвет шапки таблицы."
                                     Foreground="#64748B"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding CanEditDataGridAlternateRowBackground}"/>
                          <TextBox Tag="Background"
                                   Text="{Binding SelectedControl.Background, Mode=TwoWay}"
                                   TextChanged="SelectedTextPropertyTextChanged"/>
                          <Button Grid.Column="1"
                                  Tag="Background"
                                  Click="OpenColorPickerButton_Click"
                                  Classes="color-picker-button"
                                  ToolTip.Tip="Выбрать произвольный цвет">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                              <Border Width="22"
                                      Height="22"
                                      Background="{Binding SelectedControl.Background}"
                                      BorderBrush="#94A3B8"
                                      BorderThickness="1"
                                      CornerRadius="6"/>
                              <TextBlock Text="Выбрать цвет"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    IsVisible="False">
                          <Button Classes="swatch-button" Background="#FFFFFF" Tag="Background:#FFFFFF" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#0F172A" Tag="Background:#0F172A" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#2563EB" Tag="Background:#2563EB" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#10B981" Tag="Background:#10B981" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#F59E0B" Tag="Background:#F59E0B" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#EC4899" Tag="Background:#EC4899" Click="ApplyColorPresetButton_Click"/>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditDataGridGlowColor}"
                                  Spacing="4">
                        <TextBlock Text="Свечение"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="&#x426;&#x432;&#x435;&#x442; glow-&#x430;&#x43A;&#x446;&#x435;&#x43D;&#x442;&#x430; &#x432;&#x43E;&#x43A;&#x440;&#x443;&#x433; &#x442;&#x430;&#x431;&#x43B;&#x438;&#x446;&#x44B; &#x438; &#x432; &#x432;&#x435;&#x440;&#x445;&#x43D;&#x435;&#x439; &#x43F;&#x43E;&#x43B;&#x43E;&#x441;&#x435;."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                        <StackPanel Spacing="8">
                          <TextBox Tag="DataGridGlowColor"
                                   Text="{Binding SelectedControl.DataGridGlowColor, Mode=TwoWay}"
                                   TextChanged="SelectedTextPropertyTextChanged"/>
                          <Button Tag="DataGridGlowColor"
                                  Click="OpenColorPickerButton_Click"
                                  Classes="color-picker-button"
                                  ToolTip.Tip="Выбрать цвет glow-акцента">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                              <Border Width="22"
                                      Height="22"
                                      Background="{Binding SelectedControl.DataGridGlowColor}"
                                      BorderBrush="#94A3B8"
                                      BorderThickness="1"
                                      CornerRadius="6"/>
                              <TextBlock Text="Выбрать цвет"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditDataGridRowBackground}"
                                  Spacing="4">
                        <TextBlock Text="Все строки"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Основной цвет тела таблицы. Если цвет каждой второй строки совпадает с ним, таблица выглядит цельной без зебры."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                        <StackPanel Spacing="8">
                          <TextBox Tag="DataGridRowBackground"
                                   Text="{Binding SelectedControl.DataGridRowBackground, Mode=TwoWay}"
                                   TextChanged="SelectedTextPropertyTextChanged"/>
                          <Button Tag="DataGridRowBackground"
                                  Click="OpenColorPickerButton_Click"
                                  Classes="color-picker-button"
                                  ToolTip.Tip="Выбрать цвет всех строк таблицы">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                              <Border Width="22"
                                      Height="22"
                                      Background="{Binding SelectedControl.DataGridRowBackground}"
                                      BorderBrush="#94A3B8"
                                      BorderThickness="1"
                                      CornerRadius="6"/>
                              <TextBlock Text="Выбрать цвет"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditDataGridAlternateRowBackground}"
                                  Spacing="4">
                        <TextBlock Text="Чередующиеся строки"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Отдельный цвет для каждой второй строки. Основной фон тела таблицы остается нейтральным."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                        <StackPanel Spacing="8">
                          <TextBox Tag="DataGridAlternateRowBackground"
                                   Text="{Binding SelectedControl.DataGridAlternateRowBackground, Mode=TwoWay}"
                                   TextChanged="SelectedTextPropertyTextChanged"/>
                          <Button Tag="DataGridAlternateRowBackground"
                                  Click="OpenColorPickerButton_Click"
                                  Classes="color-picker-button"
                                  ToolTip.Tip="Выбрать цвет чередующихся строк">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                              <Border Width="22"
                                      Height="22"
                                      Background="{Binding SelectedControl.DataGridAlternateRowBackground}"
                                      BorderBrush="#94A3B8"
                                      BorderThickness="1"
                                      CornerRadius="6"/>
                              <TextBlock Text="Выбрать цвет"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="False"
                                  Spacing="4">
                        <TextBlock Text="Р’С‹СЂР°РІРЅРёРІР°РЅРёРµ С‚РµРєСЃС‚Р°"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="РљР°Рє СЂР°СЃРїРѕР»Р°РіР°С‚СЊ СЃРѕРґРµСЂР¶РёРјРѕРµ РІРЅСѓС‚СЂРё СЏС‡РµРµРє: СЃР»РµРІР°, РїРѕ С†РµРЅС‚СЂСѓ РёР»Рё СЃРїСЂР°РІР°."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                        <ComboBox ItemsSource="{Binding AvailableDataGridTextAlignments}"
                                  Tag="DataGridTextAlignment"
                                  SelectedItem="{Binding SelectedControl.DataGridTextAlignment, Mode=TwoWay}"
                                  SelectionChanged="SelectedComboBox_SelectionChanged"/>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditDataGridTextAlignment}"
                                  Spacing="4">
                        <TextBlock Text="&#x412;&#x44B;&#x440;&#x430;&#x432;&#x43D;&#x438;&#x432;&#x430;&#x43D;&#x438;&#x435; &#x442;&#x435;&#x43A;&#x441;&#x442;&#x430;"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="&#x41A;&#x430;&#x43A; &#x440;&#x430;&#x441;&#x43F;&#x43E;&#x43B;&#x430;&#x433;&#x430;&#x442;&#x44C; &#x441;&#x43E;&#x434;&#x435;&#x440;&#x436;&#x438;&#x43C;&#x43E;&#x435; &#x432;&#x43D;&#x443;&#x442;&#x440;&#x438; &#x44F;&#x447;&#x435;&#x435;&#x43A;: Left, Center &#x438;&#x43B;&#x438; Right."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                        <ComboBox ItemsSource="{Binding AvailableDataGridTextAlignments}"
                                  Tag="DataGridTextAlignment"
                                  SelectedItem="{Binding SelectedControl.DataGridTextAlignment, Mode=TwoWay}"
                                  SelectionChanged="SelectedComboBox_SelectionChanged"/>
                      </StackPanel>

                      <Border Background="#F8FAFC"
                              BorderBrush="#D7E2EE"
                              BorderThickness="1"
                              CornerRadius="12"
                              Padding="12"
                              IsVisible="{Binding CanEditDataGridAdvancedVisuals}">
                        <StackPanel Spacing="10">
                          <TextBlock Text="Расширенный внешний вид DataGrid"
                                     FontWeight="Bold"/>
                          <TextBlock Text="Отдельная настройка шапки, строк, линий, размеров и поведения таблицы."
                                     Foreground="#64748B"
                                     TextWrapping="Wrap"/>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Фон заголовка" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBox Tag="DataGridHeaderBackground" Text="{Binding SelectedControl.DataGridHeaderBackground, Mode=TwoWay}" TextChanged="SelectedTextPropertyTextChanged"/>
                                <Button Grid.Column="1" Content="..." Tag="DataGridHeaderBackground" Click="OpenColorPickerButton_Click" Classes="data-action-button"/>
                              </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Text="Текст заголовка" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBox Tag="DataGridHeaderForeground" Text="{Binding SelectedControl.DataGridHeaderForeground, Mode=TwoWay}" TextChanged="SelectedTextPropertyTextChanged"/>
                                <Button Grid.Column="1" Content="..." Tag="DataGridHeaderForeground" Click="OpenColorPickerButton_Click" Classes="data-action-button"/>
                              </Grid>
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Текст строк" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBox Tag="DataGridRowForeground" Text="{Binding SelectedControl.DataGridRowForeground, Mode=TwoWay}" TextChanged="SelectedTextPropertyTextChanged"/>
                                <Button Grid.Column="1" Content="..." Tag="DataGridRowForeground" Click="OpenColorPickerButton_Click" Classes="data-action-button"/>
                              </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Text="Наведение строки" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBox Tag="DataGridHoverRowBackground" Text="{Binding SelectedControl.DataGridHoverRowBackground, Mode=TwoWay}" TextChanged="SelectedTextPropertyTextChanged"/>
                                <Button Grid.Column="1" Content="..." Tag="DataGridHoverRowBackground" Click="OpenColorPickerButton_Click" Classes="data-action-button"/>
                              </Grid>
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Выбранная строка" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBox Tag="DataGridSelectedRowBackground" Text="{Binding SelectedControl.DataGridSelectedRowBackground, Mode=TwoWay}" TextChanged="SelectedTextPropertyTextChanged"/>
                                <Button Grid.Column="1" Content="..." Tag="DataGridSelectedRowBackground" Click="OpenColorPickerButton_Click" Classes="data-action-button"/>
                              </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Text="Текст выбранной" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBox Tag="DataGridSelectedRowForeground" Text="{Binding SelectedControl.DataGridSelectedRowForeground, Mode=TwoWay}" TextChanged="SelectedTextPropertyTextChanged"/>
                                <Button Grid.Column="1" Content="..." Tag="DataGridSelectedRowForeground" Click="OpenColorPickerButton_Click" Classes="data-action-button"/>
                              </Grid>
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Линии сетки" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBox Tag="DataGridGridLineBrush" Text="{Binding SelectedControl.DataGridGridLineBrush, Mode=TwoWay}" TextChanged="SelectedTextPropertyTextChanged"/>
                                <Button Grid.Column="1" Content="..." Tag="DataGridGridLineBrush" Click="OpenColorPickerButton_Click" Classes="data-action-button"/>
                              </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Text="Внешняя рамка" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBox Tag="DataGridOuterBorderBrush" Text="{Binding SelectedControl.DataGridOuterBorderBrush, Mode=TwoWay}" TextChanged="SelectedTextPropertyTextChanged"/>
                                <Button Grid.Column="1" Content="..." Tag="DataGridOuterBorderBrush" Click="OpenColorPickerButton_Click" Classes="data-action-button"/>
                              </Grid>
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Шрифт заголовка" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,*">
                                <TextBox Tag="DataGridHeaderFontSize" Text="{Binding SelectedControl.DataGridHeaderFontSize, Mode=TwoWay}" TextChanged="SelectedNumericTextBox_TextChanged"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFontWeights}" Tag="DataGridHeaderFontWeight" SelectedItem="{Binding SelectedControl.DataGridHeaderFontWeight, Mode=TwoWay}" SelectionChanged="SelectedComboBox_SelectionChanged"/>
                              </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Text="Шрифт строк" FontWeight="SemiBold"/>
                              <Grid ColumnDefinitions="*,*">
                                <TextBox Tag="DataGridRowFontSize" Text="{Binding SelectedControl.DataGridRowFontSize, Mode=TwoWay}" TextChanged="SelectedNumericTextBox_TextChanged"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFontWeights}" Tag="DataGridRowFontWeight" SelectedItem="{Binding SelectedControl.DataGridRowFontWeight, Mode=TwoWay}" SelectionChanged="SelectedComboBox_SelectionChanged"/>
                              </Grid>
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Высота заголовка" FontWeight="SemiBold"/>
                              <TextBox Tag="DataGridHeaderHeight" Text="{Binding SelectedControl.DataGridHeaderHeight, Mode=TwoWay}" TextChanged="SelectedNumericTextBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Text="Высота строки" FontWeight="SemiBold"/>
                              <TextBox Tag="DataGridRowHeight" Text="{Binding SelectedControl.DataGridRowHeight, Mode=TwoWay}" TextChanged="SelectedNumericTextBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                              <TextBlock Text="Отступ ячейки" FontWeight="SemiBold"/>
                              <TextBox Tag="DataGridCellPadding" Text="{Binding SelectedControl.DataGridCellPadding, Mode=TwoWay}" TextChanged="SelectedNumericTextBox_TextChanged"/>
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="4">
                              <CheckBox Content="Показывать заголовок" Tag="DataGridShowHeader" IsChecked="{Binding SelectedControl.DataGridShowHeader, Mode=TwoWay}" Click="SelectedCheckBox_Click"/>
                              <CheckBox Content="Горизонтальные линии" Tag="DataGridShowRowLines" IsChecked="{Binding SelectedControl.DataGridShowRowLines, Mode=TwoWay}" Click="SelectedCheckBox_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <CheckBox Content="Вертикальные линии" Tag="DataGridShowColumnLines" IsChecked="{Binding SelectedControl.DataGridShowColumnLines, Mode=TwoWay}" Click="SelectedCheckBox_Click"/>
                              <CheckBox Content="Чередование строк" Tag="DataGridShowAlternatingRows" IsChecked="{Binding SelectedControl.DataGridShowAlternatingRows, Mode=TwoWay}" Click="SelectedCheckBox_Click"/>
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>

                      <StackPanel IsVisible="{Binding CanEditCommonForeground}"
                                  Spacing="4">
                        <TextBlock Text="Цвет текста"
                                   FontWeight="SemiBold"/>
                        <StackPanel Spacing="8">
                          <TextBox Tag="Foreground"
                                   Text="{Binding SelectedControl.Foreground, Mode=TwoWay}"
                                   TextChanged="SelectedTextPropertyTextChanged"/>
                          <Button Grid.Column="1"
                                  Tag="Foreground"
                                  Click="OpenColorPickerButton_Click"
                                  Classes="color-picker-button"
                                  ToolTip.Tip="Выбрать произвольный цвет">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                              <Border Width="22"
                                      Height="22"
                                      Background="{Binding SelectedControl.Foreground}"
                                      BorderBrush="#94A3B8"
                                      BorderThickness="1"
                                      CornerRadius="6"/>
                              <TextBlock Text="Выбрать цвет"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    IsVisible="False">
                          <Button Classes="swatch-button" Background="#0F172A" Tag="Foreground:#0F172A" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#334155" Tag="Foreground:#334155" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#FFFFFF" Tag="Foreground:#FFFFFF" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#1D4ED8" Tag="Foreground:#1D4ED8" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#BE123C" Tag="Foreground:#BE123C" Click="ApplyColorPresetButton_Click"/>
                          <Button Classes="swatch-button" Background="#047857" Tag="Foreground:#047857" Click="ApplyColorPresetButton_Click"/>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditCommonBorder}"
                                  Spacing="8">
                        <TextBlock Text="Граница"
                                   FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*,*">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Цвет"
                                       FontWeight="SemiBold"/>
                            <StackPanel Spacing="8">
                              <TextBox Tag="BorderBrush"
                                       Text="{Binding SelectedControl.BorderBrush, Mode=TwoWay}"
                                       TextChanged="SelectedTextPropertyTextChanged"/>
                              <Button Grid.Column="1"
                                      Tag="BorderBrush"
                                      Click="OpenColorPickerButton_Click"
                                      Classes="color-picker-button"
                                      ToolTip.Tip="Выбрать произвольный цвет">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                  <Border Width="22"
                                          Height="22"
                                          Background="{Binding SelectedControl.BorderBrush}"
                                          BorderBrush="#94A3B8"
                                          BorderThickness="1"
                                          CornerRadius="6"/>
                                  <TextBlock Text="Выбрать цвет"
                                             FontWeight="SemiBold"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                              </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        IsVisible="False">
                              <Button Classes="swatch-button" Background="#CBD5E1" Tag="BorderBrush:#CBD5E1" Click="ApplyColorPresetButton_Click"/>
                              <Button Classes="swatch-button" Background="#94A3B8" Tag="BorderBrush:#94A3B8" Click="ApplyColorPresetButton_Click"/>
                              <Button Classes="swatch-button" Background="#2563EB" Tag="BorderBrush:#2563EB" Click="ApplyColorPresetButton_Click"/>
                              <Button Classes="swatch-button" Background="#10B981" Tag="BorderBrush:#10B981" Click="ApplyColorPresetButton_Click"/>
                              <Button Classes="swatch-button" Background="#F59E0B" Tag="BorderBrush:#F59E0B" Click="ApplyColorPresetButton_Click"/>
                              <Button Classes="swatch-button" Background="#EF4444" Tag="BorderBrush:#EF4444" Click="ApplyColorPresetButton_Click"/>
                            </StackPanel>
                          </StackPanel>

                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Толщина"
                                       FontWeight="SemiBold"/>
                            <TextBox Tag="BorderThickness"
                                     Text="{Binding SelectedControl.BorderThickness, Mode=TwoWay}"
                                     TextChanged="SelectedNumericTextBox_TextChanged"/>
                          </StackPanel>
                        </Grid>

                        <StackPanel IsVisible="{Binding CanEditCornerRadius}"
                                    Spacing="4">
                          <TextBlock Text="Скругление углов"
                                     FontWeight="SemiBold"/>
                          <TextBox Tag="CornerRadius"
                                   Text="{Binding SelectedControl.CornerRadius, Mode=TwoWay}"
                                   TextChanged="SelectedNumericTextBox_TextChanged"/>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel IsVisible="False"
                                  Spacing="6">
                        <TextBlock Text="Пресеты кнопки"
                                   FontWeight="SemiBold"/>
                        <WrapPanel ItemWidth="132"
                                   Orientation="Horizontal">
                          <Button Content="Обычная"
                                  Margin="0,0,8,8"
                                  Tag="Button:Classic"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Глубокий синий"
                                  Margin="0,0,8,8"
                                  Tag="Button:DeepBlue"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Перелив"
                                  Margin="0,0,8,8"
                                  Tag="Button:Glass"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Ночная"
                                  Margin="0,0,8,8"
                                  Tag="Button:Night"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Изумруд"
                                  Margin="0,0,8,8"
                                  Tag="Button:Emerald"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                        </WrapPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanApplyDataGridVisualPresets}"
                                  Spacing="6">
                        <TextBlock Text="Пресеты DataGrid"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Готовые стили таблицы. Пресет применяет обычные свойства, поэтому после него можно вручную менять цвета, размеры и шрифты."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                        <WrapPanel ItemWidth="142"
                                   Orientation="Horizontal">
                          <Button Content="Классика"
                                  Margin="0,0,8,8"
                                  Tag="DataGrid:Classic"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Светло-синий"
                                  Margin="0,0,8,8"
                                  Tag="DataGrid:LightBlue"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Темная шапка"
                                  Margin="0,0,8,8"
                                  Tag="DataGrid:DarkHeader"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Компактный"
                                  Margin="0,0,8,8"
                                  Tag="DataGrid:Compact"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Удобный"
                                  Margin="0,0,8,8"
                                  Tag="DataGrid:Comfortable"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Корпоративный"
                                  Margin="0,0,8,8"
                                  Tag="DataGrid:Enterprise"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                          <Button Content="Минимальный"
                                  Margin="0,0,8,8"
                                  Tag="DataGrid:Minimal"
                                  Click="ApplyControlVisualPresetButton_Click"/>
                        </WrapPanel>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditCommonFont}"
                                  Spacing="8">
                        <TextBlock Text="Типографика"
                                   FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*,*">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Шрифт"
                                       FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                                      Tag="FontFamily"
                                      SelectedItem="{Binding SelectedControl.FontFamily, Mode=TwoWay}"
                                      SelectionChanged="SelectedComboBox_SelectionChanged"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Насыщенность"
                                       FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AvailableFontWeights}"
                                      Tag="FontWeight"
                                      SelectedItem="{Binding SelectedControl.FontWeight, Mode=TwoWay}"
                                      SelectionChanged="SelectedComboBox_SelectionChanged"/>
                          </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Размер шрифта"
                                       FontWeight="SemiBold"/>
                            <TextBox Tag="FontSize"
                                     Text="{Binding SelectedControl.FontSize, Mode=TwoWay}"
                                     TextChanged="SelectedNumericTextBox_TextChanged"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1"
                                      Spacing="4"
                                      IsVisible="{Binding CanEditPadding}">
                            <TextBlock Text="Внутренний отступ"
                                       FontWeight="SemiBold"/>
                            <TextBox Tag="Padding"
                                     Text="{Binding SelectedControl.Padding, Mode=TwoWay}"
                                     TextChanged="SelectedNumericTextBox_TextChanged"/>
                          </StackPanel>
                        </Grid>
                      </StackPanel>

                      <Border Background="#F8FAFC"
                              BorderBrush="#D7E2EE"
                              BorderThickness="1"
                              CornerRadius="12"
                              Padding="12"
                              IsVisible="{Binding HasDescriptorCustomProperties}">
                        <StackPanel Spacing="10">
                          <TextBlock Text="Дополнительные свойства"
                                     FontWeight="Bold"/>
                          <TextBlock Text="Этот блок собирается из descriptor-схемы выбранного контрола. Значения пишутся в custom properties и сразу влияют на preview."
                                     Foreground="#64748B"
                                     TextWrapping="Wrap"/>

                          <ItemsControl ItemsSource="{Binding DescriptorCustomPropertyEditors}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:DescriptorPropertyEditorViewModel">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#D7E2EE"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                  <StackPanel Spacing="8">
                                    <DockPanel LastChildFill="True">
                                      <TextBlock Text="{Binding Title}"
                                                 FontWeight="SemiBold"/>
                                      <Border Background="#EEF2FF"
                                              CornerRadius="999"
                                              Padding="8,2"
                                              HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Category}"
                                                   Foreground="#4338CA"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                      </Border>
                                    </DockPanel>

                                    <TextBlock Text="{Binding EditorHint}"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"/>

                                    <TextBox IsVisible="{Binding IsTextEditor}"
                                             Text="{Binding StringValue, Mode=TwoWay}"/>

                                    <StackPanel IsVisible="{Binding IsColorEditor}"
                                                Spacing="8">
                                      <TextBox Text="{Binding StringValue, Mode=TwoWay}"
                                               Watermark="#38BDF8"/>
                                      <Button Tag="{Binding Key}"
                                              Click="OpenColorPickerButton_Click"
                                              Classes="color-picker-button"
                                              ToolTip.Tip="Открыть палитру для custom property">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10">
                                          <Border Width="22"
                                                  Height="22"
                                                  Background="{Binding ColorPreviewValue}"
                                                  BorderBrush="#94A3B8"
                                                  BorderThickness="1"
                                                  CornerRadius="6"/>
                                          <TextBlock Text="Выбрать цвет"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                      </Button>
                                    </StackPanel>

                                    <TextBox IsVisible="{Binding IsNumberEditor}"
                                             Text="{Binding StringValue, Mode=TwoWay}"/>

                                    <CheckBox IsVisible="{Binding IsBoolEditor}"
                                              Content="Включено"
                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"/>

                                    <Grid IsVisible="{Binding IsEnumEditor}"
                                          ColumnDefinitions="*,Auto">
                                      <TextBlock Text="{Binding StringValue}"
                                                 Foreground="#334155"
                                                 VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis"
                                                 IsHitTestVisible="False"/>
                                      <Button Grid.Column="1"
                                              Classes="property-action"
                                              Content="..."
                                              Click="OpenDescriptorEnumButton_Click"
                                              ToolTip.Tip="Выбрать значение"/>
                                    </Grid>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>

                      <StackPanel IsVisible="{Binding CanEditSelectedLayoutGrid}"
                                  Spacing="8">
                        <TextBlock Text="Параметры Grid"
                                   FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*,*">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Колонки"
                                       FontWeight="SemiBold"/>
                            <TextBox Tag="Columns"
                                     Text="{Binding SelectedControl.Columns, Mode=TwoWay}"
                                     TextChanged="SelectedIntegerTextBox_TextChanged"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Строки"
                                       FontWeight="SemiBold"/>
                            <TextBox Tag="Rows"
                                     Text="{Binding SelectedControl.Rows, Mode=TwoWay}"
                                     TextChanged="SelectedIntegerTextBox_TextChanged"/>
                          </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                          <TextBlock Text="Отступ между ячейками"
                                     FontWeight="SemiBold"/>
                          <TextBox Tag="LayoutSpacing"
                                   Text="{Binding SelectedControl.LayoutSpacing, Mode=TwoWay}"
                                   TextChanged="SelectedNumericTextBox_TextChanged"/>
                        </StackPanel>

                        <CheckBox Content="Показывать линии сетки"
                                  IsChecked="{Binding SelectedControl.ShowGridLines, Mode=TwoWay}"/>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding CanEditClassicBindingEditor}"
                                  Spacing="8">
                        <TextBlock Text="Редактор привязки"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Выберите источник данных, затем поле для текстового контрола или проверьте preview данных для DataGrid."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>

                        <StackPanel Spacing="4">
                          <TextBlock Text="Источник данных"
                                     FontWeight="SemiBold"/>
                          <ComboBox ItemsSource="{Binding BindingSources}"
                                    SelectedItem="{Binding SelectedBindingSourceForControl, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="models:BindingSourceModel">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Name}"
                                             FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Path}"
                                             Foreground="#64748B"
                                             FontSize="12"/>
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4"
                                    IsVisible="{Binding CanChooseBindingField}">
                          <TextBlock Text="Поле"
                                     FontWeight="SemiBold"/>
                          <ComboBox ItemsSource="{Binding AvailableBindingFieldsForControl}"
                                    SelectedItem="{Binding SelectedBindingFieldForControl, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="models:BindingFieldModel">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Header}"
                                             FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Path}"
                                             Foreground="#64748B"
                                             FontSize="12"/>
                                  <TextBlock Text="{Binding SampleValue, StringFormat='Пример: {0}'}"
                                             Foreground="#64748B"
                                             FontSize="12"/>
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>

                        <CheckBox Content="Создавать колонки автоматически"
                                  Tag="AutoGenerateColumns"
                                  IsChecked="{Binding SelectedControl.AutoGenerateColumns, Mode=TwoWay}"
                                  Click="SelectedCheckBox_Click"
                                  IsVisible="{Binding CanEditDataBinding}"/>

                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                IsVisible="{Binding CanEditDataBinding}">
                          <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                              <TextBlock Text="Функции GridControl"
                                         FontWeight="Bold"
                                         FontSize="16"
                                         Foreground="#1D4ED8"/>
                              <TextBlock Text="Здесь включаются enterprise-возможности таблицы: фильтр под заголовками, панель группировки, сортировка и управление колонками."
                                         Foreground="#475569"
                                         TextWrapping="Wrap"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal">
                              <CheckBox Content="Строка фильтра"
                                        Tag="ShowFilterRow"
                                        IsChecked="{Binding SelectedControl.ShowFilterRow, Mode=TwoWay}"
                                        Click="SelectedCheckBox_Click"
                                        Margin="0,0,12,8"/>
                              <CheckBox Content="Панель группировки"
                                        Tag="ShowGroupPanel"
                                        IsChecked="{Binding SelectedControl.ShowGroupPanel, Mode=TwoWay}"
                                        Click="SelectedCheckBox_Click"
                                        Margin="0,0,12,8"/>
                              <CheckBox Content="Разрешить группировку"
                                        Tag="AllowGrouping"
                                        IsChecked="{Binding SelectedControl.AllowGrouping, Mode=TwoWay}"
                                        Click="SelectedCheckBox_Click"
                                        Margin="0,0,12,8"/>
                              <CheckBox Content="Строка итогов"
                                        Tag="ShowFooter"
                                        IsChecked="{Binding SelectedControl.ShowFooter, Mode=TwoWay}"
                                        Click="SelectedCheckBox_Click"
                                        Margin="0,0,12,8"/>
                            </WrapPanel>

                            <StackPanel Spacing="4">
                              <TextBlock Text="Режим фильтра"
                                         FontWeight="SemiBold"/>
                              <ComboBox ItemsSource="{Binding AvailableDataGridFilterModes}"
                                        Tag="FilterMode"
                                        SelectedItem="{Binding SelectedControl.FilterMode, Mode=TwoWay}"
                                        SelectionChanged="SelectedComboBox_SelectionChanged"/>
                            </StackPanel>

                            <TextBlock Text="Группировка задаётся у конкретной колонки ниже: включите чекбокс “Группа” и задайте Group #. Значение -1 выключает группировку."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC"
                                BorderBrush="#D7E2EE"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                          <TextBlock Text="{Binding SelectedBindingEditorSummary}"
                                     Foreground="#475569"
                                     TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel Spacing="6"
                                    IsVisible="{Binding HasSelectedBindingPreview}">
                          <TextBlock Text="{Binding SelectedBindingPreviewTitle}"
                                     FontWeight="SemiBold"/>

                          <ItemsControl ItemsSource="{Binding SelectedBindingPreviewFields}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:BindingFieldModel">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#D7E2EE"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0,0,8,8"
                                        Width="180">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Header}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Path}"
                                               Foreground="#64748B"
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding SampleValue}"
                                               TextWrapping="Wrap"
                                               Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding TypeName, StringFormat='Тип: {0}'}"
                                               Foreground="#64748B"
                                               FontSize="12"/>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <Border Background="#F8FAFC"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12"
                                IsVisible="{Binding HasGridColumnWidthEditor}">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding SelectedGridColumnEditorTitle}"
                                         FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding SelectedGridColumnCompactSummary}"
                                         Foreground="#475569"
                                         TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Редактировать колонки..."
                                    Classes="data-action-button"
                                    Padding="14,9"
                                    VerticalAlignment="Center"
                                    Click="OpenDataGridColumnEditorButton_Click"/>
                          </Grid>
                        </Border>

                        <StackPanel Spacing="8"
                                    IsVisible="False">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding SelectedGridColumnEditorTitle}"
                                         FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding SelectedGridColumnEditorSummary}"
                                         Foreground="#64748B"
                                         TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Одна ширина"
                                    Classes="data-action-button"
                                    Padding="12,8"
                                    Click="MakeSelectedGridColumnsEqualWidthButton_Click"/>
                          </Grid>

                          <ItemsControl ItemsSource="{Binding SelectedGridColumnsForControl}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:BindingFieldModel">
                                <Border Background="#F8FAFC"
                                        BorderBrush="#D7E2EE"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                  <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,140">
                                      <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}"
                                                   Foreground="#64748B"
                                                   FontSize="12"/>
                                      </StackPanel>

                                      <StackPanel Grid.Column="1"
                                                  Spacing="4">
                                        <TextBlock Text="Ширина"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBox Watermark="120 или 2*"
                                                 Text="{Binding Width, Mode=TwoWay}"/>
                                      </StackPanel>
                                    </Grid>

                                    <WrapPanel ItemWidth="84">
                                      <Button Content="Авто"
                                              Tag="*"
                                              Classes="data-action-button"
                                              Padding="10,6"
                                              Click="SetSelectedGridColumnWidthPresetButton_Click"/>
                                      <Button Content="120 px"
                                              Tag="120"
                                              Classes="data-action-button"
                                              Padding="10,6"
                                              Click="SetSelectedGridColumnWidthPresetButton_Click"/>
                                      <Button Content="180 px"
                                              Tag="180"
                                              Classes="data-action-button"
                                              Padding="10,6"
                                              Click="SetSelectedGridColumnWidthPresetButton_Click"/>
                                      <Button Content="240 px"
                                              Tag="240"
                                              Classes="data-action-button"
                                              Padding="10,6"
                                              Click="SetSelectedGridColumnWidthPresetButton_Click"/>
                                      <Button Content="1*"
                                              Tag="1*"
                                              Classes="data-action-button"
                                              Padding="10,6"
                                              Click="SetSelectedGridColumnWidthPresetButton_Click"/>
                                      <Button Content="2*"
                                              Tag="2*"
                                              Classes="data-action-button"
                                              Padding="10,6"
                                              Click="SetSelectedGridColumnWidthPresetButton_Click"/>
                                    </WrapPanel>

                                    <Grid ColumnDefinitions="*,*">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="Заголовок"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableColumnAlignments}"
                                                  SelectedItem="{Binding HeaderAlignment, Mode=TwoWay}"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="1"
                                                  Spacing="4">
                                        <TextBlock Text="Ячейки"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableColumnAlignments}"
                                                  SelectedItem="{Binding CellAlignment, Mode=TwoWay}"/>
                                      </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="Формат"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Watermark="N2, dd.MM.yyyy или {0:C}"
                                                 Text="{Binding FormatString, Mode=TwoWay}"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="1"
                                                  Spacing="4">
                                        <TextBlock Text="Текст Null"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Watermark="—"
                                                 Text="{Binding NullText, Mode=TwoWay}"/>
                                      </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="Итог"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableFieldSummaryTypes}"
                                                  SelectedItem="{Binding SummaryType, Mode=TwoWay}"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="1"
                                                  Spacing="4">
                                        <TextBlock Text="Формат итога"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Watermark="Итого: {0:N2}"
                                                 Text="{Binding SummaryFormat, Mode=TwoWay}"/>
                                      </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,70,80,80">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="Обрезка"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableColumnTextTrimmings}"
                                                  SelectedItem="{Binding TextTrimming, Mode=TwoWay}"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="1"
                                                  Spacing="4">
                                        <TextBlock Text="Перенос"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableColumnTextWrappings}"
                                                  SelectedItem="{Binding TextWrapping, Mode=TwoWay}"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="2"
                                                  Spacing="4">
                                        <TextBlock Text="Строк"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Watermark="1"
                                                 Text="{Binding MaxLines, Mode=TwoWay}"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="3"
                                                  Spacing="4">
                                        <TextBlock Text="Мин."
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Watermark="56"
                                                 Text="{Binding MinWidth, Mode=TwoWay}"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="4"
                                                  Spacing="4">
                                        <TextBlock Text="Макс."
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Watermark="0"
                                                 Text="{Binding MaxWidth, Mode=TwoWay}"/>
                                      </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="8">
                                      <WrapPanel Orientation="Horizontal">
                                        <CheckBox Content="Изменять размер"
                                                  IsChecked="{Binding AllowResize, Mode=TwoWay}"
                                                  Margin="0,0,12,8"/>
                                        <CheckBox Content="Сортировка"
                                                  IsChecked="{Binding AllowSort, Mode=TwoWay}"
                                                  Margin="0,0,12,8"/>
                                        <CheckBox Content="Фильтр"
                                                  IsChecked="{Binding AllowFilter, Mode=TwoWay}"
                                                  Margin="0,0,12,8"/>
                                        <CheckBox Content="Группа"
                                                  IsChecked="{Binding IsGrouped, Mode=TwoWay}"
                                                  Margin="0,0,12,8"/>
                                      </WrapPanel>

                                      <Grid ColumnDefinitions="*,*">
                                        <StackPanel Spacing="4">
                                          <TextBlock Text="Порядок группы"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"/>
                                          <TextBox Watermark="-1"
                                                   IsEnabled="{Binding IsGrouped}"
                                                   Text="{Binding GroupOrder, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="4">
                                          <TextBlock Text="Порядок колонки"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"/>
                                          <TextBox Watermark="VisibleIndex"
                                                   Text="{Binding VisibleIndex, Mode=TwoWay}"/>
                                        </StackPanel>
                                      </Grid>
                                    </StackPanel>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="{Binding Texts.Data}">
            <ScrollViewer Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <Border Background="#FFFFFF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        IsVisible="{Binding CanShowDataGridDataSetup}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="1">
                        <TextBlock Text="DataGrid data setup"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="{Binding DataGridDataSetupSummary}"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <Border Grid.Column="1"
                              Background="#EFF6FF"
                              BorderBrush="#BFDBFE"
                              BorderThickness="1"
                              CornerRadius="999"
                              Padding="7,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedDataGridColumnCountText}"
                                   Foreground="#1D4ED8"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <ComboBox Classes="property-editor"
                                ItemsSource="{Binding BindingSources}"
                                SelectedItem="{Binding SelectedBindingSourceForControl, Mode=TwoWay}"
                                ToolTip.Tip="BindingSource used by selected DataGrid">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="models:BindingSourceModel">
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1"
                              Content="{Binding Texts.Create}"
                              Classes="property-header-action"
                              Command="{Binding CreateBindingSourceForSelectedControlCommand}"
                              ToolTip.Tip="Create BindingSource and attach it to this DataGrid"/>
                      <Button Grid.Column="2"
                              Content="{Binding Texts.Fields}"
                              Classes="property-header-action"
                              Command="{Binding CreateColumnsFromSelectedBindingSourceCommand}"
                              ToolTip.Tip="Create/normalize columns from the selected BindingSource"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <CheckBox Content="AutoGenerateColumns"
                                Tag="AutoGenerateColumns"
                                IsChecked="{Binding SelectedControl.AutoGenerateColumns, Mode=TwoWay}"
                                Click="SelectedCheckBox_Click"
                                VerticalAlignment="Center"/>
                      <Button Grid.Column="1"
                              Content="{Binding Texts.EditColumns}"
                              Classes="data-action-button"
                              Padding="8,4"
                              Click="OpenDataGridColumnEditorButton_Click"/>
                    </Grid>

                    <Border Background="#FFFBEB"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            IsVisible="{Binding HasSelectedDataGridBindingWarning}">
                      <TextBlock Text="{Binding SelectedDataGridBindingWarning}"
                                 Foreground="#92400E"
                                 FontSize="11"
                                 TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                      <Button Content="{Binding Texts.OpenLogic}"
                              Classes="property-header-action"
                              Command="{Binding OpenLogicForSelectedControlCommand}"
                              ToolTip.Tip="Open interactions for this DataGrid"/>
                      <Button Content="{Binding Texts.OpenFullDataTools}"
                              Classes="property-header-action"
                              Command="{Binding OpenBindingSourceEditorCommand}"
                              ToolTip.Tip="Go to the full BindingSource editor"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Источники данных"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Опишите коллекции один раз и переиспользуйте их для DataGrid на форме."
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                      </StackPanel>

                      <WrapPanel Orientation="Horizontal"
                                 ItemHeight="44">
                        <Button Content="Добавить"
                                Classes="data-action-button"
                                Click="AddBindingSourceButton_Click"
                                Margin="0,0,8,8"
                                Padding="14,10"/>

                        <Button Content="SQL Server..."
                                Classes="data-action-button"
                                Click="AddSqlBindingSourceButton_Click"
                                Margin="0,0,8,8"
                                Padding="14,10"/>

                        <Button Content="Удалить"
                                Classes="data-action-button"
                                Click="RemoveBindingSourceButton_Click"
                                IsEnabled="{Binding HasSelectedBindingSource}"
                                Margin="0,0,8,8"
                                Padding="14,10"/>

                        <Button Content="Импорт DLL..."
                                Classes="data-action-button"
                                Click="ImportBindingSourcesFromAssemblyButton_Click"
                                Margin="0,0,8,8"
                                Padding="14,10"/>
                      </WrapPanel>
                    </StackPanel>

                    <!-- Список всех доступных BindingSource документа. -->
                    <ListBox ItemsSource="{Binding BindingSources}"
                             SelectedItem="{Binding SelectedBindingSource, Mode=TwoWay}"
                             MaxHeight="220">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:BindingSourceModel">
                          <Border Margin="0,0,0,8"
                                  Padding="10"
                                  Background="#F8FAFC"
                                  BorderBrush="#D7E2EE"
                                  BorderThickness="1"
                                  CornerRadius="12">
                            <StackPanel Spacing="4">
                              <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ItemTypeName}"
                                           Foreground="#64748B"/>
                              </DockPanel>
                              <TextBlock Text="{Binding Path}"
                                         Foreground="#475569"/>
                              <TextBlock Text="{Binding Description}"
                                         Foreground="#64748B"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>

                <Border Background="#EFF6FF"
                        BorderBrush="#93C5FD"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        IsVisible="{Binding HasNoSelectedBindingSource}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Подключение через строку подключения"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="Нажмите «SQL Server...», затем укажите connection string и таблицу или SQL-запрос. После кнопки «Подтянуть из БД» дизайнер создаст поля BindingSource для DataGrid."
                               Foreground="#334155"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Если SQL Server ругается на сертификат, добавьте в строку подключения TrustServerCertificate=True."
                               Foreground="#1D4ED8"
                               TextWrapping="Wrap"/>
                    <Button Content="Создать SQL BindingSource"
                            Classes="data-action-button"
                            Click="AddSqlBindingSourceButton_Click"
                            HorizontalAlignment="Left"
                            Padding="14,10"/>
                  </StackPanel>
                </Border>

                <!-- Детальная настройка выбранного источника:
                     базовые поля, импорт схемы из SQL и редактирование списка колонок. -->
                <Border Background="White"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        IsVisible="{Binding HasSelectedBindingSource}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Параметры источника"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <StackPanel Spacing="4">
                      <TextBlock Text="Имя"
                                 FontWeight="SemiBold"/>
                      <TextBox Text="{Binding SelectedBindingSource.Name, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Text="Путь привязки"
                                 FontWeight="SemiBold"/>
                      <TextBox Text="{Binding SelectedBindingSource.Path, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Text="Тип элемента"
                                 FontWeight="SemiBold"/>
                      <TextBox Text="{Binding SelectedBindingSource.ItemTypeName, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Text="Описание"
                                 FontWeight="SemiBold"/>
                      <TextBox Text="{Binding SelectedBindingSource.Description, Mode=TwoWay}"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               MinHeight="72"/>
                    </StackPanel>

                    <Border Background="#F8FAFC"
                            BorderBrush="#D7E2EE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Подключение к SQL Server"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Если DLL с сущностями пока нет, укажите строку подключения и таблицу или SQL-запрос. Дизайнер подтянет колонки и примерные значения прямо из БД."
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>

                        <StackPanel Spacing="4">
                          <TextBlock Text="Строка подключения"
                                     FontWeight="SemiBold"/>
                          <TextBox Text="{Binding SelectedBindingSource.SourceConnectionString, Mode=TwoWay}"
                                   Watermark="Server=.;Database=DemoDb;Trusted_Connection=True;TrustServerCertificate=True"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Схема"
                                       FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBindingSource.SourceSchemaName, Mode=TwoWay}"
                                     Watermark="dbo"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Таблица"
                                       FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBindingSource.SourceTableName, Mode=TwoWay}"
                                     Watermark="Customers"/>
                          </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                          <TextBlock Text="SQL-запрос (необязательно)"
                                     FontWeight="SemiBold"/>
                          <TextBox Text="{Binding SelectedBindingSource.SourceQuery, Mode=TwoWay}"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap"
                                   MinHeight="72"
                                   Watermark="SELECT Id, Name FROM dbo.Customers"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal"
                                   ItemHeight="44"
                                   ItemWidth="160">
                          <Button Content="Подтянуть из БД"
                                  Classes="data-action-button"
                                  Click="RefreshBindingSourceFromDatabaseButton_Click"/>
                          <Button Content="Очистить SQL-запрос"
                                  Classes="data-action-button"
                                  Click="ClearBindingSourceQueryButton_Click"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>

                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            IsVisible="{Binding HasSelectedBindingSourceImportMetadata}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Источник схемы"
                                   FontWeight="Bold"
                                   Foreground="#1D4ED8"/>
                        <TextBlock Text="{Binding SelectedBindingSourceImportSummary}"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto"
                          IsVisible="False">
                      <TextBlock Text="Поля"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"/>
                      <Button Grid.Column="1"
                              Content="Очистить группировку"
                              Command="{Binding ClearSelectedBindingSourceGroupingCommand}"
                              Classes="data-action-button"
                              Padding="14,10"/>
                      <Button Grid.Column="2"
                              Content="Добавить поле"
                              Click="AddBindingFieldButton_Click"
                              Classes="data-action-button"
                              Padding="14,10"/>
                    </Grid>

                    <TextBlock IsVisible="False"
                               Text="Флажок Visible скрывает колонку. Sort # задает порядок сортировки по нескольким полям, Group # задает порядок группировки. Значение -1 отключает сортировку или группировку."
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>

                    <Border Background="#F8FAFC"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Колонки DataGrid редактируются в Column Editor"
                                   FontWeight="Bold"
                                   Foreground="#1D4ED8"/>
                        <TextBlock Text="Data mode теперь показывает источник, SQL/DLL metadata и sample/schema summary. Реальные колонки выбранного DataGrid меняются через отдельный редактор, чтобы Apply/Cancel были предсказуемыми."
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                        <Button Content="Open Column Editor"
                                Classes="data-action-button"
                                HorizontalAlignment="Left"
                                Padding="14,10"
                                Click="OpenDataGridColumnEditorButton_Click"/>
                      </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding SelectedBindingSource.Fields}"
                                  IsVisible="False">
                      <!-- Каждое поле описывает одну колонку будущего DataGrid:
                           заголовок, путь привязки, пример значения, сортировку и группировку. -->
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BindingFieldModel">
                          <Border Margin="0,0,0,8"
                                  Padding="10"
                                  Background="#F8FAFC"
                                  BorderBrush="#D7E2EE"
                                  BorderThickness="1"
                                  CornerRadius="12">
                            <StackPanel Spacing="8">
                              <Grid ColumnDefinitions="*,*,*,90,Auto">
                                <TextBox Watermark="Заголовок"
                                         Text="{Binding Header, Mode=TwoWay}"/>
                                <TextBox Grid.Column="1"
                                         Watermark="Путь"
                                         Text="{Binding Path, Mode=TwoWay}"/>
                                <TextBox Grid.Column="2"
                                         Watermark="Пример"
                                         Text="{Binding SampleValue, Mode=TwoWay}"/>
                                <TextBox Grid.Column="3"
                                         Watermark="Ширина"
                                         Text="{Binding Width, Mode=TwoWay}"/>
                                <Button Grid.Column="4"
                                        Content="Удалить"
                                        Classes="data-action-button"
                                        Click="RemoveBindingFieldButton_Click"/>
                              </Grid>

                              <StackPanel Spacing="8">
                                <WrapPanel Orientation="Horizontal">
                                  <CheckBox Content="Видима"
                                            IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                            Margin="0,0,12,8"/>
                                  <CheckBox Content="Сортировка"
                                            IsChecked="{Binding AllowSort, Mode=TwoWay}"
                                            Margin="0,0,12,8"/>
                                  <CheckBox Content="Размер"
                                            IsChecked="{Binding AllowResize, Mode=TwoWay}"
                                            Margin="0,0,12,8"/>
                                  <CheckBox Content="Фильтр"
                                            IsChecked="{Binding AllowFilter, Mode=TwoWay}"
                                            Margin="0,0,12,8"/>
                                  <CheckBox Content="Группа"
                                            IsChecked="{Binding IsGrouped, Mode=TwoWay}"
                                            Margin="0,0,12,8"/>
                                </WrapPanel>

                                <Grid ColumnDefinitions="*,80,80">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="Направление сортировки"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableFieldSortDirections}"
                                              SelectedItem="{Binding SortDirection, Mode=TwoWay}"/>
                                  </StackPanel>
                                  <StackPanel Grid.Column="1"
                                              Spacing="4">
                                    <TextBlock Text="Сортировка #"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBox Watermark="-1"
                                             Text="{Binding SortOrder, Mode=TwoWay}"/>
                                  </StackPanel>
                                  <StackPanel Grid.Column="2"
                                              Spacing="4">
                                    <TextBlock Text="Группа #"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBox Watermark="-1"
                                             IsEnabled="{Binding IsGrouped}"
                                             Text="{Binding GroupOrder, Mode=TwoWay}"/>
                                  </StackPanel>
                                </Grid>
                              </StackPanel>

                              <Grid ColumnDefinitions="*,*,*">
                                <StackPanel Spacing="4">
                                  <TextBlock Text="Заголовок"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableColumnAlignments}"
                                            SelectedItem="{Binding HeaderAlignment, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Spacing="4">
                                  <TextBlock Text="Ячейки"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableColumnAlignments}"
                                            SelectedItem="{Binding CellAlignment, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Spacing="4">
                                  <TextBlock Text="Порядок"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <TextBox Watermark="-1"
                                           Text="{Binding VisibleIndex, Mode=TwoWay}"/>
                                </StackPanel>
                              </Grid>

                              <Grid ColumnDefinitions="*,*">
                                <StackPanel Spacing="4">
                                  <TextBlock Text="Формат"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <TextBox Watermark="N2, dd.MM.yyyy или {0:C}"
                                           Text="{Binding FormatString, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Spacing="4">
                                  <TextBlock Text="Текст Null"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <TextBox Watermark="—"
                                           Text="{Binding NullText, Mode=TwoWay}"/>
                                </StackPanel>
                              </Grid>

                              <Grid ColumnDefinitions="*,*">
                                <StackPanel Spacing="4">
                                  <TextBlock Text="Итог"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableFieldSummaryTypes}"
                                            SelectedItem="{Binding SummaryType, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Spacing="4">
                                  <TextBlock Text="Формат итога"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <TextBox Watermark="Итого: {0:N2}"
                                           Text="{Binding SummaryFormat, Mode=TwoWay}"/>
                                </StackPanel>
                              </Grid>

                              <Grid ColumnDefinitions="*,*,80,90,90">
                                <StackPanel Spacing="4">
                                  <TextBlock Text="Обрезка"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableColumnTextTrimmings}"
                                            SelectedItem="{Binding TextTrimming, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Spacing="4">
                                  <TextBlock Text="Перенос"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <ComboBox ItemsSource="{Binding #RootWindow.DataContext.AvailableColumnTextWrappings}"
                                            SelectedItem="{Binding TextWrapping, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Spacing="4">
                                  <TextBlock Text="Строк"
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <TextBox Watermark="1"
                                           Text="{Binding MaxLines, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3"
                                            Spacing="4">
                                  <TextBlock Text="Мин."
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <TextBox Watermark="56"
                                           Text="{Binding MinWidth, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4"
                                            Spacing="4">
                                  <TextBlock Text="Макс."
                                             FontSize="12"
                                             FontWeight="SemiBold"/>
                                  <TextBox Watermark="0"
                                           Text="{Binding MaxWidth, Mode=TwoWay}"/>
                                </StackPanel>
                              </Grid>

                              <TextBlock Text="{Binding TypeName, StringFormat='Тип: {0}'}"
                                         Foreground="#64748B"
                                         FontSize="12"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Мастер привязок генерирует текстовые подсказки и помогает быстро собрать CRUD-связки. -->
                <Border Background="White"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                  <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Мастер привязок"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Подсказки ниже помогают быстро связать DataGrid, TextBox и кнопки в CRUD-сценарий."
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                      </StackPanel>

                      <Button Grid.Column="1"
                              Content="Применить привязки"
                              Command="{Binding ApplySuggestedBindingsCommand}"
                              Classes="data-action-button"
                              Padding="14,10"
                              VerticalAlignment="Top"/>
                    </Grid>

                    <TextBox Grid.Row="1"
                             Text="{Binding GeneratedBindingGuide}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             MinHeight="220"/>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{Binding Texts.Layout}"
                   IsVisible="{Binding IsLayoutTabVisible}">
            <Grid RowDefinitions="Auto,*"
                  Margin="0,8,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="property-editor"
                         Watermark="Search layout..."
                         Text="{Binding PropertyGridSearchText, Mode=TwoWay}"/>
                <Button Grid.Column="1"
                        Classes="property-header-action"
                        Content="X"
                        Command="{Binding ClearPropertyGridSearchCommand}"/>
              </Grid>

              <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">
                  <Border Background="#F8FAFC"
                          BorderBrush="#D7E2EE"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="10"
                          IsVisible="{Binding HasNoPropertyGridRows}">
                    <TextBlock Text="{Binding PropertyGridEmptyText}"
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>
                  </Border>

                  <Border Classes="property-grid-table"
                          IsVisible="{Binding HasPropertyGridRows}">
                    <ItemsControl ItemsSource="{Binding PropertyGridCategories}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PropertyGridCategoryViewModel">
                          <StackPanel>
                            <ToggleButton Classes="property-category-header"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                              <Grid ColumnDefinitions="14,*">
                                <TextBlock Text="{Binding ExpandGlyph}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding HeaderText}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"/>
                              </Grid>
                            </ToggleButton>

                            <ItemsControl ItemsSource="{Binding Rows}"
                                          IsVisible="{Binding IsExpanded}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PropertyGridRowViewModel">
                                  <Border Classes="property-row"
                                          ToolTip.Tip="{Binding Description}">
                                    <Grid ColumnDefinitions="18,112,*,Auto,Auto"
                                          MinHeight="28">
                                      <Button Classes="property-star"
                                              Content="{Binding FavoriteGlyph}"
                                              Command="{Binding #RootWindow.DataContext.TogglePropertyGridFavoriteCommand}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="Toggle favorite"/>
                                      <TextBlock Grid.Column="1"
                                                 FontSize="12"
                                                 Foreground="#334155"
                                                 VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis"
                                                 IsHitTestVisible="False">
                                        <TextBlock.Text>
                                          <MultiBinding StringFormat="{}{0}{1}">
                                            <Binding Path="ModifiedGlyph"/>
                                            <Binding Path="Label"/>
                                          </MultiBinding>
                                        </TextBlock.Text>
                                      </TextBlock>
                                      <Border Grid.Column="2"
                                              BorderBrush="#E5E7EB"
                                              BorderThickness="1,0,0,0"
                                              Padding="6,1,0,1">
                                        <Grid MinWidth="116">
                                          <controls:PropertyGridTextEditor Classes="property-editor"
                                                                           Row="{Binding}"
                                                                           MinWidth="80"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding IsTextEditor}"/>
                                          <controls:PropertyGridTextEditor Classes="property-editor"
                                                                           Row="{Binding}"
                                                                           MinWidth="80"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding IsNumberEditor}"/>
                                          <CheckBox IsVisible="{Binding IsBoolEditor}"
                                                    IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"/>
                                          <Grid IsVisible="{Binding IsEnumEditor}"
                                                ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Value}"
                                                       Foreground="#334155"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False"/>
                                            <Button Grid.Column="1"
                                                    Classes="property-action"
                                                    Content="..."
                                                    Click="PropertyGridOptionButton_Click"
                                                    ToolTip.Tip="Select value"/>
                                          </Grid>
                                          <TextBlock Text="{Binding Value}"
                                                     IsVisible="{Binding IsReadOnlyEditor}"
                                                     Foreground="#475569"
                                                     FontSize="12"
                                                     VerticalAlignment="Center"
                                                     TextTrimming="CharacterEllipsis"
                                                     IsHitTestVisible="False"/>
                                        </Grid>
                                      </Border>
                                      <Button Grid.Column="3"
                                              Classes="property-action"
                                              Content="↺"
                                              IsVisible="{Binding CanResetToDefault}"
                                              Click="PropertyGridResetButton_Click"
                                              ToolTip.Tip="{Binding DefaultTooltip}"/>

                                      <TextBlock Grid.Column="4"
                                                 Text="!"
                                                 FontWeight="Bold"
                                                 Foreground="#DC2626"
                                                 IsVisible="{Binding HasValidationError}"
                                                 ToolTip.Tip="{Binding ValidationMessage}"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"/>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="{Binding Texts.Plugins}">
            <ScrollViewer Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <Border Background="White"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Плагины конструктора"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="Сюда устанавливаются DLL-плагины, которые добавляют новые Avalonia-компоненты в набор элементов. Это не импорт моделей данных и не DevExpress DLL «как есть», а именно расширения под наш контракт плагинов."
                               Foreground="#475569"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <Button Content="Установить плагин..."
                              Classes="data-action-button"
                              Click="InstallPluginButton_Click"
                              Padding="14,10"/>
                      <Button Content="Reload plugins"
                              Classes="data-action-button"
                              Command="{Binding ReloadPluginsCommand}"
                              Padding="14,10"/>
                    </StackPanel>

                    <Border Background="#F8FAFC"
                            BorderBrush="#D7E2EE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Папка плагинов"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PluginInstallFolderPath}"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding InstalledPluginsSummary}"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PluginDiagnosticsSummary}"
                                   Foreground="#1D4ED8"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Установленные плагины"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <ItemsControl ItemsSource="{Binding InstalledPlugins}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:InstalledPluginInfoModel">
                          <Border Margin="0,0,0,8"
                                  Padding="12"
                                  Background="#F8FAFC"
                                  BorderBrush="#D7E2EE"
                                  BorderThickness="1"
                                  CornerRadius="12">
                            <StackPanel Spacing="6">
                              <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding PluginName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <Border Background="{Binding StatusBadgeBackground}"
                                        BorderBrush="{Binding StatusBadgeBorder}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="8,2"
                                        HorizontalAlignment="Right">
                                  <TextBlock Text="{Binding Status}"
                                             Foreground="{Binding StatusBadgeForeground}"
                                             FontSize="11"
                                             FontWeight="SemiBold"/>
                                </Border>
                              </DockPanel>

                              <TextBlock Text="{Binding PluginId, StringFormat='Id: {0}'}"
                                         Foreground="#64748B"/>

                              <TextBlock Text="{Binding Version, StringFormat='Версия: {0}'}"
                                         Foreground="#64748B"/>

                              <TextBlock Text="{Binding ApiVersion, StringFormat='SDK API: {0}'}"
                                         Foreground="#64748B"/>

                              <TextBlock Text="{Binding AssemblyPath}"
                                         Foreground="#64748B"
                                         FontSize="12"
                                         TextWrapping="Wrap"/>

                              <StackPanel Spacing="2">
                                <TextBlock Text="Контролы"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ControlsSummary}"
                                           Foreground="#475569"
                                           TextWrapping="Wrap"/>
                              </StackPanel>

                              <Border Background="#FFF7ED"
                                      BorderBrush="#FDBA74"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="8"
                                      IsVisible="{Binding HasErrorDetails}">
                                <TextBlock Text="{Binding ErrorDetails}"
                                           Foreground="#9A3412"
                                           TextWrapping="Wrap"/>
                              </Border>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#D7E2EE"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Компоненты плагинов"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="Перетаскивайте эти карточки на форму так же, как обычные элементы из левого набора компонентов. Demo DevButton находится здесь."
                               Foreground="#475569"
                               TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding PluginToolboxItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolboxItem">
                          <Border Margin="0,0,0,8"
                                  Padding="12"
                                  Background="#F8FAFC"
                                  BorderBrush="#BFDBFE"
                                  BorderThickness="1"
                                  CornerRadius="14"
                                  PointerPressed="ToolboxItem_PointerPressed">
                            <StackPanel Spacing="4">
                              <DockPanel LastChildFill="True">
                                <Border Background="#DBEAFE"
                                        CornerRadius="999"
                                        Padding="8,2"
                                        HorizontalAlignment="Left">
                                  <TextBlock Text="{Binding Category}"
                                             Foreground="#1D4ED8"
                                             FontSize="11"
                                             FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Type}"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           HorizontalAlignment="Right"/>
                              </DockPanel>

                              <TextBlock Text="{Binding Title}"
                                         FontSize="17"
                                         FontWeight="SemiBold"/>

                              <TextBlock Text="{Binding Description}"
                                         Foreground="#475569"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{Binding Texts.Export}">
            <ScrollViewer Margin="0,10,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <Border Classes="export-card">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Сводка Export"
                               FontSize="16"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding ExportPipelineCompactSummary}"
                               Foreground="#475569"
                               TextWrapping="Wrap"/>
                    <WrapPanel>
                      <Border Classes="export-badge">
                        <TextBlock Text="{Binding ExportDataGridBadgeText}"
                                   Foreground="#1D4ED8"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                      </Border>
                      <Border Classes="export-badge">
                        <TextBlock Text="{Binding ExportLayoutBadgeText}"
                                   Foreground="#1D4ED8"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                      </Border>
                      <Border Classes="export-badge">
                        <TextBlock Text="{Binding ExportValidationStatusText}"
                                   Foreground="{Binding ExportValidationStatusForeground}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                      </Border>
                    </WrapPanel>
                    <Button Content="{Binding Texts.ExportPipeline}"
                            Classes="export-primary"
                            Command="{Binding OpenExportPipelineEditorCommand}"
                            ToolTip.Tip="{Binding OpenExportPipelineEditorCommand.Hint}"
                            HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </Border>

                <Border Classes="export-card">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Быстрые действия"
                               FontWeight="Bold"
                               FontSize="14"/>
                    <WrapPanel>
                      <Button Content="{Binding Texts.Refresh}"
                              Classes="export-secondary"
                              Command="{Binding RefreshGeneratedCodeEditorCommand}"
                              ToolTip.Tip="{Binding RefreshGeneratedCodeEditorCommand.Hint}"
                              MinWidth="84"
                              Padding="10,6"
                              Margin="0,0,6,6"/>
                      <Button Content="{Binding Texts.ValidateBuild}"
                              Classes="export-secondary"
                              Command="{Binding ValidateExportBuildEditorCommand}"
                              ToolTip.Tip="{Binding ValidateExportBuildEditorCommand.Hint}"
                              MinWidth="86"
                              Padding="10,6"
                              Margin="0,0,6,6"/>
                      <Button Content="ZIP"
                              Classes="export-secondary"
                              Command="{Binding ExportAsZipEditorCommand}"
                              ToolTip.Tip="{Binding ExportAsZipEditorCommand.Hint}"
                              MinWidth="56"
                              Padding="10,6"
                              Margin="0,0,6,6"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Expander Header="Export profile"
                          IsExpanded="True">
                  <Border Classes="export-card"
                          Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="96,*">
                        <TextBlock Text="Target"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableExportTargets}"
                                  SelectedItem="{Binding ExportTarget, Mode=TwoWay}"
                                  MinWidth="0"
                                  HorizontalAlignment="Stretch"/>
                      </Grid>
                      <Grid ColumnDefinitions="96,*">
                        <TextBlock Text="Namespace"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Watermark="AvaloniaApplication1"
                                 Text="{Binding ExportProjectNamespace, Mode=TwoWay}"/>
                      </Grid>
                      <Grid ColumnDefinitions="96,*">
                        <TextBlock Text="Layout"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableLayoutExportModes}"
                                  SelectedItem="{Binding LayoutExportMode, Mode=TwoWay}"
                                  MinWidth="0"
                                  HorizontalAlignment="Stretch"/>
                      </Grid>
                      <Grid ColumnDefinitions="96,*">
                        <TextBlock Text="DataGrid"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableDataGridExportModes}"
                                  SelectedItem="{Binding DataGridExportMode, Mode=TwoWay}"
                                  MinWidth="0"
                                  HorizontalAlignment="Stretch"/>
                      </Grid>
                      <WrapPanel>
                        <CheckBox Content="Comments"
                                  Margin="0,0,12,6"
                                  IsChecked="{Binding IncludeExportComments, Mode=TwoWay}"/>
                        <CheckBox Content="Demo data"
                                  Margin="0,0,12,6"
                                  IsChecked="{Binding IncludeSampleData, Mode=TwoWay}"/>
                      </WrapPanel>
                      <Border Background="#F8FAFC"
                              BorderBrush="#D7E2EE"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="10">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Настройки"
                                     FontWeight="Bold"/>
                          <CheckBox Content="Показывать runtime-плашку в Preview"
                                    IsChecked="{Binding ShowPreviewRuntimeBadge, Mode=TwoWay}"/>
                          <CheckBox Content="Включить экспериментальную вкладку Layout"
                                    IsChecked="{Binding EnableExperimentalLayoutTab, Mode=TwoWay}"/>
                          <CheckBox Content="Подробные Build logs"
                                    IsChecked="{Binding VerboseBuildLogs, Mode=TwoWay}"/>
                          <CheckBox Content="Сохранять logs в файл"
                                    IsChecked="{Binding SaveLogsToFile, Mode=TwoWay}"/>
                          <CheckBox Content="Автоматически очищать старые artifacts"
                                    IsChecked="{Binding CleanOldArtifactsAutomatically, Mode=TwoWay}"/>
                        </StackPanel>
                      </Border>
                      <Border Background="#F8FAFC"
                              BorderBrush="#BFDBFE"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="10">
                        <StackPanel Spacing="7">
                          <TextBlock Text="NuGet"
                                     FontWeight="Bold"/>
                          <CheckBox Content="Использовать пользовательский NuGet source"
                                    IsChecked="{Binding UseCustomNuGetSource, Mode=TwoWay}"/>
                          <TextBox Watermark="https://api.nuget.org/v3/index.json or C:\packages"
                                   Text="{Binding CustomNuGetSource, Mode=TwoWay}"
                                   IsEnabled="{Binding UseCustomNuGetSource}"/>
                          <CheckBox Content="Разрешить HTTP source"
                                    IsChecked="{Binding AllowInsecureNuGetSource, Mode=TwoWay}"
                                    IsEnabled="{Binding UseCustomNuGetSource}"/>
                          <TextBlock Text="{Binding NuGetSourceSummaryText}"
                                     Foreground="#475569"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
                          <WrapPanel>
                            <Button Content="Проверить source"
                                    Classes="export-secondary"
                                    Command="{Binding TestNuGetSourceCommand}"
                                    Margin="0,0,6,6"/>
                            <Button Content="Очистить"
                                    Classes="export-secondary"
                                    Command="{Binding ClearNuGetSourceCommand}"
                                    Margin="0,0,6,6"/>
                          </WrapPanel>
                          <TextBlock Text="{Binding NuGetSourceTestStatusText}"
                                     Foreground="#64748B"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasNuGetSourceTestStatus}"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </Expander>

                <Border Classes="export-card">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Статус Build"
                               FontWeight="Bold"
                               FontSize="14"/>
                    <TextBlock Text="{Binding ExportValidationStatusText}"
                               Foreground="{Binding ExportValidationStatusForeground}"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding ExportValidationProjectPath}"
                               Foreground="#64748B"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CurrentExportBuildValidation.StepSummary}"
                               Foreground="#334155"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasExportValidationProjectPath}"/>
                    <TextBlock Text="{Binding CurrentExportBuildValidation.DetailedLogPath}"
                               Foreground="#64748B"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasExportValidationProjectPath}"/>
                    <WrapPanel>
                      <Button Content="{Binding Texts.OpenValidationFolder}"
                              Classes="export-secondary"
                              Command="{Binding OpenValidationFolderEditorCommand}"
                              ToolTip.Tip="{Binding OpenValidationFolderEditorCommand.Hint}"
                              Margin="0,0,6,6"/>
                      <Button Content="Копировать logs"
                              Classes="export-secondary"
                              Click="CopyBuildLogsButton_Click"
                              Margin="0,0,6,6"/>
                      <Button Content="Открыть папку logs"
                              Classes="export-secondary"
                              Click="OpenBuildLogsFolderButton_Click"
                              Margin="0,0,6,6"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{Binding Texts.Logic}">
            <ScrollViewer Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Логика формы"
                                 FontSize="18"
                                 FontWeight="Bold"/>
                      <TextBlock Text="{Binding LogicDesignerSummary}"
                                 Foreground="#475569"
                                 TextWrapping="Wrap"/>
                      <TextBlock Text="Правило состоит из трёх частей: источник и событие → действие → цель. Внутренние technical names скрыты, чтобы не мешать."
                                 Foreground="#64748B"
                                 FontSize="12"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Добавить"
                            Command="{Binding AddInteractionCommand}"
                            Padding="14,9"
                            VerticalAlignment="Top"/>
                  </Grid>
                </Border>

                <Border Classes="card"
                        IsVisible="{Binding HasLogicQuickActions}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Быстрые действия"
                               FontSize="14"
                               FontWeight="Bold"/>
                    <WrapPanel>
                      <Button Content="Показать сообщение"
                              Command="{Binding AddShowMessageInteractionForSelectedCommand}"
                              IsVisible="{Binding CanQuickAddButtonShowMessageInteraction}"
                              Padding="10,7"
                              Margin="0,0,8,8"/>
                      <Button Content="Открыть другую Form"
                              Command="{Binding AddOpenFormInteractionForSelectedCommand}"
                              IsVisible="{Binding CanQuickAddButtonOpenFormInteraction}"
                              Padding="10,7"
                              Margin="0,0,8,8"/>
                      <Button Content="Переключить видимость"
                              Command="{Binding AddToggleVisibilityInteractionForSelectedCommand}"
                              IsVisible="{Binding CanQuickAddToggleVisibilityInteraction}"
                              Padding="10,7"
                              Margin="0,0,8,8"/>
                      <Button Content="Заполнить TextBox из строки"
                              Command="{Binding AddDataGridFillInteractionForSelectedCommand}"
                              IsVisible="{Binding CanQuickAddDataGridFillInteraction}"
                              Padding="10,7"
                              Margin="0,0,8,8"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Правила логики"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SelectedControlInteractionsCountText}"
                                 Foreground="#475569"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="#F8FAFC"
                            BorderBrush="#D7E2EE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            IsVisible="{Binding HasNoSelectedControlInteractions}">
                      <TextBlock Text="Правил логики пока нет. Нажмите «Добавить», затем выберите источник, событие, действие и цель."
                                 Foreground="#64748B"
                                 TextWrapping="Wrap"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding SelectedControlInteractions}"
                                  IsVisible="{Binding HasSelectedControlInteractions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:InteractionModel">
                          <Border Background="White"
                                  BorderBrush="#D7E2EE"
                                  BorderThickness="1"
                                  CornerRadius="12"
                                  Padding="10"
                                  Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                              <Button HorizontalContentAlignment="Stretch"
                                      Command="{Binding #RootWindow.DataContext.SelectInteractionCommand}"
                                      CommandParameter="{Binding}"
                                      Padding="8"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="{Binding Summary}"
                                             FontWeight="SemiBold"
                                             TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding ActionDisplayName}"
                                             Foreground="#64748B"
                                             FontSize="12"/>
                                </StackPanel>
                              </Button>
                              <Button Grid.Column="1"
                                      Content="Источник"
                                      Command="{Binding #RootWindow.DataContext.SelectInteractionSourceCommand}"
                                      CommandParameter="{Binding}"
                                      Padding="10,7"/>
                              <Button Grid.Column="2"
                                      Content="Цель"
                                      Command="{Binding #RootWindow.DataContext.SelectInteractionTargetCommand}"
                                      CommandParameter="{Binding}"
                                      Padding="10,7"/>
                              <Button Grid.Column="3"
                                      Content="Удалить"
                                      Command="{Binding #RootWindow.DataContext.RemoveInteractionCommand}"
                                      CommandParameter="{Binding}"
                                      Padding="10,7"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Classes="card"
                        IsVisible="{Binding CanEditSelectedInteraction}">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Редактор правила"
                               FontSize="16"
                               FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Источник"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding InteractionSourceControlNames}"
                                  DropDownOpened="LogicComboBox_DropDownOpened"
                                  DropDownClosed="LogicComboBox_DropDownClosed"
                                  SelectedItem="{Binding SelectedInteraction.SourceControlName, Mode=TwoWay}"/>
                        <TextBlock Text="Элемент, который запускает правило."
                                   Foreground="#64748B"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Spacing="4">
                        <TextBlock Text="Событие"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableInteractionEventOptions}"
                                  SelectedValue="{Binding SelectedInteraction.EventName, Mode=TwoWay}"
                                  DropDownOpened="LogicComboBox_DropDownOpened"
                                  DropDownClosed="LogicComboBox_DropDownClosed"
                                  SelectedValueBinding="{Binding Value}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:InteractionOptionModel">
                              <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SelectedInteractionEventHint}"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Spacing="4">
                        <TextBlock Text="Действие"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableInteractionActionOptions}"
                                  SelectedValue="{Binding SelectedInteraction.ActionType, Mode=TwoWay}"
                                  DropDownOpened="LogicComboBox_DropDownOpened"
                                  DropDownClosed="LogicComboBox_DropDownClosed"
                                  SelectedValueBinding="{Binding Value}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:InteractionOptionModel">
                              <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SelectedInteractionActionHint}"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  IsVisible="{Binding IsSelectedInteractionControlTargetVisible}"
                                  Spacing="4">
                        <TextBlock Text="Цель"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding InteractionTargetControlNames}"
                                  DropDownOpened="LogicComboBox_DropDownOpened"
                                  DropDownClosed="LogicComboBox_DropDownClosed"
                                  SelectedItem="{Binding SelectedInteraction.TargetControlName, Mode=TwoWay}"/>
                        <TextBlock Text="Элемент, который изменится после события."
                                   Foreground="#64748B"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                      </StackPanel>

                      <StackPanel Grid.Row="2"
                                  IsVisible="{Binding IsSelectedInteractionControlTargetVisible}"
                                  Spacing="4">
                        <TextBlock Text="Свойство цели"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableInteractionTargetPropertyOptions}"
                                  SelectedValue="{Binding SelectedInteraction.TargetProperty, Mode=TwoWay}"
                                  DropDownOpened="LogicComboBox_DropDownOpened"
                                  DropDownClosed="LogicComboBox_DropDownClosed"
                                  SelectedValueBinding="{Binding Value}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:InteractionOptionModel">
                              <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SelectedInteractionTargetPropertyHint}"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Row="2"
                                  Grid.Column="1"
                                  IsVisible="{Binding IsSelectedInteractionControlTargetVisible}"
                                  Spacing="4">
                        <TextBlock Text="Значение / поле"
                                   FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding InteractionValuePathHints}"
                                  DropDownOpened="LogicComboBox_DropDownOpened"
                                  DropDownClosed="LogicComboBox_DropDownClosed"
                                  SelectedItem="{Binding SelectedInteraction.SourcePath, Mode=TwoWay}"/>
                        <TextBlock Text="Поле из источника или текущее значение события."
                                   Foreground="#64748B"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                      </StackPanel>

                      <StackPanel Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  IsVisible="{Binding IsSelectedInteractionMessageVisible}"
                                  Spacing="4">
                        <TextBlock Text="Шаблон текста"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SelectedInteraction.MessageTitle, Mode=TwoWay}"
                                 GotFocus="LogicEditor_GotFocus"
                                 LostFocus="LogicEditor_LostFocus"
                                 Watermark="Заголовок сообщения, например: Готово"/>
                        <TextBox Text="{Binding LogicTemplateDraft, Mode=TwoWay}"
                                 GotFocus="LogicEditor_GotFocus"
                                 LostFocus="LogicEditor_LostFocus"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="78"
                                 Watermark="Например: Клиент: {Name}, Email: {Email}"/>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock Text="{Binding LogicTemplateDraftStatus}"
                                     Foreground="#64748B"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center"/>
                          <Button Grid.Column="1"
                                  Content="{Binding Texts.Apply}"
                                  Command="{Binding ApplyLogicTemplateEditCommand}"
                                  Padding="10,6"/>
                          <Button Grid.Column="2"
                                  Content="{Binding Texts.Cancel}"
                                  Command="{Binding CancelLogicTemplateEditCommand}"
                                  Padding="10,6"/>
                        </Grid>
                        <TextBlock Text="Если шаблон заполнен, он используется вместо одиночного поля. Пример: Клиент: {Name}, Email: {Email}."
                                   Foreground="#64748B"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                      </StackPanel>

                      <StackPanel Grid.Row="4"
                                  Grid.ColumnSpan="2"
                                  IsVisible="{Binding IsSelectedInteractionOpenForm}"
                                  Spacing="8">
                        <TextBlock Text="OpenForm"
                                   FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <ComboBox ItemsSource="{Binding OpenFormTargetForms}"
                                    SelectedValue="{Binding SelectedInteraction.TargetFormId, Mode=TwoWay}"
                                    DropDownOpened="LogicComboBox_DropDownOpened"
                                    DropDownClosed="LogicComboBox_DropDownClosed"
                                    SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="models:DesignerFormDocument">
                                <TextBlock Text="{Binding DisplayName}"/>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <ComboBox Grid.Column="1"
                                    MinWidth="120"
                                    ItemsSource="{Binding AvailableOpenFormModes}"
                                    DropDownOpened="LogicComboBox_DropDownOpened"
                                    DropDownClosed="LogicComboBox_DropDownClosed"
                                    SelectedItem="{Binding SelectedInteraction.OpenMode, Mode=TwoWay}"/>
                          <CheckBox Grid.Column="2"
                                    Content="Close current"
                                    IsChecked="{Binding SelectedInteraction.CloseCurrentAfterOpen, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding OpenFormTargetHint}"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>

                    <Border Background="#F8FAFC"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            IsVisible="{Binding IsSelectedInteractionDataGridSelectedRowAction}">
                      <Grid ColumnDefinitions="*,160"
                            RowDefinitions="Auto,Auto,Auto,Auto">
                        <StackPanel Spacing="4">
                          <TextBlock Text="DataGrid selected row -> Text"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     Foreground="#1D4ED8"/>
                          <TextBlock Text="Настройте, какие поля выбранной строки записывать в TextBox/TextBlock. Изменения остаются черновиком до Apply."
                                     Foreground="#475569"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Spacing="4">
                          <TextBlock Text="Доступные поля"
                                     FontWeight="SemiBold"/>
                          <ItemsControl ItemsSource="{Binding LogicTemplateAvailablePlaceholders}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding #RootWindow.DataContext.InsertLogicTemplatePlaceholderCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,4"
                                        Margin="0,0,0,4"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="Нет schema для выбранного DataGrid."
                                     IsVisible="{Binding HasNoLogicTemplateAvailablePlaceholders}"
                                     Foreground="#B45309"
                                     FontSize="11"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Spacing="4">
                          <TextBlock Text="Template"
                                     FontWeight="SemiBold"/>
                          <TextBox Text="{Binding LogicTemplateDraft, Mode=TwoWay}"
                                   GotFocus="LogicEditor_GotFocus"
                                   LostFocus="LogicEditor_LostFocus"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap"
                                   MinHeight="110"
                                   Watermark="ID: {Id}&#x0a;Name: {Name}&#x0a;Price: {Price}"/>
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{Binding LogicTemplateDraftStatus}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="{Binding Texts.Apply}"
                                    Command="{Binding ApplyLogicTemplateEditCommand}"
                                    Padding="10,6"/>
                            <Button Grid.Column="2"
                                    Content="{Binding Texts.Cancel}"
                                    Command="{Binding CancelLogicTemplateEditCommand}"
                                    Padding="10,6"/>
                          </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="12,10,0,0"
                                    Spacing="4">
                          <TextBlock Text="Preview"
                                     FontWeight="SemiBold"/>
                          <Border Background="White"
                                  BorderBrush="#D7E2EE"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="8"
                                  MinHeight="110">
                            <TextBlock Text="{Binding LogicTemplatePreviewText}"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                          </Border>
                        </StackPanel>

                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,*,*"
                              Margin="0,10,0,0">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Missing value"
                                       FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AvailableMissingValueBehaviors}"
                                      SelectedItem="{Binding SelectedInteraction.MissingValueBehavior, Mode=TwoWay}"
                                      DropDownOpened="LogicComboBox_DropDownOpened"
                                      DropDownClosed="LogicComboBox_DropDownClosed"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Margin="8,0,0,0"
                                      Spacing="4">
                            <TextBlock Text="No selection"
                                       FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AvailableNoSelectionBehaviors}"
                                      SelectedItem="{Binding SelectedInteraction.NoSelectionBehavior, Mode=TwoWay}"
                                      DropDownOpened="LogicComboBox_DropDownOpened"
                                      DropDownClosed="LogicComboBox_DropDownClosed"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2"
                                      Margin="8,0,0,0"
                                      Spacing="4">
                            <TextBlock Text="No selection text"
                                       FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedInteraction.NoSelectionText, Mode=TwoWay}"
                                     GotFocus="LogicEditor_GotFocus"
                                     LostFocus="LogicEditor_LostFocus"
                                     Watermark="Нет выбранной строки"/>
                          </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   Text="{Binding LogicTemplateValidationText}"
                                   Foreground="#B45309"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        </Grid>
      </Border>

      <Button Grid.Column="6"
              Width="28"
              MinHeight="64"
              Classes="dock-rail"
              Command="{Binding ToggleRightPanelEditorCommand}"
              IsVisible="{Binding IsRightDockRailVisible}"
              ToolTip.Tip="Показать правую панель">
        <TextBlock Text="⚙"
                   FontSize="13"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
      </Button>
      </Grid>

      <Border Grid.Row="1"
              Height="{Binding DiagnosticsPaneHostHeight}"
              Background="#F8FBFF"
              BorderBrush="#D3DFEC"
              BorderThickness="1"
              CornerRadius="8"
              IsVisible="{Binding IsBottomDockPanelVisible}">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Height="6"
                  Classes="dock-splitter"
                  Cursor="SizeNorthSouth"
                  IsVisible="{Binding IsDiagnosticsPaneExpanded}"
                  PointerPressed="DiagnosticsPaneResizeHandle_PointerPressed"
                  PointerMoved="DiagnosticsPaneResizeHandle_PointerMoved"
                  PointerReleased="DiagnosticsPaneResizeHandle_PointerReleased"
                  PointerCaptureLost="DiagnosticsPaneResizeHandle_PointerCaptureLost">
            <Border Height="2"
                    Width="96"
                    CornerRadius="999"
                    Background="#B6C9E0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
          </Border>
          <Border Grid.Row="1"
                  Background="#EEF4FB"
                  BorderBrush="#D7E2EE"
                  BorderThickness="0,0,0,1"
                  CornerRadius="8,8,0,0"
                  Padding="6,4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
              <StackPanel Orientation="Horizontal"
                          Spacing="6"
                          VerticalAlignment="Center">
                <Button Content="{Binding Texts.Problems}"
                        Command="{Binding OpenProblemsPanelCommand}"
                        Classes="problem-filter"
                        Padding="8,3"/>
                <Button Content="{Binding OutputDockButtonText}"
                        Command="{Binding OpenOutputPanelCommand}"
                        Classes="problem-filter"
                        Padding="8,3"/>
                <Button Content="{Binding InteractionTraceDockButtonText}"
                        Command="{Binding OpenInteractionTracePanelCommand}"
                        Classes="problem-filter"
                        Padding="8,3"/>
                <TextBlock Text="{Binding Texts.Diagnostics}"
                           Foreground="#64748B"
                           FontWeight="SemiBold"
                           FontSize="11"
                           VerticalAlignment="Center"/>
              </StackPanel>

              <Border Grid.Column="1"
                      Background="#FEE2E2"
                      BorderBrush="#FCA5A5"
                      BorderThickness="1"
                      CornerRadius="999"
                      Padding="8,3"
                      VerticalAlignment="Center"
                      IsVisible="False">
                <TextBlock Text="{Binding DiagnosticErrorCount, StringFormat='Ошибки: {0}'}"
                           Foreground="#991B1B"
                           FontSize="12"
                           FontWeight="Bold"/>
              </Border>

              <Border Grid.Column="2"
                      Background="#FEF3C7"
                      BorderBrush="#FCD34D"
                      BorderThickness="1"
                      CornerRadius="999"
                      Padding="8,3"
                      VerticalAlignment="Center"
                      IsVisible="False">
                <TextBlock Text="{Binding DiagnosticWarningCount, StringFormat='Предупреждения: {0}'}"
                           Foreground="#92400E"
                           FontSize="12"
                           FontWeight="Bold"/>
              </Border>

              <Border Grid.Column="3"
                      Background="#DBEAFE"
                      BorderBrush="#93C5FD"
                      BorderThickness="1"
                      CornerRadius="999"
                      Padding="8,3"
                      VerticalAlignment="Center"
                      IsVisible="False">
                <TextBlock Text="{Binding DiagnosticInfoCount, StringFormat='Подсказки: {0}'}"
                           Foreground="#1D4ED8"
                           FontSize="12"
                           FontWeight="Bold"/>
              </Border>

              <WrapPanel Grid.Column="4"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsProblemsPanelActive}">
                <Button Content="All"
                        Command="{Binding SetProblemsFilterCommand}"
                        CommandParameter="All"
                        Classes="problem-filter"
                        Margin="0,0,6,0"/>
                <Button Content="Errors"
                        Command="{Binding SetProblemsFilterCommand}"
                        CommandParameter="Errors"
                        Classes="problem-filter"
                        Margin="0,0,6,0"/>
                <Button Content="Warnings"
                        Command="{Binding SetProblemsFilterCommand}"
                        CommandParameter="Warnings"
                        Classes="problem-filter"
                        Margin="0,0,6,0"/>
                <Button Content="Hints"
                        Command="{Binding SetProblemsFilterCommand}"
                        CommandParameter="Hints"
                        Classes="problem-filter"
                        Margin="0,0,6,0"/>
              </WrapPanel>

              <StackPanel Grid.Column="4"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsOutputPanelActive}">
                <TextBlock Text="Channel"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding AvailableOutputCategories}"
                          SelectedItem="{Binding SelectedOutputCategory, Mode=TwoWay}"
                          MinWidth="150"/>
                <Button Content="Clear"
                        Command="{Binding ClearOutputCommand}"
                        Classes="problem-filter"
                        Padding="8,3"/>
                <Button Content="Copy all"
                        Click="CopyOutputLogsButton_Click"
                        Classes="problem-filter"
                        Padding="8,3"/>
                <Button Content="Open logs folder"
                        Click="OpenLogsFolderButton_Click"
                        Classes="problem-filter"
                        Padding="8,3"/>
              </StackPanel>

              <StackPanel Grid.Column="4"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsInteractionTracePanelActive}">
                <Button Content="Clear Trace"
                        Command="{Binding ClearInteractionTraceCommand}"
                        Classes="problem-filter"
                        Padding="8,3"/>
                <Button Content="Copy Trace"
                        Click="CopyInteractionTraceButton_Click"
                        Classes="problem-filter"
                        Padding="8,3"/>
              </StackPanel>

              <StackPanel Grid.Column="5"
                          Spacing="2"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsProblemsPanelActive}">
                <TextBlock Text="{Binding ProblemsRailSummary}"
                           Foreground="#334155"
                           FontWeight="SemiBold"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding DiagnosticsStateText}"
                           Foreground="#64748B"
                           FontSize="11"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <StackPanel Grid.Column="5"
                          Spacing="2"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsOutputPanelActive}">
                <TextBlock Text="{Binding OutputFilterSummary}"
                           Foreground="#334155"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WorkspaceTaskStatusText}"
                           Foreground="#64748B"
                           FontSize="11"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <StackPanel Grid.Column="5"
                          Spacing="2"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsInteractionTracePanelActive}">
                <TextBlock Text="{Binding InteractionTraceSummary}"
                           Foreground="#334155"
                           FontWeight="SemiBold"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Focus, selection, document switching, inspector and drag trace"
                           Foreground="#64748B"
                           FontSize="11"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <Button Grid.Column="6"
                      Content="↺"
                      Command="{Binding ResetLayoutEditorCommand}"
                      Classes="dock-collapse"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Сбросить расположение панелей"/>

              <Button Grid.Column="7"
                      Content="×"
                      Command="{Binding CloseBottomDockPanelCommand}"
                      Classes="dock-collapse"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Закрыть Problems"/>
            </Grid>
          </Border>

          <Grid Grid.Row="2"
                Margin="6"
                IsVisible="{Binding IsDiagnosticsPaneBodyVisible}">
            <Border Background="#F8FAFC"
                    BorderBrush="#D7E2EE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    IsVisible="{Binding HasNoFilteredDiagnostics}">
              <StackPanel Spacing="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock Text="Проблем не найдено"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Текущая форма проходит базовые проверки конструктора."
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
              </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasFilteredDiagnostics}">
              <ItemsControl ItemsSource="{Binding FilteredDiagnostics}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DocumentDiagnosticModel">
                    <Border Background="White"
                            BorderBrush="{Binding SeverityBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,0,4">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Background="{Binding SeverityBackground}"
                                  BorderBrush="{Binding SeverityBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="999"
                                  Padding="6,2"
                                  VerticalAlignment="Top">
                            <TextBlock Text="{Binding SeverityTitle}"
                                       Foreground="{Binding SeverityForeground}"
                                       FontWeight="Bold"
                                       FontSize="11"/>
                          </Border>

                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <DockPanel LastChildFill="True">
                              <TextBlock Text="{Binding Source}"
                                         FontWeight="Bold"/>
                              <TextBlock Text="{Binding Category}"
                                         Foreground="#64748B"
                                         FontSize="12"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Message}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding NavigationCaption}"
                                       Foreground="#475569"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasNavigationTarget}"/>
                          </StackPanel>

                          <Button Grid.Column="2"
                                  Content="Перейти"
                                  Command="{Binding #RootWindow.DataContext.NavigateToDiagnosticCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="data-action-button"
                                  Padding="8,4"
                                  IsVisible="{Binding HasNavigationTarget}"/>
                        </Grid>

                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                IsVisible="{Binding HasRecommendation}">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Что исправить"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding Recommendation}"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <Grid Grid.Row="2"
                Margin="6"
                IsVisible="{Binding IsOutputPanelBodyVisible}">
            <Border Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    ClipToBounds="True"
                    IsVisible="{Binding HasNoFilteredOutputEntries}">
              <StackPanel Spacing="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock Text="Output is empty"
                           Foreground="#E2E8F0"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Workspace operations, export, plugins, preview and smoke tests will appear here."
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
              </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasFilteredOutputEntries}">
              <ItemsControl ItemsSource="{Binding FilteredOutputEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:WorkspaceLogEntryModel">
                    <Grid ColumnDefinitions="72,86,110,*"
                          MinHeight="30"
                          Margin="8,0"
                          VerticalAlignment="Center">
                      <TextBlock Text="{Binding TimestampText}"
                                 Foreground="#94A3B8"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalAlignment="Center"/>
                      <Border Grid.Column="1"
                              Background="{Binding LevelBackground}"
                              CornerRadius="999"
                              Padding="7,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding LevelText}"
                                   Foreground="{Binding LevelBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding Category}"
                                 Foreground="#CBD5E1"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="3"
                                  Spacing="1"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding Message}"
                                   Foreground="#F8FAFC"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Details}"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasDetails}"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <Grid Grid.Row="2"
                Margin="6"
                IsVisible="{Binding IsInteractionTracePanelBodyVisible}">
            <Border Background="#0B1220"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    ClipToBounds="True"
                    IsVisible="{Binding HasNoInteractionTraceEntries}">
              <StackPanel Spacing="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock Text="Interaction Trace is empty"
                           Foreground="#E2E8F0"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Reproduce the Inspector/AddForm bug, then press Copy Trace."
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
              </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasInteractionTraceEntries}">
              <ItemsControl ItemsSource="{Binding InteractionTraceEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:InteractionTraceEntryModel">
                    <Grid ColumnDefinitions="82,210,190,210,*"
                          MinHeight="28"
                          Margin="8,0"
                          VerticalAlignment="Center">
                      <TextBlock Text="{Binding TimestampText}"
                                 Foreground="#94A3B8"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding EventName}"
                                 Foreground="#BFDBFE"
                                 FontFamily="Consolas"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding ActiveForm}"
                                 Foreground="#CBD5E1"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3"
                                 Text="{Binding FocusedElement}"
                                 Foreground="#FDE68A"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="4"
                                  Spacing="1"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedControl}"
                                   Foreground="#E2E8F0"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Flags}"
                                   Foreground="#A7F3D0"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Details}"
                                   Foreground="#94A3B8"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="NoWrap"
                                   IsVisible="{Binding HasDetails}"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Background="#F8FBFF"
              BorderBrush="#D3DFEC"
              BorderThickness="1"
              CornerRadius="8"
              Padding="6,4"
              IsVisible="{Binding IsCompactDiagnosticsBarVisible}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
          <Button Content="{Binding ProblemsDockButtonText}"
                  Command="{Binding ToggleProblemsPanelEditorCommand}"
                  Classes="dock-rail"
                  Padding="8,3"
                  MinHeight="26"
                  ToolTip.Tip="Открыть Problems"/>

          <Button Grid.Column="1"
                  Content="{Binding OutputDockButtonText}"
                  Command="{Binding ToggleOutputPanelEditorCommand}"
                  Classes="dock-rail"
                  Padding="8,3"
                  MinHeight="26"
                  ToolTip.Tip="Open Output"/>

          <Button Grid.Column="2"
                  Content="{Binding InteractionTraceDockButtonText}"
                  Command="{Binding OpenInteractionTracePanelCommand}"
                  Classes="dock-rail"
                  Padding="8,3"
                  MinHeight="26"
                  ToolTip.Tip="Open Interaction Trace"/>

          <Border Grid.Column="2"
                  Background="#FEE2E2"
                  BorderBrush="#FCA5A5"
                  BorderThickness="1"
                  CornerRadius="999"
                  Padding="8,3"
                  VerticalAlignment="Center"
                  IsVisible="False">
            <TextBlock Text="{Binding DiagnosticErrorCount, StringFormat='Ошибки: {0}'}"
                       Foreground="#991B1B"
                       FontSize="12"
                       FontWeight="Bold"/>
          </Border>

          <Border Grid.Column="3"
                  Background="#FEF3C7"
                  BorderBrush="#FCD34D"
                  BorderThickness="1"
                  CornerRadius="999"
                  Padding="8,3"
                  VerticalAlignment="Center"
                  IsVisible="False">
            <TextBlock Text="{Binding DiagnosticWarningCount, StringFormat='Предупреждения: {0}'}"
                       Foreground="#92400E"
                       FontSize="12"
                       FontWeight="Bold"/>
          </Border>

          <Border Grid.Column="4"
                  Background="#DBEAFE"
                  BorderBrush="#93C5FD"
                  BorderThickness="1"
                  CornerRadius="999"
                  Padding="8,3"
                  VerticalAlignment="Center"
                  IsVisible="False">
            <TextBlock Text="{Binding DiagnosticInfoCount, StringFormat='Hints: {0}'}"
                       Foreground="#1D4ED8"
                       FontSize="12"
                       FontWeight="Bold"/>
          </Border>

          <StackPanel Grid.Column="5"
                      Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding ProblemsRailSummary}"
                       Foreground="#64748B"
                       FontSize="12"/>
          </StackPanel>

          <Button Grid.Column="6"
                  Content="↺"
                  Command="{Binding ResetLayoutEditorCommand}"
                  Classes="dock-collapse"
                  Width="24"
                  Height="24"
                  ToolTip.Tip="Сбросить расположение панелей"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Глобальный overlay на время долгих операций:
         загрузка документа, импорт DLL, чтение схемы из БД и прочие фоновые задачи. -->
    <Border Grid.Row="2"
            Background="#0F172A"
            BorderBrush="#1E293B"
            BorderThickness="0,1,0,0"
            Padding="8,3"
            MinHeight="26">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Text="{Binding WorkspaceDirtyStatusText}"
                   Foreground="#E2E8F0"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding WorkspaceAutosaveStatusText}"
                   Foreground="#93C5FD"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="220"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2"
                   Text="{Binding WorkspaceZoomStatusText}"
                   Foreground="#CBD5E1"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3"
                   Text="{Binding WorkspaceControlsStatusText}"
                   Foreground="#CBD5E1"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4"
                   Text="{Binding WorkspaceSelectionStatusText}"
                   Foreground="#CBD5E1"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="260"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="5"
                   Text="{Binding WorkspaceDiagnosticsStatusText}"
                   Foreground="#FDE68A"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="6"
                   Text="{Binding WorkspaceExportStatusText}"
                   Foreground="#BBF7D0"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="7"
                   Text="{Binding WorkspaceTaskStatusText}"
                   Foreground="#C4B5FD"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="260"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="8"
                   Text="{Binding WorkspaceStatusMessageText}"
                   Foreground="#94A3B8"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="9"
                   Text="{Binding WorkspaceDocumentStatusText}"
                   Foreground="#E2E8F0"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="260"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Grid.RowSpan="3"
            Background="#0F172A70"
            IsVisible="{Binding IsStartScreenVisible}">
      <Grid>
        <Border Width="760"
                MaxHeight="620"
                Padding="22"
                CornerRadius="18"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="False">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="Avalonia UI Visual Designer · 0.2.0-alpha"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="{Binding Texts.StartScreenDescription}"
                           Foreground="#64748B"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="{Binding Texts.Close}"
                      Command="{Binding CloseStartScreenCommand}"
                      Classes="editor-ghost-button"/>
            </Grid>

            <WrapPanel Grid.Row="1">
              <Button Content="{Binding NewEditorCommand.Title}"
                      Command="{Binding NewEditorCommand}"
                      Classes="editor-primary-button"
                      Margin="0,0,8,8"/>
              <Button Content="{Binding OpenEditorCommand.Title}"
                      Command="{Binding OpenEditorCommand}"
                      Classes="editor-secondary-button"
                      Margin="0,0,8,8"/>
              <Button Content="{Binding Texts.Templates}"
                      Command="{Binding ToggleLeftPanelEditorCommand}"
                      Classes="editor-secondary-button"
                      Margin="0,0,8,8"/>
              <Button Content="{Binding HelpEditorCommand.Title}"
                      Command="{Binding HelpEditorCommand}"
                      Classes="editor-secondary-button"
                      Margin="0,0,8,8"/>
            </WrapPanel>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*">
              <Border BorderBrush="#E2E8F0"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="12">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding Texts.RecentProjects}"
                             FontWeight="Bold"
                             FontSize="16"/>
                  <ItemsControl ItemsSource="{Binding RecentFiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:RecentFileModel">
                        <Button Tag="{Binding}"
                                Click="OpenRecentFileButton_Click"
                                HorizontalContentAlignment="Stretch"
                                Padding="10,7"
                                Margin="0,0,0,6">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PathText}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="1"
                      BorderBrush="#E2E8F0"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="12">
                <StackPanel Spacing="10">
                  <TextBlock Text="Workspace"
                             FontWeight="Bold"
                             FontSize="16"/>
                  <CheckBox Content="Reopen last workspace on startup"
                            IsChecked="{Binding ReopenLastWorkspaceOnStartup, Mode=TwoWay}"/>
                  <TextBlock Text="{Binding WorkspaceStatusMessageText}"
                             Foreground="#64748B"
                             TextWrapping="Wrap"/>
                  <Button Content="Open Output"
                          Command="{Binding OpenOutputPanelCommand}"
                          Classes="editor-secondary-button"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.RowSpan="3"
            Background="#0F172A80"
            IsVisible="{Binding IsCommandPaletteOpen}">
      <Grid>
        <Border Width="620"
                MaxHeight="520"
                Padding="14"
                CornerRadius="{StaticResource EditorRadiusLarge}"
                Background="{StaticResource EditorBrushSurface}"
                BorderBrush="{StaticResource EditorBrushPrimary}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,84,0,0">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Command Palette"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource EditorBrushText}"/>
                <TextBlock Text="Search actions, tools, export commands and panels"
                           FontSize="12"
                           Foreground="{StaticResource EditorBrushTextMuted}"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Esc"
                      Classes="editor-ghost-button"
                      Command="{Binding CloseCommandPaletteCommand}"
                      Padding="8,3"/>
            </Grid>

            <TextBox x:Name="CommandPaletteSearchTextBox"
                     Grid.Row="1"
                     Text="{Binding CommandPaletteSearchText, Mode=TwoWay}"
                     Watermark="Type a command name, e.g. Export, Preview, Delete, Group"
                     KeyDown="CommandPaletteTextBox_KeyDown"/>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource EditorBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource EditorRadiusMedium}"
                    ClipToBounds="True">
              <ListBox ItemsSource="{Binding CommandPaletteCommands}"
                       SelectedItem="{Binding SelectedCommandPaletteCommand, Mode=TwoWay}"
                       DoubleTapped="CommandPaletteListBox_DoubleTapped"
                       MaxHeight="360"
                       Background="{StaticResource EditorBrushSurface}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="commands:EditorCommand">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          MinHeight="38"
                          Margin="2">
                      <TextBlock Text="{Binding Icon}"
                                 Width="22"
                                 VerticalAlignment="Center"
                                 TextAlignment="Center"
                                 Foreground="{StaticResource EditorBrushTextMuted}"/>
                      <StackPanel Grid.Column="1"
                                  Spacing="1"
                      VerticalAlignment="Center"
                      IsVisible="False">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource EditorBrushText}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="11"
                                   Foreground="{StaticResource EditorBrushTextMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <Border Classes="editor-badge">
                          <TextBlock Text="{Binding CategoryText}"
                                     FontSize="11"
                                     Foreground="{StaticResource EditorBrushPrimary}"/>
                        </Border>
                        <TextBlock Text="{Binding Shortcut}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource EditorBrushTextMuted}"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <ItemsControl Grid.RowSpan="3"
                  ItemsSource="{Binding WorkspaceToasts}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,76,18,0"
                  IsHitTestVisible="True">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="models:WorkspaceToastModel">
          <Border Width="340"
                  Background="{Binding BackgroundBrush}"
                  BorderBrush="{Binding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="12"
                  Margin="0,0,0,8">
            <Grid ColumnDefinitions="4,*,Auto">
              <Border Background="{Binding LevelBrush}"
                      CornerRadius="999"/>
              <StackPanel Grid.Column="1"
                          Spacing="3">
                <TextBlock Text="{Binding Title}"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Message}"
                           Foreground="#475569"
                           FontSize="12"
                           TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="2"
                      Content="x"
                      Command="{Binding #RootWindow.DataContext.DismissToastCommand}"
                      CommandParameter="{Binding}"
                      Classes="dock-collapse"
                      Width="26"
                      Height="26"
                      Padding="0"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.RowSpan="3"
            Background="#0F172AB8"
            IsVisible="{Binding IsBusy}">
      <Grid>
        <Border Width="420"
                MaxWidth="420"
                Padding="22"
                CornerRadius="20"
                Background="#0F172A"
                BorderBrush="#3B82F6"
                BorderThickness="1.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="{Binding BusyTitle}"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding BusyDescription}"
                       Foreground="#CBD5E1"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <ProgressBar IsIndeterminate="True"
                         Height="10"
                         Foreground="#60A5FA"
                         Background="#1E293B"/>
            <TextBlock Text="Операция выполняется. Окно не зависло."
                       Foreground="#93C5FD"
                       FontSize="12"
                       TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>




