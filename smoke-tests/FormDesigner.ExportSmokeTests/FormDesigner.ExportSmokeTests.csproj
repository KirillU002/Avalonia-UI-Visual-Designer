<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FormDesigner.csproj" />
  </ItemGroup>

  <!-- Generated smoke artifacts are test output, never source files for this runner. -->
  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <AvaloniaXaml Remove="artifacts\**\*.axaml" />
    <None Remove="artifacts\**\*" />
  </ItemGroup>
</Project>
